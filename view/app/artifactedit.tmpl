{{- /* 
    artifactedit.tmpl ~ Edit a single artifact file on record.
*/ -}}
{{- define "artifactedit" -}}
{{- if eq false (index . "editor")}}{{/*  render nothing  */}}{{else}}
{{- $epochY := index . "epochYear"}}
{{- $delay := "50ms" }}
{{- $lDelay := "1s"}}
{{- $hundred := "100"}}
{{- $oneK := "1024" }}
{{- $key := index . "modID"}}
{{- $unid := index . "unid"}}
{{- $record := index . "modOnline"}}
{{- $rel1 := index . "modReleaser1"}}
{{- $rel2 := index . "modReleaser2"}}
{{- $title := index . "modTitle"}}
{{- $filename := index . "filename"}}
{{- $os := index . "modOS"}}
{{- $tag := index . "modTag"}}
{{- $dateYear := index . "modYear"}}
{{- $dateMonth := index . "modMonth"}}
{{- $dateDay := index . "modDay"}}
{{- $lmYear := index . "modLMYear"}}
{{- $lmMonth := index . "modLMMonth"}}
{{- $lmDay := index . "modLMDay"}}
{{- $lastMod := index . "lastmodified"}}
{{- $writers := index . "writers"}}
{{- $artists := index . "artists"}}
{{- $youtube := index . "youtube"}}
{{- $sixteen := index . "sixteenColors"}}
{{- $demozoo := index . "demozoo"}}
{{- $pouet := index . "pouet"}}
{{- $github := index . "github"}}
{{- $comment := index . "comment"}}
{{- $relations := index . "modRelations"}}
{{- $websites := index . "modWebsites"}}
{{- $programmers := index . "programmers"}}
{{- $musicians := index . "musicians"}}
{{- $alertURL := index . "alertURL"}}
{{- $previewImg := recordImgSample $unid}}
{{- $thumbImg := recordThumbSample $unid}}
{{- $linkExamples := recordLinkPreviews $youtube $demozoo $pouet $sixteen $github $relations $websites }}
{{- $replace := "refresh the page to see the changes"}}
{{- $hxClassification := "[name='artifact-editor-categories'],[name='artifact-editor-operatingsystem'],[name='artifact-editor-key']"}}
<div class="modal fade" id="artifact-delete-forever-modal" data-bs-backdrop="static" data-bs-keyboard="true" tabindex="-1"
  aria-labelledby="artifact-delete-forever-modal-label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-body-tertiary py-2 px-3 border-start border-4 border-danger">
        <div class="d-flex align-items-center gap-2">
          <svg class="flex-shrink-0 text-danger" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <use xlink:href="/svg/bootstrap-icons.svg#slash-circle"/>
          </svg>
          <h2 class="modal-title fs-5 fw-semibold mb-0" id="artifact-delete-forever-modal-label">Delete artifact forever</h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="fw-medium mb-2">This action is intended for unwanted uploads.</p>
        <p class="small text-body-secondary mb-3">
          Consider replacing the download file instead,
          as this action permanently removes the artifact from the database and server. 
          Deleting this record is irreversible and will break links on search engines 
          and any external resources such as Demozoo or Wikipedia.
        </p>
        <div id="artifact-delete-forever">
          <div class="bg-body-tertiary border rounded p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div style="min-width: 0;">
              <div class="text-secondary text-uppercase mb-1" style="font-size: 0.72rem; letter-spacing: .04em;">Target artifact &middot; ID {{$key}}</div>
              {{- if ne "" $title}}
              <div class="text-truncate">{{$title}}</div>
              {{- end}}
              <code class="small text-break">{{$filename}}</code>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger flex-shrink-0"
              hx-confirm="Confirm, this is the last chance to back out"
              hx-delete="/editor/delete/forever/{{$key}}"
              hx-target="#artifact-delete-forever"
              hx-status:4xx="target:#artifact-delete-forever-errors swap:innerHTML"
              hx-status:5xx="target:#artifact-delete-forever-errors swap:innerHTML"
              hx-swap="innerHTML">Delete forever</button>
          </div>
          <div class="text-danger small mt-2" id="artifact-delete-forever-errors"></div>
        </div>
      </div>
      <div class="modal-footer bg-body-tertiary py-2 px-3 justify-content-between">
        <button type="button" data-bs-toggle="modal" data-bs-target="#artifact-editor-modal"
          class="btn btn-sm btn-outline-primary">Back to Data editor</button>
        <button type="button" data-bs-dismiss="modal" class="btn btn-sm btn-secondary">Cancel</button>
      </div>
    </div>
  </div>
</div>
{{- /*  Artifact metadata editor  */}}
<div class="modal fade" id="artifact-editor-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" 
  aria-labelledby="artifact-editor-modal-label" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    {{- /*  Data editor for record key, ...  */}}
    <div class="modal-content">
      <div id="artifact-editor-modal-header"
        class="modal-header bg-body-tertiary py-2 px-3 border-start border-4 {{if eq $record true}}border-success{{else}}border-danger{{end}}">
        <div class="d-flex align-items-center gap-2">
          <svg class="flex-shrink-0 text-secondary" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <use xlink:href="/svg/bootstrap-icons.svg#file-binary"/>
          </svg>
          <h2 class="modal-title fs-5 fw-semibold mb-0" id="artifact-editor-modal-label">Data editor <span class="text-body-secondary fw-normal">&middot; {{$key}}</span></h2>
          <span id="artifact-editor-modal-status" class="badge {{if eq $record true}}text-bg-success{{else}}text-bg-danger{{end}} fw-normal">{{if eq $record true}}Public{{else}}Hidden{{end}}</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" data-bs-target="#artifact-editor-modal" aria-label="Close"></button>
      </div>
      <div class="modal-body container">
        <div class="row g-2 align-items-center justify-content-between">
          {{- /*  Public or hidden record */}}
          <div class="col-12 col-xl-auto">
            <div class="input-group input-group-sm" role="group" aria-label="Record visibility">
              <span class="input-group-text">Artifact Visibility</span>
              {{radioHidden ($record)}}
              <label class="btn btn-outline-danger flex-fill" for="artifact-editor-hidden">Hidden</label>
              {{radioPublic ($record)}}
              <label class="btn btn-outline-success flex-fill" for="artifact-editor-public">Public</label>
            </div>
          </div>
          <div class="col-12 col-xl-auto">
            <div class="d-flex flex-wrap flex-sm-nowrap align-items-center justify-content-xl-end gap-2">
              <div class="input-group input-group-sm" style="width: 11.5rem; max-width: 100%;">
                <button type="button" class="btn btn-outline-secondary text-nowrap" id="artifact-dataeditor-key-label"
                  data-bs-toggle="tooltip" data-bs-container="body" data-bs-title="Copy the key">Record key</button>
                <input type="text" value='{{$key}}' class="form-control font-monospace" name="artifact-editor-key" id="artifact-dataeditor-key-value"
                  aria-describedby="artifact-dataeditor-key-label" readonly>
              </div>
              <div class="input-group input-group-sm" style="width: 26rem; max-width: 100%;">
                <button type="button" class="btn btn-outline-secondary text-nowrap" id="artifact-dataeditor-unique-id-label"
                  data-bs-toggle="tooltip" data-bs-container="body" data-bs-title="Copy the ID">Unique ID</button>
                <input type="text" value='{{$unid}}' class="form-control font-monospace" 
                  aria-describedby="artifact-dataeditor-unique-id-label" id="artifact-dataeditor-unique-id-value" readonly>
              </div>
            </div>
          </div>
        </div>
        <div class="row bg-light mt-3 align-items-center">
          <div class="col-xl-6 py-2">
            {{- /*  Classifications  */}}
            <div class="form-label d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div>
                <span class="col-form-label-lg">Classifications</span>, 
                <small id="artifact-editor-classification-help">{{classification $tag $os | safeHTML}}</small>.
              </div>
              <button class="btn btn-sm btn-outline-secondary ms-auto" name="prereset-classifications" id="artifact-editor-classifications-undo" type="button"
                data-preset-os="{{$os}}" data-preset-tag="{{$tag}}"
                data-bs-toggle="tooltip" data-bs-title="Revert to: {{$os}} + {{$tag}}"
                hx-patch="/editor/classifications"
                hx-trigger="click delay:500ms"
                hx-target="#artifact-editor-classification-help"
                hx-include="{{$hxClassification}}">Undo</button>
            </div>
            <div class="input-group mb-1">
              <label class="input-group-text w-50" for="artifact-editor-operating-system" id="artifact-editor-os-label">System or type</label>
              <select name="artifact-editor-operatingsystem" id="artifact-editor-operating-system" class="form-select"
                aria-describedby="artifact-editor-os-label" autocomplete="off"
                hx-patch="/editor/classifications" 
                hx-target="#artifact-editor-classification-help"
                hx-include="{{$hxClassification}}">
              {{- template "optionOS" . }}
              </select>
            </div>
            <div class="input-group">
              <label class="input-group-text w-50" for="artifact-editor-category" id="artifact-editor-category-label">Tag as category</label>
              <select name="artifact-editor-categories" id="artifact-editor-category" class="form-select"
                aria-describedby="artifact-editor-category-label" autocomplete="off"
                hx-patch="/editor/classifications" 
                hx-target="#artifact-editor-classification-help"
                hx-include="{{$hxClassification}}">
              {{- template "optionTag" . }}
              </select>
            </div>
          </div>
          <div class="col-xl-6 py-2">
            {{- /*  Popular classifications  */}}
            <div class="d-flex flex-column gap-2">
              <div class="d-flex flex-wrap align-items-center gap-1">
                <span class="badge bg-success pe-none" style="min-width: 3.5rem;">text</span>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-text-for-dos" type="button"
                  data-preset-os="text" data-preset-tag="releaseinformation"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">NFO</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-text-for-amiga" type="button"
                  data-preset-os="textamiga" data-preset-tag="releaseinformation"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">Amiga</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-magazine-for-text" type="button"
                  data-preset-os="text" data-preset-tag="magazine"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">magazine</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-dox" type="button"
                  data-preset-os="text" data-preset-tag="guide"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">docs / help</button>
              </div>
              <div class="d-flex flex-wrap align-items-center gap-1">
                <span class="badge bg-warning pe-none" style="min-width: 3.5rem;">dos</span>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-magazine-for-dos" type="button"
                  data-preset-os="dos" data-preset-tag="magazine"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">magazine</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-trainer-for-dos" type="button"
                  data-preset-os="dos" data-preset-tag="gamehack"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">trainer</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-intro-for-dos" type="button"
                  data-preset-os="dos" data-preset-tag="releaseadvert"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">intro</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-inst-for-dos" type="button"
                  data-preset-os="dos" data-preset-tag="releaseinstall"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">installer</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-intro-for-bbs" type="button"
                  data-preset-os="dos" data-preset-tag="bbs"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">intro bbs</button>
              </div>
              <div class="d-flex flex-wrap align-items-center gap-1">
                <span class="badge bg-info pe-none" style="min-width: 3.5rem;">win</span>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-trainer-for-win" type="button"
                  data-preset-os="windows" data-preset-tag="gamehack"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">trainer</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-intro-for-win" type="button"
                  data-preset-os="windows" data-preset-tag="releaseadvert"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">intro</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-inst-for-win" type="button"
                  data-preset-os="windows" data-preset-tag="releaseinstall"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">installer</button>
              </div>
              <div class="d-flex flex-wrap align-items-center gap-1">
                <span class="badge bg-danger pe-none" style="min-width: 3.5rem;">ansi</span>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-ansi-for-text" type="button"
                  data-preset-os="ansi" data-preset-tag="releaseinformation"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">NFO</button>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-ansi-for-bbs" type="button"
                  data-preset-os="ansi" data-preset-tag="bbs"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">bbs</button>
                <span class="vr mx-1"></span>
                <span class="badge bg-dark pe-none" style="min-width: 3.5rem;">image</span>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" name="prereset-classifications" id="artifact-editor-proof-of-release" type="button"
                  data-preset-os="image" data-preset-tag="releaseproof"
                  hx-patch="/editor/classifications"
                  hx-trigger="click delay:500ms"
                  hx-target="#artifact-editor-classification-help"
                  hx-include="{{$hxClassification}}">proof of release</button>
              </div>
            </div>
          </div>
        </div>
        <div class="row mt-3">
          {{- /*  Title or brief description  */}}
          <div class="col-xl-6">
            <label for="artifact-editor-title" class="col-form-label-lg">Title <small>or magazine issue</small></label>
            <small class="text-secondary">alt+shift 🢁🢃</small>
              <div class="form-text my-1"><strong>Good titles are important</strong>, 
                <a href="/titles">please follow this guide</a>.</div>
            <input type="text" name="artifact-editor-title" id="artifact-editor-title" autocomplete="off" maxlength="{{$hundred}}"
              aria-describedby="artifact-editor-title-help" placeholder="example: 500000th release!" class="form-control form-control-lg" 
              value="{{$title}}"
              hx-patch="/editor/title" 
              hx-trigger="keyup changed delay:{{$lDelay}}"
              hx-include="[name='artifact-editor-key']">
            <div id="artifact-editor-title-help" class="form-text mb-2">
              Optional name or a brief of the release.<br>
              For magazines, use the issue number, or volume and issue. See: "<em>1</em>", "<em>1, volume 1</em>".
            </div>
            <input type="hidden" name="artifact-editor-title-undo" value="{{$title}}" readonly>
            <div class="btn-group btn-group-sm" role="group" aria-label="Title actions">
              <button class="btn btn-outline-secondary" type="button" id="artifact-editor-title-undo"
                data-bs-toggle="tooltip" data-bs-container="body" data-bs-title="Revert to: {{if ne $title ""}}{{$title}}{{else}}(empty){{end}}"
                hx-patch="/editor/title/reset"
                hx-target="#artifact-editor-title-quote"
                hx-include="[name='artifact-editor-key'],
                            [name='artifact-editor-title-undo']">Undo <span id="artifact-editor-title-quote"></span></button>
              <button class="btn btn-outline-secondary" type="button" id="artifact-editor-title-delete">Blank</button>
              <button class="btn btn-outline-secondary" type="button" id="artifact-editor-titleize">Capitalize</button>
            </div>
          </div>
          {{/*  Comments  */}}
          <div class="col-xl-6">
            <div class="form-label d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div>
                <label class="col-form-label-lg" for="artifact-editor-comment">Comment</label> <small class="text-secondary">alt+shift \</small>
              </div>
              <input type="hidden" name="artifact-editor-comment-undo" value="{{$comment}}" readonly>
              <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" id="artifact-editor-comment-undo"
                data-bs-toggle="tooltip" data-bs-title="Revert to saved comment"
                hx-patch="/editor/comment/reset"
                hx-target="#artifact-editor-comment-quote"
                hx-include="[name='artifact-editor-key'],
                            [name='artifact-editor-comment-undo']">Undo <span id="artifact-editor-comment-quote"></span></button>
            </div>
            <textarea class="form-control" name="artifact-editor-comment" id="artifact-editor-comment" 
              style="height:6em;" autocomplete="off" aria-describedby="artifact-editor-comment-help" 
              hx-patch="/editor/comment" 
              hx-trigger="keyup changed delay:{{$lDelay}}"
              hx-include="[name='artifact-editor-key']">{{$comment}}</textarea>
            <div class="form-text" id="artifact-editor-comment-help">Optional comments can offer notes of the history, origin, or sources.</div>
          </div>
        </div>
        <div class="row bg-light my-3">
          {{- /*  Releasers  */}}
          <div class="col-xl-6">
            <label for="artifact-editor-releaser-1" class="form-label col-form-label-lg">Releasers <small>maximum of 2</small></label>
            <small class="text-secondary">alt+shift 🢁🢃</small>
            <form id="artifact-editor-releasers-form" class="row row-cols-2 row-cols-lg-4 gy-1">
              <div class="col-6 col-lg-4 d-grid d-block">
                <button class="btn btn-success" type="button" id="artifact-editor-releaser-update"
                    hx-patch="/editor/releasers"
                    hx-include="[name='artifact-editor-key']"
                    hx-trigger="click, submit-releasers"
                    hx-vals='{"releaser1": "{{$rel1}}","releaser2": "{{$rel2}}"}'>Save</button>
              </div>
              <div class="w-100 d-block d-lg-none"></div>
              <div class="col-12 col-lg-8">
                <input type="text" list="artifact-editor-list-1" name="artifact-editor-releaser1" id="artifact-editor-releaser-1" autocomplete="off"
                    aria-describedby="artifact-editor-releasers-help" placeholder="example: Razor 1911" class="form-control{{if eq $rel1 ""}} is-invalid{{end}}" 
                    value="{{$rel1}}" data-reset-rel1="{{$rel1}}"
                    hx-patch="/uploader/releaser/1" 
                    hx-trigger="keyup[checkUserKeydown.call(this, event)] changed delay:{{$delay}}"
                    hx-target="#artifact-editor-list-1" minlength="2" maxlength="{{$hundred}}" required>
              </div>
              <div class="col-12 col-sm-5 col-lg-4 d-flex flex-wrap justify-content-center align-items-center gap-1">
                <button class="btn btn-link btn-sm p-0" type="button" id="artifact-editor-releaser-independent"
                  data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Use when the releaser is unknown"><span class="badge text-uppercase text-bg-primary">Independent</span></button>
                <button class="btn btn-link btn-sm p-0" type="button" id="artifact-editor-releaser-none"
                  data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Use if N/A, for real names etc."><span class="badge text-uppercase text-bg-primary">None</span></button>
              </div>
              <div class="col-12 col-sm-7 col-lg-8">
                <div class="input-group">
                  <input type="text" list="artifact-editor-list-2" name="artifact-editor-releaser2" id="artifact-editor-releaser-2" autocomplete="off"
                      aria-describedby="artifact-editor-releasers-help" placeholder="example: Titan" class="form-control" 
                      value="{{$rel2}}" data-reset-rel2="{{$rel2}}"
                      hx-patch="/uploader/releaser/2" 
                      hx-trigger="keyup[checkUserKeydown.call(this, event)] changed delay:{{$delay}}"
                      hx-target="#artifact-editor-list-2" minlength="2" maxlength="{{$hundred}}">
                  <button class="btn btn-outline-secondary" type="button" id="artifact-editor-releaser-undo"
                    data-bs-toggle="tooltip" data-bs-container="body"
                    data-bs-title="Revert to: {{if ne $rel1 ""}}{{$rel1}}{{if ne $rel2 ""}} + {{$rel2}}{{end}}{{else}}(empty){{end}}"
                    hx-patch="/editor/releasers/reset"
                    hx-target="find span"
                    hx-include="[name='artifact-editor-key'],
                                [name='artifact-editor-releaser1'],
                                [name='artifact-editor-releaser2']"
                    hx-vals='{"releaser1": "{{$rel1}}","releaser2": "{{$rel2}}"}'>Undo <span><!-- reset releasers --></span></button>
                </div>
              </div>
            </form>
            <datalist id="artifact-editor-list-1"></datalist>
            <datalist id="artifact-editor-list-2"></datalist>
            <div id="artifact-editor-releasers-error" class="invalid-feedback{{if eq $rel1 ""}} d-block{{end}}">
              A releaser is required, for example: <q>Razor 1911</q>.
            </div>
            <div id="artifact-editor-releasers-help" class="form-text">
              Releasers are names of a group, magazine, BBS, FTP. 
              They are the authors, publishers, subjects of this artifact. 
              BBS / FTP <u>must</u> end with <code>BBS</code> or <code>FTP</code>.
            </div>
          </div>
          {{- /*  Date of release  */}}
          <div class="col-xl-6">
            <label class="form-label col-form-label-lg">Date of release</label>
            <small class="text-secondary">alt+shift 🡸🢂</small>
            <div class="row row-cols-2 row-cols-lg-4 g-1">
              <div class="col-6 col-lg-4 d-grid d-block">
                <button class="btn btn-success" type="button" id="artifact-editor-date-update"
                hx-patch="/editor/date"
                hx-include="[name='artifact-editor-key'],
                            [name='artifact-editor-year'],
                            [name='artifact-editor-year-resetter'],
                            [name='artifact-editor-month'],
                            [name='artifact-editor-day']">Save</button>
              </div>

              <div class="col-6 col-lg-8 d-flex flex-wrap justify-content-start justify-content-lg-between align-items-center gap-2">
                <div>
                  <input type="hidden" id="artifact-editor-date-undos" name="artifact-editor-date-undos"
                    value="{{$dateYear}}-{{$dateMonth}}-{{$dateDay}}" readonly>
                  <button type="button" class="btn btn-sm btn-outline-secondary" id="artifact-editor-date-undo"
                    data-bs-toggle="tooltip" data-bs-title="Revert to: {{$dateYear}}-{{$dateMonth}}-{{$dateDay}}"
                    hx-patch="/editor/date/reset"
                    hx-target="find span"
                    hx-include="[name='artifact-editor-key'],
                                [name='artifact-editor-date-undos']">Undo <span><!-- reset target --></span></button>
                </div>
                {{- if gt $lmYear $epochY}}
                <div>
                  <input type="hidden" id="artifact-editor-date-lastmods" name="artifact-editor-date-lastmods" 
                    value="{{$lmYear}}-{{$lmMonth}}-{{$lmDay}}" readonly>
                  <button type="button" class="btn btn-link p-0" id="artifact-editor-date-lastmod"
                      hx-patch="/editor/date/lastmod"
                      hx-target="find span"
                      hx-include="[name='artifact-editor-key'],
                                  [name='artifact-editor-date-lastmods']">
                      <small class="badge text-bg-primary">Use last modification&nbsp;
                    {{- if ne $lmYear 0}}<em>{{$lmYear}}
                    {{- if ne $lmMonth 0}}-{{$lmMonth}}{{end}}
                    {{- if ne $lmDay 0}}-{{$lmDay}}{{end}}</em>{{end}}
                    <span><!-- lastmod target --></span></small>
                  </button>
                </div>
                {{- end}}
              </div>

              <div class="w-100 d-none d-lg-block"></div>
              <div class="col-6 col-lg-4">
                <div class="input-group">
                  <span class="input-group-text">Year</span>
                  <input type="hidden" name="artifact-editor-year-store" value="{{$dateYear}}" readonly>
                  <input type="number" name="artifact-editor-year" min="1980" max="{{exampleYear}}" autocomplete="off"
                    id="artifact-editor-year" aria-label="Year of release" class="form-control input-date" 
                    value="{{$dateYear}}" placeholder="{{exampleYear}}" 
                    data-1p-ignore data-bwignore="true" data-dashlane-ignore="true">
                </div>
              </div>
              <div class="col-6 col-lg-4">
                <div class="input-group">
                  <span class="input-group-text text-secondary">Month</span>
                  <input type="hidden" name="artifact-editor-month-store" value="{{$dateMonth}}" readonly>
                  <input type="number" name="artifact-editor-month" min="1" max="12" autocomplete="off"
                    id="artifact-editor-month" aria-label="Month of release" class="form-control input-date" 
                    value="{{$dateMonth}}" placeholder="{{exampleMonth}}"
                    data-1p-ignore data-bwignore="true" data-dashlane-ignore="true">
                </div>
              </div>
              <div class="col-6 col-lg-4">
                <div class="input-group flex-nowrap">
                  <span class="input-group-text text-secondary">Day</span>
                  <input type="hidden" name="artifact-editor-day-store" value="{{$dateDay}}" readonly>
                  <input type="number" name="artifact-editor-day" min="1" max="31" autocomplete="off"
                    id="artifact-editor-day" aria-label="Day of release" class="form-control input-date" 
                    value="{{$dateDay}}" placeholder="{{exampleDay}}"
                    data-1p-ignore data-bwignore="true" data-dashlane-ignore="true">
                </div>
              </div>
            </div>
            <div id="artifact-editor-date-help" class="form-text">
              A year of release is recommended.
            </div>
          </div>
        </div>
        <div class="row my-3">
          {{/*  Filename  */}}
          <div class="col-xl-6">
            <label for="artifact-editor-filename" class="col-form-label-lg">Filename</label>
            <small class="text-secondary">alt+shift 🢁🢃</small>
            <input type="hidden" name="artifact-editor-filename-undo" value="{{$filename}}" readonly>
            <div class="input-group">
              <input type="text" class="form-control{{if eq $filename ""}} is-invalid{{end}}" 
                name="artifact-editor-filename" id="artifact-editor-filename" autocomplete="off" maxlength="255"
                value="{{$filename}}" aria-describedby="artifact-editor-filename-help"
                hx-patch="/editor/filename" 
                hx-trigger="keyup changed delay:{{$lDelay}}"
                hx-include="[name='artifact-editor-key']">
              <button class="btn btn-outline-secondary" type="button" id="artifact-editor-filename-undo"
                data-bs-toggle="tooltip" data-bs-container="body" data-bs-title="Revert to: {{$filename}}"
                hx-patch="/editor/filename/reset"
                hx-target="#artifact-editor-filename-quote"
                hx-include="[name='artifact-editor-key'],
                            [name='artifact-editor-filename-undo']">Undo <span id="artifact-editor-filename-quote"></span></button>
            </div>
            <div id="artifact-editor-filename-help" class="form-text">
              The filename should usually be left unchanged and is required.<br>
              <span class="text-warning-emphasis">A file extension is always advisable</span>. See: <em>example.zip</em>
            </div>
          </div>
          {{/*  VirusTotal  */}}
          <div class="col-xl-6">
            <label for="artifact-editor-virustotal" class="col-form-label-lg">VirusTotal alert</label>
            <input type="text" class="form-control" name="artifact-editor-virustotal" id="artifact-editor-virustotal" autocomplete="off" maxlength="256"
              aria-describedby="artifact-editor-virustotal-help" value="{{$alertURL}}"
              hx-patch="/editor/virustotal" 
              hx-trigger="keyup changed delay:{{$lDelay}}"
              hx-include="[name='artifact-editor-key']">
            <div id="artifact-editor-virustotal-help" class="form-text">
              <span class="text-info-emphasis">Provide an link to a VirusTotal report to block the artifact download.</span><br>
              The VirusTotal alert should usually be left empty.
            </div>
          </div>
        </div>
        <div class="row bg-light">
          {{- /*  Creators  */}}
          <div class="form-label col-form-label-lg mb-0 pb-0">
            Creators
          </div>
          <div class="row row-cols-2 gy-1">
            <div class="col">
              <div class="form-floating">
              <input type="text" class="form-control" name="artifact-editor-credittext" id="artifact-editor-credit-text" autocomplete="off" maxlength="{{$oneK}}"
                value="{{$writers}}" data-reset-credit-text="{{$writers}}" placeholder="example: Name" aria-details="artifact-editor-credit-help"
                hx-patch="/editor/creator/text" 
                hx-trigger="keyup changed delay:{{$lDelay}}"
                hx-include="[name='artifact-editor-key']">
              <label for="artifact-editor-credit-text">Writers or persons mentioned</label>
              </div>
            </div>
            <div class="col">
            <div class="form-floating">
              <input type="text" class="form-control" name="artifact-editor-creditill" id="artifact-editor-credit-ill" autocomplete="off" maxlength="{{$oneK}}"
                value="{{$artists}}" data-reset-credit-ill="{{$artists}}" placeholder="example: Name" aria-details="artifact-editor-credit-help"
                hx-patch="/editor/creator/ill" 
                hx-trigger="keyup changed delay:{{$lDelay}}"
                hx-include="[name='artifact-editor-key']">
              <label for="artifact-editor-credit-ill">Visual artists or designers</label>
            </div>
            </div>
            <div class="col">
            <div class="form-floating">
              <input type="text" class="form-control" name="artifact-editor-creditprog" id="artifact-editor-credit-prog" autocomplete="off" maxlength="{{$hundred}}" 
                value="{{$programmers}}" data-reset-credit-prog="{{$programmers}}" placeholder="example: Name" aria-details="artifact-editor-credit-help"
                hx-patch="/editor/creator/prog" 
                hx-trigger="keyup changed delay:{{$lDelay}}"
                hx-include="[name='artifact-editor-key']">
              <label for="artifact-editor-credit-prog">Programmers or crackers</label>
            </div>
            </div>
            <div class="col">
              <div class="input-group">
                <div class="form-floating">
                  <input type="text" class="form-control" name="artifact-editor-creditaudio" id="artifact-editor-credit-audio" autocomplete="off" maxlength="{{$hundred}}"
                    value="{{$musicians}}" data-reset-credit-audio="{{$musicians}}" placeholder="example: Name" aria-details="artifact-editor-credit-help"
                    hx-patch="/editor/creator/audio" 
                    hx-trigger="keyup changed delay:{{$lDelay}}"
                    hx-include="[name='artifact-editor-key']">
                  <label for="artifact-editor-credit-audio">Musicians</label>
                </div>
                {{- /* NOTE: the "-creditsundo" with an "s" */}}
                <button type="button" class="btn btn-outline-secondary" id="artifact-editor-credit-undo"
                  data-bs-toggle="tooltip" data-bs-container="body" data-bs-title="Revert all creators to saved values"
                  hx-patch="/editor/creator/reset"
                  hx-target="#artifact-editor-credits-quote"
                  hx-include="[name='artifact-editor-key'],
                  [name='artifact-editor-credits-undo'],
                  [name='artifact-editor-credittext'],
                  [name='artifact-editor-creditill'],
                  [name='artifact-editor-creditprog'],
                  [name='artifact-editor-creditaudio']">Undo all <span id="artifact-editor-credits-quote"></span></button>
              </div>
            </div>
          </div>
          <div class="form-text mb-2" id="artifact-editor-credit-help">
            List multiple creators with commas, format: <code>Name1,Name2,Name3</code>. 
            See: <em>Firstname,Name Two,Name3</em></div>
        </div>
        <input type="hidden" id="artifact-editor-credits-undo" name="artifact-editor-credits-undo" 
          value="{{$writers}};{{$artists}};{{$programmers}};{{$musicians}}" readonly>
        <hr class="d-block d-lg-none">
        {{- /*  Links  */}}
        <form autocomplete="off" 
            hx-patch="/editor/links"
            hx-trigger="input from:#artifact-editor-youtube,
                        input from:#artifact-editor-demozoo,
                        input from:#artifact-editor-pouet,
                        input from:#artifact-editor-16colors,
                        input from:#artifact-editor-github,
                        input from:#artifact-editor-relations,
                        input from:#artifact-editor-websites"
            hx-include="[name='artifact-editor-key']"
            hx-target:inherited="#artifact-editor-link-examples">
        <div>
          <div class="form-label col-form-label-lg mb-0 pb-0">
            Links <small>to related webpages and artifacts</small>
          </div>
          <div class="row g-2 justify-content-center">

            <div class="col-6 col-lg-3 col-xl-2" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Numeric production ID, example: 185828">
              <div class="form-floating">
                <input type="hidden" name="artifact-editor-demozooundo" id="artifact-editor-demozoo-undo" value="{{$demozoo}}" readonly>
                {{- /*  do not use a min=1 input element, otherwise htmx will never save when deleting a value  */}}
                <input type="number" class="form-control" name="artifact-editor-demozoo" id="artifact-editor-demozoo" 
                  autocomplete="off" max="{{ demozooSanity }}" value="{{$demozoo}}" placeholder="185828"
                  hx-patch="/editor/demozoo"
                  hx-trigger="keyup changed delay:{{$lDelay}}"
                  hx-include="[name='artifact-editor-key']">
                <label for="artifact-editor-demozoo">
                <svg class="bi" width="16" height="22" fill="currentColor">
                  <use xlink:href="/svg/bootstrap-icons.svg#demozoo"/>
                </svg> Demozoo production</label>
              </div>
            </div>
            <div class="col-6 col-lg-3 col-xl-2" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Numeric production ID, example: 75854">
              <div class="form-floating">
                <input type="hidden" name="artifact-editor-pouetundo" id="artifact-editor-pouet-undo" value="{{$pouet}}" readonly>
                <input type="number" class="form-control" name="artifact-editor-pouet" id="artifact-editor-pouet" 
                  autocomplete="off" max="{{ pouetSanity }}" value="{{$pouet}}" placeholder="75854"
                  hx-patch="/editor/pouet"
                  hx-trigger="keyup changed delay:{{$lDelay}}"
                  hx-include="[name='artifact-editor-key']">
                <label for="artifact-editor-pouet">
                <img src="/svg/pouet-icon.svg" width="16" height="16" alt="Pouet"> Pouet production</label>
              </div>
            </div>

            <div class="col-6 col-lg-4 col-xl-3" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="A URL path, example: tags/magazine/dreadloc">
              <div class="form-floating">
                <input type="hidden" name="artifact-editor-16colorsundo" id="artifact-editor-16colors-undo" value="{{$sixteen}}" readonly>
                <input type="text" class="form-control" name="artifact-editor-16colors" id="artifact-editor-16colors" 
                  autocomplete="off" maxlength="{{$oneK}}" value="{{$sixteen}}" placeholder="tags/magazine/dreadloc"
                  hx-patch="/editor/16colors"
                  hx-trigger="keyup changed delay:{{$lDelay}}"
                  hx-include="[name='artifact-editor-key']">
                <label for="artifact-editor-16colors">16colo(rs) partial</label>
              </div>
            </div>
            <div class="col-6 col-lg-4 col-xl-2" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="A repository path, example: Defacto2/server">
              <div class="form-floating">
                <input type="hidden" name="artifact-editor-githubundo" id="artifact-editor-github-undo" value="{{$github}}" readonly>
                <input type="text" class="form-control" name="artifact-editor-github" id="artifact-editor-github" 
                  autocomplete="off" maxlength="{{$oneK}}" value="{{$github}}" placeholder="Defacto2/server"
                  hx-patch="/editor/github"
                  hx-trigger="keyup changed delay:{{$lDelay}}"
                  hx-include="[name='artifact-editor-key']">
                <label for="artifact-editor-github">
                  <svg class="bi" width="16" height="20" fill="currentColor">
                    <use xlink:href="/svg/bootstrap-icons.svg#github"/>
                  </svg> GitHub repository</label>
              </div>
            </div>

            <div class="col-12 col-lg-4 col-xl-3">
              <input type="hidden" name="artifact-editor-youtubeundo" id="artifact-editor-youtube-undo" value="{{$youtube}}" readonly>
              <div class="input-group">
                <div class="form-floating" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="YouTube watch ID, example: 62BuDfBIcMo">
                  {{- /*  maxlength/minlength values means htmx will only ever trigger with 11 chars  */}}
                  <input type="text" class="form-control" name="artifact-editor-youtube" id="artifact-editor-youtube" 
                    autocomplete="off" minlength="11" value="{{$youtube}}" placeholder="62BuDfBIcMo"
                    hx-patch="/editor/youtube"
                    hx-validate="true"
                    hx-trigger="keyup changed delay:{{$lDelay}}"
                    hx-include="[name='artifact-editor-key']">
                  <label for="artifact-editor-youtube">
                    <svg class="bi bi-youtube" width="16" height="20" fill="currentColor">
                      <use xlink:href="/svg/bootstrap-icons.svg#youtube"/>
                    </svg> YouTube ID</label>
                </div>
                <button type="button" class="btn btn-outline-secondary" id="artifact-editor-links-undo"
                  data-bs-toggle="tooltip" data-bs-container="body" data-bs-title="Revert all links to saved values"
                  hx-patch="/editor/links/reset"
                  hx-target="#artifact-editor-link-examples"
                  hx-include="[name='artifact-editor-key'],
                  [name='artifact-editor-youtubeundo'],
                  [name='artifact-editor-githubundo'],
                  [name='artifact-editor-demozooundo'],
                  [name='artifact-editor-pouetundo'],
                  [name='artifact-editor-16colorsundo'],
                  [name='artifact-editor-relationsundo'],
                  [name='artifact-editor-websitesundo']">Undo all <span id="artifact-editor-links-quote"></span></button>
              </div>
            </div>

          </div>
        </div>
        <div class="row row-cols-1 row-cols-lg-2 gy-2 pt-2">
          <div class="col">
            <div class="form-floating" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Link related Defacto2 releases as Label;RecordKey, separated by |">
              <input type="hidden" name="artifact-editor-relationsundo" id="artifact-editor-relations-undo" value="{{$relations}}" readonly>
              <input type="text" class="form-control" name="artifact-editor-relations" id="artifact-editor-relations" 
                autocomplete="off" maxlength="255" value="{{$relations}}"
                placeholder="NFO;9f1c2" aria-describedby="artifact-editor-relations-help"
                hx-patch="/editor/relations"
                hx-trigger="keyup changed delay:{{$lDelay}}"
                hx-include="[name='artifact-editor-key']">
              <label for="artifact-editor-relations">
                <svg class="bi" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                  <use xlink:href="/svg/bootstrap-icons.svg#floppy"/>
                </svg> Link to other Defacto2 artifacts</label>
            </div>
            <div class="form-text" id="artifact-editor-relations-help">
              Pair a label and record key with "<code>;</code>". See: <code>Label;Key</code><br>
              Separate multiple links with "<code>|</code>". See: <code>NFO;9f1c2|Intro;a92116e</code>
              <div class="d-none d-lg-block">Result: • Link to <a href="/f/9f1c2">NFO</a> • Link to <a href="/f/a92116e">Intro</a></div>
            </div>
          </div> 
          <div class="col">
            <div class="form-floating" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Link external sites as Label;URL (without https://), separated by |">
              <input type="hidden" name="artifact-editor-websitesundo" id="artifact-editor-websites-undo" value="{{$websites}}" readonly>
              <input type="text" class="form-control" name="artifact-editor-websites" id="artifact-editor-websites" 
                autocomplete="off" maxlength="2048" value="{{$websites}}"
                placeholder="Site;example.com" aria-describedby="artifact-editor-websites-help"
                hx-patch="/editor/sites"
                hx-trigger="keyup changed delay:{{$lDelay}}"
                hx-include="[name='artifact-editor-key']">
              <label for="artifact-editor-websites">
                <svg class="bi" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                  <use xlink:href="/svg/bootstrap-icons.svg#www"/>
                </svg> Link to websites</label>
            </div>
            <div class="form-text" id="artifact-editor-websites-help">
              Pair a label and URL with "<code>;</code>". Separate multiple links with "<code>|</code>"<br>
              See: <code>Webpage;example.com|Documentation;example.com/docs</code>
              <div class="d-none d-lg-block">Result: • Link to <a href="https://example.com">Site</a> • Link to <a href="https://example.com/doc">Docs</a></div>
            </div>
          </div>
        </div>
        <div id="artifact-editor-link-examples" class="mt-3 mb-2">
          {{range $linkExamples}}
              <small><span class="text-secondary">• Link to</span></small> {{. | safeHTML}} &nbsp; 
          {{end}}
        </div>
        </form>
        <hr class="d-block d-lg-none">
      </div>
      {{/*  Switch to assets and reset buttons  */}}
      {{- template "artifactfooter" . }}
    </div>
  </div>
</div>
{{- end}}
{{- end}}
