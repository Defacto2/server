{{- /* 
    artifacteditjsdos.tmpl ~ Edit a single artifact configuration for js-dos emulation.
*/ -}}
{{- define "artifacteditjsdos" }}
{{- $msdos := eq (index . "platform") "dos"}}
{{- $id := index . "modID"}}
{{- $runProgram := index . "jsdos6Run"}}
{{- $guessProgram := index . "jsdos6RunGuess"}}
{{- $customRunProgram := index . "modEmulateRun"}}
{{- $extract := index . "jsdos6Zip"}}
{{- $cpu := index . "modEmulateCPU"}}
{{- $machine := index . "modEmulateMachine"}}
{{- $audio := index . "modEmulateAudio"}}
{{- if eq false (index . "editor")}}{{/*  render nothing  */}}{{else}}
<div class="modal fade" id="emulate-editor-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" 
  aria-labelledby="emulate-editor-modal-label" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-body-tertiary py-2 px-3">
        <div class="d-flex align-items-center gap-2">
          <svg class="flex-shrink-0 text-secondary" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <use xlink:href="/svg/bootstrap-icons.svg#terminal"/>
          </svg>
          <h2 class="modal-title fs-5 fw-semibold mb-0" id="emulate-editor-modal-label">Emulator settings <span class="text-body-secondary fw-normal">&middot; {{$id}}</span></h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body bg-body-tertiary">
        {{- /*  shown when platform != "dos"  */}}
        {{- if eq $msdos false}}
        <div class="alert alert-secondary mb-0" role="alert">
            The emulator editor is not in use, only the artifacts set as <strong title="use Microsoft or IBM DOS">for MsDos PC</strong> use this.
        </div>
        {{- else}}
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <p class="form-text m-0">
            Fine-tune hardware settings for the <a href="https://github.com/caiiiycuk/js-dos/tree/6.22">js-dos v6.22 emulator</a> when legacy DOS software misbehaves.
          </p>
          <span class="badge text-bg-info">Refresh the browser tab to apply changes</span>
        </div>

        {{/*  Broken / nonworking toggle  */}}
        <div class="card mb-3" style="border-left: 4px solid var(--bs-warning) !important;">
          <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between gap-3">
            <div>
              <label class="form-check-label fw-semibold" for="emulate-is-broken">
                Flag as nonworking or broken
              </label>
              <span class="ms-2" id="emulate-is-broken-result"></span>
              <div class="form-text mt-0">
                Some programs cannot run in js-dos and require virtualization or real hardware.
              </div>
            </div>
            <div class="form-check form-switch fs-5 mb-0 flex-shrink-0">
              <input class="form-check-input" type="checkbox" autocomplete="off" role="switch"
                hx-patch="/editor/emulate/broken/{{$id}}"
                hx-trigger="change"
                hx-on:change="document.getElementById('emulate-is-broken-result').textContent=''"
                hx-include="[name='emulate-is-broken']"
                hx-target="#emulate-is-broken-result"
                name="emulate-is-broken"
                id="emulate-is-broken"{{if eq true (index . "modEmulateBroken")}} checked{{end}}>
            </div>
          </div>
        </div>

        {{/*  Program to run  */}}
        <div class="card mb-3">
          <div class="card-body">
            <legend class="fs-5 mb-3 d-flex align-items-center gap-2">
              <svg class="bi" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <use xlink:href="/svg/bootstrap-icons.svg#terminal"/>
              </svg>
              Program to run
            </legend>
            <div class="row g-3 align-items-start">
              <div class="col-12 col-lg-5">
                <label for="emulate-guess-program" class="form-label small text-secondary mb-1">Auto-detected program</label>
                <div class="input-group input-group-sm">
                  <span class="input-group-text text-secondary">C:\</span>
                  <input type="text" class="form-control" autocomplete="off" aria-label="Program name to launch"
                    id="emulate-guess-program"
                    value="{{$guessProgram}}" readonly{{if ne "" $customRunProgram}} disabled{{end}}>
                </div>
              </div>
              <div class="col-12 col-lg-7">
                <label for="emulate-run-program" class="form-label small text-secondary mb-1">Custom commands (overrides auto-detected)</label>
                <div class="input-group input-group-sm has-validation">
                  <span class="input-group-text" id="emulate-custom-cmds">C:\</span>
                  <input type="text" class="form-control" autocomplete="off" aria-label="Replacement commands to launch" aria-describedby="emulate-custom-cmds"
                    hx-patch="/editor/emulate/runprogram/{{$id}}"
                    hx-trigger="input changed delay:400ms, clear"
                    hx-target="#emulate-run-program-feedback" hx-swap="outerHTML"
                    name="emulate-run-program" id="emulate-run-program"
                    value="{{$customRunProgram}}">
                  <button type="button" class="btn btn-outline-secondary" id="emulate-run-program-clear">Clear</button>
                </div>
                <div id="emulate-run-program-feedback"></div>
                <div class="form-text">Chain commands with <code>&amp;&amp;</code>, e.g. <code>TYPE README &amp;&amp; PAUSE &amp;&amp; APP.EXE</code></div>
              </div>
            </div>
          </div>
        </div>

        {{- /*  emulator machine (graphics)  */}}
        <div class="card mb-3">
          <div class="card-body">
            <fieldset
              hx-patch="/editor/emulate/machine/{{$id}}"
              hx-target="#emulate-machine-result"
              hx-include="[name='emulate-machine']"
              hx-trigger="change"
              hx-on:change="document.getElementById('emulate-machine-result').textContent=''">
              <legend class="fs-5 mb-3 d-flex align-items-center gap-2">
                <svg class="bi" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                  <use xlink:href="/svg/bootstrap-icons.svg#pc-display-horizontal"/>
                </svg>
                <span>IBM or PC machines to emulate</span>
                <small id="emulate-machine-result"></small>
              </legend>
              <div class="row g-3">
                <div class="col-12 col-lg-6 d-flex flex-column gap-2">
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="auto" id="emulate-machine-auto"{{if or (eq "" $machine) (eq "auto" $machine) (eq "svga" $machine)}} checked{{end}}>
                    <label class="form-check-label text-success fw-semibold" for="emulate-machine-auto">Automatic</label>
                    <div class="form-text mt-0">Default S3 Trio64 SVGA (1994), best compatibility for most software.</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="vga" id="emulate-machine-vga"{{if eq "vga" $machine}} checked{{end}}>
                    <label class="form-check-label" for="emulate-machine-vga"><strong class="text-primary">VGA</strong> (256-color)</label>
                    <div class="form-text mt-0">Standard VGA fallback for early 1990s software that fails on S3 SVGA.</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="ega" id="emulate-machine-ega"{{if eq "ega" $machine}} checked{{end}}>
                    <label class="form-check-label" for="emulate-machine-ega"><strong class="text-primary">EGA</strong> (16-color)</label>
                    <div class="form-text mt-0">Late-1980s low-resolution 16-color display setup.</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="tandy" id="emulate-machine-tandy"{{if eq "tandy" $machine}} checked{{end}}>
                    <label class="form-check-label" for="emulate-machine-tandy">Tandy 1000 (16-color)</label>
                    <div class="form-text mt-0">Mid-to-late 1980s enhanced Tandy graphics and sound setup.</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="cga" id="emulate-machine-cga"{{if eq "cga" $machine}} checked{{end}}>
                    <label class="form-check-label" for="emulate-machine-cga"><strong class="text-primary">CGA</strong> (4-color)</label>
                    <div class="form-text mt-0">Classic 1980s 4-color IBM display adapter.</div>
                  </div>
                </div>
                <div class="col-12 col-lg-6 d-flex flex-column gap-2">
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="nolfb" id="emulate-machine-nolfb"{{if eq "nolfb" $machine}} checked{{end}}>
                    <label class="form-check-label text-success fw-semibold" for="emulate-machine-nolfb">S3 Trio64 with no LFB</label>
                    <div class="form-text mt-0">Disables the Linear Frame Buffer, occasionally improving compatibility or speed.</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="oldvbe" id="emulate-machine-oldvbe"{{if eq "oldvbe" $machine}} checked{{end}}>
                    <label class="form-check-label" for="emulate-machine-oldvbe">1991, VBE 1.2</label>
                    <div class="form-text mt-0">Fallback for software expecting VESA BIOS Extensions v1.2.</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="et4000" id="emulate-machine-et4000"{{if eq "et4000" $machine}} checked{{end}}>
                    <label class="form-check-label" for="emulate-machine-et4000">1989, ET4000 VGA</label>
                    <div class="form-text mt-0">Fallback for Tseng Labs ET4000 drivers.</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="paradise" id="emulate-machine-paradise"{{if eq "paradise" $machine}} checked{{end}}>
                    <label class="form-check-label" for="emulate-machine-paradise">1988, Paradise VGA</label>
                    <div class="form-text mt-0">Fallback for Paradise PVGA1A drivers.</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" autocomplete="off" name="emulate-machine" value="et3000" id="emulate-machine-et3000"{{if eq "et3000" $machine}} checked{{end}}>
                    <label class="form-check-label" for="emulate-machine-et3000">1987, ET3000 VGA</label>
                    <div class="form-text mt-0">Fallback for Tseng Labs ET3000 drivers.</div>
                  </div>
                </div>
              </div>
            </fieldset>
          </div>
        </div>

        <div class="row g-3 mb-3">
          {{- /*  CPU  */}}
          <div class="col-12 col-lg-6">
            <div class="card h-100">
              <div class="card-body">
                <fieldset
                  hx-patch="/editor/emulate/cpu/{{$id}}"
                  hx-target="#emulate-cpu-result"
                  hx-include="[name='emulate-cpu']"
                  hx-trigger="change"
                  hx-on:change="document.getElementById('emulate-cpu-result').textContent=''">
                  <legend class="fs-5 mb-3 d-flex align-items-center gap-2">
                    <svg class="bi" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                      <use xlink:href="/svg/bootstrap-icons.svg#cpu"/>
                    </svg>
                    <span>Speed &amp; processor</span>
                    <small id="emulate-cpu-result"></small>
                  </legend>
                  <div class="d-flex flex-column gap-2">
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-cpu" value="auto" id="emulate-cpu-auto"{{if or (eq "" $cpu) (eq "auto" $cpu)}} checked{{end}}>
                      <label class="form-check-label text-success fw-semibold" for="emulate-cpu-auto">Automatic</label>
                      <div class="form-text mt-0">Default dynamic speed; change only if software runs too fast or too slow.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-cpu" value="486" id="emulate-cpu-enhanced"{{if eq "486" $cpu}} checked{{end}}>
                      <label class="form-check-label" for="emulate-cpu-enhanced"><strong class="text-primary">Fast</strong> Enhanced-mode CPU</label>
                      <div class="form-text mt-0">Emulates an <strong>Intel 486</strong> for early 1990s software.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-cpu" value="8086" id="emulate-cpu-realmode"{{if eq "8086" $cpu}} checked{{end}}>
                      <label class="form-check-label" for="emulate-cpu-realmode"><strong class="text-primary">Slow</strong> Real-mode CPU (5 MHz)</label>
                      <div class="form-text mt-0">Emulates a 4.77 MHz <strong>8086 / 286</strong> for 1980s software.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-cpu" value="386" id="emulate-cpu-slow-enhanced"{{if eq "386" $cpu}} checked{{end}}>
                      <label class="form-check-label" for="emulate-cpu-slow-enhanced">Enhanced-mode slow CPU</label>
                      <div class="form-text mt-0">Emulates a 12 MHz <strong>Intel 386</strong> for late-1980s / 1990 software.</div>
                    </div>
                  </div>
                </fieldset>
              </div>
            </div>
          </div>

          {{- /*  Soundcard  */}}
          <div class="col-12 col-lg-6">
            <div class="card h-100">
              <div class="card-body">
                <fieldset
                  hx-patch="/editor/emulate/sfx/{{$id}}"
                  hx-target="#emulate-sfx-result"
                  hx-include="[name='emulate-sfx']"
                  hx-trigger="change"
                  hx-on:change="document.getElementById('emulate-sfx-result').textContent=''">
                  <legend class="fs-5 mb-3 d-flex align-items-center gap-2">
                    <svg class="bi" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                      <use xlink:href="/svg/bootstrap-icons.svg#pci-card-sound"/>
                    </svg>
                    <span>Sound addon</span>
                    <small id="emulate-sfx-result"></small>
                  </legend>
                  <div class="d-flex flex-column gap-2">
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-sfx" value="auto" id="emulate-sfx-auto"{{if or (eq "" $audio) (eq "auto" $audio)}} checked{{end}}>
                      <label class="form-check-label text-success fw-semibold" for="emulate-sfx-auto">Automatic</label>
                      <div class="form-text mt-0">Enables all audio devices; narrow this down if audio causes crashes.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-sfx" value="covox" id="emulate-sfx-covox"{{if eq "covox" $audio}} checked{{end}}>
                      <label class="form-check-label" for="emulate-sfx-covox"><strong class="text-primary">DAC</strong> Digital-to-Analog Converter</label>
                      <div class="form-text mt-0">Covox, Disney Sound Source, and LPT port audio dongles.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-sfx" value="sb1" id="emulate-sfx-sb1"{{if eq "sb1" $audio}} checked{{end}}>
                      <label class="form-check-label" for="emulate-sfx-sb1"><strong class="text-primary">Sound Blaster</strong> 1, Pro, or AdLib</label>
                      <div class="form-text mt-0">Compatible late-1980s / early-1990s sound cards.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-sfx" value="sb16" id="emulate-sfx-sb16"{{if eq "sb16" $audio}} checked{{end}}>
                      <label class="form-check-label" for="emulate-sfx-sb16"><strong class="text-primary">Sound Blaster 16</strong></label>
                      <div class="form-text mt-0">Higher audio quality than SB1/Pro, though occasionally less compatible.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-sfx" value="gus" id="emulate-sfx-gus"{{if eq "gus" $audio}} checked{{end}}>
                      <label class="form-check-label" for="emulate-sfx-gus"><strong class="text-primary">GUS</strong> (Gravis Ultrasound)</label>
                      <div class="form-text mt-0">Wavetable card popular in 1990s Demoscene productions.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-sfx" value="pcspeaker" id="emulate-sfx-beep"{{if eq "pcspeaker" $audio}} checked{{end}}>
                      <label class="form-check-label" for="emulate-sfx-beep"><strong class="text-primary">Speaker</strong>, PC BIOS audio</label>
                      <div class="form-text mt-0">Fallback to standard 1981 IBM PC speaker only.</div>
                    </div>
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="radio" autocomplete="off" name="emulate-sfx" value="none" id="emulate-sfx-mute"{{if eq "none" $audio}} checked{{end}}>
                      <label class="form-check-label text-danger fw-semibold" for="emulate-sfx-mute">Mute, no audio</label>
                      <div class="form-text mt-0">Fallback when emulated audio breaks the program.</div>
                    </div>
                  </div>
                </fieldset>
              </div>
            </div>
          </div>
        </div>

        {{- /*  Memory options  */}}
        <div class="card">
          <div class="card-body">
            <legend class="fs-5 mb-2 d-flex align-items-center gap-2">
              <svg class="bi" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <use xlink:href="/svg/bootstrap-icons.svg#memory"/>
              </svg>
              Memory tweaks
            </legend>
            <p class="form-text mt-0 mb-3">
              All memory extensions above the 640 KB DOS limit are enabled by default. Disable individual types if older software misbehaves.
            </p>
            <div class="d-flex flex-column gap-3">
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" autocomplete="off" role="switch"
                  hx-patch="/editor/emulate/umb/{{$id}}"
                  hx-trigger="change"
                  hx-on:change="document.getElementById('emulate-ram-umb-result').textContent=''"
                  hx-include="[name='emulate-ram-umb']"
                  hx-target="#emulate-ram-umb-result"
                  name="emulate-ram-umb"
                  id="emulate-ram-umb"{{if eq true (index . "modEmulateUMB")}} checked{{end}}>
                <label class="form-check-label fw-semibold" for="emulate-ram-umb">Upper memory blocks <span class="text-secondary fw-normal">(UMB)</span></label>
                <span class="ms-2" id="emulate-ram-umb-result"></span>
                <div class="form-text mt-0">
                  RAM between 640 KB and 1 MB used for drivers and TSRs; disable if drivers conflict.
                </div>
              </div>
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" autocomplete="off" role="switch"
                  hx-patch="/editor/emulate/ems/{{$id}}"
                  hx-trigger="change"
                  hx-on:change="document.getElementById('emulate-ram-ems-result').textContent=''"
                  hx-include="[name='emulate-ram-ems']"
                  hx-target="#emulate-ram-ems-result"
                  name="emulate-ram-ems"
                  id="emulate-ram-ems"{{if eq true (index . "modEmulateEMS")}} checked{{end}}>
                <label class="form-check-label fw-semibold" for="emulate-ram-ems">Expanded memory <span class="text-secondary fw-normal">(EMS)</span></label>
                <span class="ms-2" id="emulate-ram-ems-result"></span>
                <div class="form-text mt-0">
                  Mid-1980s paged memory standard above 1 MB (mainly business software and older drivers).
                </div>
              </div>
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" autocomplete="off" role="switch"
                  hx-patch="/editor/emulate/xms/{{$id}}"
                  hx-trigger="change"
                  hx-on:change="document.getElementById('emulate-ram-xms-result').textContent=''"
                  hx-include="[name='emulate-ram-xms']"
                  hx-target="#emulate-ram-xms-result"
                  name="emulate-ram-xms"
                  id="emulate-ram-xms"{{if eq true (index . "modEmulateXMS")}} checked{{end}}>
                <label class="form-check-label fw-semibold" for="emulate-ram-xms">Extended memory <span class="text-secondary fw-normal">(XMS)</span></label>
                <span class="ms-2" id="emulate-ram-xms-result"></span>
                <div class="form-text mt-0">
                  Standard 286+ extended memory used by most early-to-mid 1990s games and demos.
                </div>
              </div>
            </div>
          </div>
        </div>
        {{- end}}
    </div>
    {{/*  Switch to assets and reset buttons  */}}
    {{- template "artifactfooter" . }}
  </div>
</div>    
{{- end}}
{{- end}}
