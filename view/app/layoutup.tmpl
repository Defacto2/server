{{- /* 
    layoutup.tmpl ~ Uploader pull-down menu.
*/ -}}
{{- define "layoutup" }}
{{- $editor := index . "editor" }}
<div class="btn-group ms-lg-auto my-2 my-lg-0">
  <button class="btn btn-sm {{if $editor}}btn-outline-warning{{else}}btn-outline-light{{end}} dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
    {{- if not $editor}}Uploader{{else}}Site editor{{end}}
  </button>
  <ul class="dropdown-menu dropdown-menu-lg-end">
    {{- template "layoutlock" . }}
    <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-about">About</button></li>
    <li><a class="dropdown-item" href="/titles">Naming guide</a></li>
    <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-shortcuts">Keyboard shortcuts</button></li>
    <li><hr class="dropdown-divider"></li>
    <li><h6 class="dropdown-header">Submit a production</h6></li>
    <li data-bs-toggle="tooltip" data-bs-title="control + alt + z">
      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-demozoo-modal">Demo<u>z</u>oo</button></li>
    <li>
      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-pouet-modal">Pouët</button></li>
    <li><hr class="dropdown-divider"></li>
    <li><h6 class="dropdown-header">Upload files</h6></li>
    <li data-bs-toggle="tooltip" data-bs-title="control + alt + c">
      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-intro-modal">
      Intro, <u>C</u>racktro, BBStro</button></li>
    <li data-bs-toggle="tooltip" data-bs-title="control + alt + t">
      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-trainer-modal">
      <u>T</u>rainer or installer</button></li>
    <li data-bs-toggle="tooltip" data-bs-title="control + alt + n">
      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-text-modal">
      Text, ANSI or <u>N</u>FO</button></li>
    <li data-bs-toggle="tooltip" data-bs-title="control + alt + p">
      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-image-modal">
      Image or <u>p</u>hoto</button></li>
    <li data-bs-toggle="tooltip" data-bs-title="control + alt + m">
      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-magazine-modal">
      <u>M</u>agazine</button></li>
    <li data-bs-toggle="tooltip" data-bs-title="control + alt + a">
      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#uploader-advanced-modal">
      <u>A</u>dvanced uploader</button></li>
  </ul>
</div>
{{- end}}
