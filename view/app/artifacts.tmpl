{{- /* 
    artifacts.tmpl ~ the template is for the artifact cards.
    see the artifact.tmpl for the single artifact page template.
*/ -}}
{{- define "content" }}
{{- $counter := 0}}
{{- $files := index .stats.files }}
{{- $years := index .stats.years}}
{{- $cnt := len .records}}
{{- $web := index .website }}
{{- $linkWeb := gt (len $web) 0}}
{{- $zoo := index .demozoo }}
{{- $bbs := index .bbs }}
{{- $linkZoo := ne $zoo "0"}}
{{- $sixteen := index .sixteen }}
{{- $link16C := ne $sixteen ""}}
{{- $csdb := index .csdb }}
{{- $linkcsdb := gt $csdb 0}}
{{- $janeway := index .janeway}}
{{- $linkjaneway := gt $janeway 0}}
{{- $tidbit := index .tidbits}}
{{- $linkTidbit := gt (len $tidbit) 0}}
{{- $scener := index .scener }}
{{- $noYears := false}}
{{- $unYears := index .unknownYears }}
{{- $editor := index .editor}}
{{- $noGroupLinks := index . "noGroupLinks"}}
{{- $group := hasSuffix (index .title) " artifacts"}}
<div class="container-xxl">
{{- if eq $cnt 0}}<p class="small text-body-secondary mb-2">There are no artifacts to display.</p>{{else -}}
<p class="small text-body-secondary mb-2">There {{if eq $cnt 1}}is{{else}}are{{end}} {{$files | safeHTML}}{{if and (ne $years "0 - 0") (ne $years "the year 0")}} from {{$years | safeHTML}}{{end}}.</p>
{{- end}}
{{- if $linkTidbit}}
<section class="tidbit-section border-top border-bottom py-3 mb-3" id="tidbit-card">
  <div class="tidbit-body" id="tidbit-body">
    {{$tidbit}}
  </div>
  <div class="mt-2 d-none" id="tidbit-toggle-bar">
    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-medium" id="tidbit-toggle" aria-expanded="false" aria-controls="tidbit-body">Read more</button>
  </div>
</section>
<script>
(() => {
  const body = document.getElementById('tidbit-body');
  const bar = document.getElementById('tidbit-toggle-bar');
  const btn = document.getElementById('tidbit-toggle');
  if (!body || !bar || !btn) return;

  for (const prose of body.querySelectorAll('.tidbit-prose')) {
    if (prose.textContent.trim().length > 320) {
      prose.classList.add('tidbit-columns');
    }
  }

  const threshold = 360;
  if (body.scrollHeight <= threshold) return;

  let expanded = false;
  const setState = (open) => {
    expanded = open;
    body.classList.toggle('is-collapsed', !open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.textContent = open ? 'Show less' : 'Read more';
  };

  bar.classList.remove('d-none');
  setState(window.location.hash.startsWith('#fn'));

  btn.addEventListener('click', () => setState(!expanded));
  body.addEventListener('click', (evt) => {
    const link = evt.target.closest('a[href^="#"]');
    if (link && !expanded) setState(true);
  });
})();
</script>
{{- end}}
{{- if or $linkZoo $link16C $linkjaneway $linkcsdb $linkWeb}}
<div class="d-flex flex-wrap align-items-baseline gap-3 small text-body-secondary mb-3">
  <span class="fw-medium">External links:</span>
  {{- if and (eq $bbs false) (eq $linkZoo true)}}
  <a class="link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover icon-link icon-link-hover" href="https://demozoo.org/groups/{{$zoo}}/" target="_blank" rel="noopener" data-bs-toggle="tooltip" data-bs-title="Production and member lists">Demozoo{{linkSVG}}</a>
  {{- else if and (eq $bbs true) (eq $linkZoo true)}}
  <a class="link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover icon-link icon-link-hover" href="https://demozoo.org/bbs/{{$zoo}}/" target="_blank" rel="noopener" data-bs-toggle="tooltip" data-bs-title="Staff, numbers, and affiliations">Demozoo{{linkSVG}}</a>
  {{- end}}
  {{- if $link16C}}
  <a class="link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover icon-link icon-link-hover" href="https://16colo.rs/{{$sixteen}}" target="_blank" rel="noopener" data-bs-toggle="tooltip" data-bs-title="ANSI and text artworks">16colors{{linkSVG}}</a>
  {{- end}}
  {{- if $linkjaneway}}
  <a class="link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover icon-link icon-link-hover" href="https://janeway.exotica.org.uk/author.php?id={{$janeway}}" target="_blank" rel="noopener" data-bs-toggle="tooltip" data-bs-title="Amiga releases">Kestra{{linkSVG}}</a>
  {{- end}}
  {{- if $linkcsdb}}
  <a class="link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover icon-link icon-link-hover" href="https://csdb.dk/group/?id={{$csdb}}" target="_blank" rel="noopener" data-bs-toggle="tooltip" data-bs-title="C-64 releases">CSDb{{linkSVG}}</a>
  {{- end}}
  {{- if $linkWeb}}
    {{- $notworking := false }}
    {{- range $web }}
      {{- if and (ne .URL "") (eq .Error false ) }}
      <a class="link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover icon-link icon-link-hover" href="{{.URL}}" target="_blank" rel="noopener">{{.Name}}{{websiteIcon .URL}}</a>
      {{- end}}
    {{- end}}
    {{- range $web }}
      {{- if and (ne .URL "") (eq .Error true ) }}
      {{- if eq $notworking false }}
        {{- $notworking = true }}
        <span class="ms-1">Ex-sites:</span>
      {{- end }}
      <span class="text-nowrap"><strong>{{.Name}}</strong> <span class="text-body-tertiary">{{.URL}}</span></span>
      {{- end}}
    {{- end}}
  {{- end}}
</div>
{{- end}}
</div>
{{- if eq $cnt 0}}{{else -}}
<div class="container-xxl mb-3">
  <div class="bg-body-tertiary border rounded-2 px-2 py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="d-none d-lg-inline-block"><button type="button" id="fluid-button" class="btn btn-sm btn-outline-secondary">Unlock columns</button></span>
        {{- if and (eq $editor true) (ge $cnt 5)}}
        <div class="dropdown" id="batch-open-dropdown">
          <button type="button" id="batch-open-button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            Open multiple tabs
          </button>
          <ul class="dropdown-menu" id="batch-open-menu" aria-labelledby="batch-open-button"></ul>
        </div>
        {{- end}}
      </div>
      {{- if ge $cnt 3}}
      <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
        <span class="small text-body-secondary text-nowrap font-monospace" id="artifact-count">{{$cnt}} {{if eq $cnt 1}}artifact{{else}}artifacts{{end}}</span>
        <div class="input-group input-group-sm" style="width: 16rem; max-width: 100%;">
          <input type="search" id="artifact-filter" class="form-control" placeholder="Filter this page..." aria-label="Filter artifacts on this page" autocomplete="off">
          <button type="button" id="artifact-filter-clear" class="btn btn-outline-secondary" aria-label="Clear filter" disabled>Clear</button>
        </div>
      </div>
      {{- end}}
    </div>
    {{- if and (.Pagination) (gt (index .Pagination.SumPages) 1)}}
    <nav class="border-top mt-2 pt-2 d-flex flex-wrap align-items-center gap-3" aria-label="Compact pagination navigation at the header">
      <label for="paginationRange" id="paginationRangeLabel" class="form-label small font-monospace text-body-secondary text-nowrap mb-0">
        Page {{.Pagination.CurrPage}} / {{.Pagination.SumPages}}
      </label>
      <input type="range" class="form-range w-auto flex-grow-1" style="min-width: 8rem;" id="paginationRange" name="paginationRange"
        data-base-url="{{.Pagination.BaseURL}}"
        min="1" max="{{index .Pagination.SumPages}}" value="{{index .Pagination.CurrPage}}" step="1">
      <ul class="pagination pagination-sm mb-0 flex-shrink-0">
        {{ template "paginationList" . }}
      </ul>
    </nav>
    {{- end}}
  </div>
  {{- if and (eq $editor true) (ge $cnt 5)}}
  <div id="batch-open-alert" class="alert alert-warning text-center py-1 px-2 small mx-auto mt-2 mb-0 d-none" style="max-width: 36rem;" role="alert"></div>
  {{- end}}
</div>
{{- if ge $cnt 3}}
<div class="container-xxl">
  <div id="artifact-empty" class="alert alert-light border text-center my-4 d-none" role="status">
    No artifacts matched <strong id="artifact-empty-query"></strong> on this page.
    <button type="button" id="artifact-empty-clear" class="btn btn-link btn-sm p-0 ms-1 align-baseline">Clear filter</button>
  </div>
</div>
{{- end}}
{{- end}}
{{- $rowCols := "d-grid gap-3 justify-content-center" }}
<div id="fluid-artifacts" class="{{$rowCols}}" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 400px));">
  {{- /*  Begin the iteration of the records  */}}
  {{- range .records }}
  {{- if eq true $editor}}{{- $counter = add $counter }}{{end}}
  {{- $jsdos := jsdosUsage .Filename.String .Platform.String}}
  {{- $filename := mask .Filename.String}}
  {{- if eq $filename ""}}{{$filename = "no filename provided"}}{{end}}
  {{- $forApproval := and (eq .Deletedat.IsZero false) (eq .Deletedby.String "")}}
  {{- if and (ne $forApproval true) (eq $unYears true) (eq $noYears false) (eq .DateIssuedYear.Int16 0)}}
    {{- /*  
        Create a break in the iteration of the records when $noYears is true.
        This should never display with search or order by date of records listings.
    */ -}}
    {{- $noYears = true}}
</div>
<div id="artifact-unknown-years-header" class="w-100 text-center"><hr class="mt-5 mb-4"><p class="lead"><small>These are files from an unknown year</small></p></div>
<div class="{{$rowCols}}" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 400px));">
  {{- end}}
  {{- /*  Card for an individual artifact record  */}}
  {{- $attr := attribute .CreditText.String .CreditProgram.String .CreditIllustration.String .CreditAudio.String $scener}}
  {{- $cardClass := "h-100"}}
  {{- $forClass := " border border-1 border-info"}}
  {{- if $forApproval}}{{$cardClass = print $cardClass $forClass}}{{end}}
  {{- $removedClass := " border border-2 border-danger"}}
  {{- $removed := and (eq .Deletedat.IsZero false) (ne .Deletedby.String "")}}
  {{- if $removed}}{{$cardClass = print $cardClass $removedClass}}{{end}}
  {{- $unwantedClass := " border border-1 border-warning"}}
  {{- $unwanted := (ne .FileSecurityAlertURL.String "")}}
  {{- if $unwanted}}{{$cardClass = print $cardClass $unwantedClass}}{{end}}
  {{- $anim := ""}}
  {{- if eq .FileMagicType.String "ANSImation"}}{{$anim = animPreview .UUID.String}}{{end}}
  <div class="col artifact-item">
    <div class="card {{$cardClass}}"{{- if eq $editor true}} data-artifact-url="{{linkHref .ID}}"{{- end}}{{- if ne $anim ""}} data-anim-src="{{$anim}}"{{- end}}>
      <div class="card-header bg-body-tertiary text-body-secondary text-center text-truncate py-2" title="{{$filename}}">
        <code class="h6 mb-0 text-break">{{if gt $counter 0}}{{$counter}} {{end}}{{$filename}}</code>
      </div>
      <div class="card-body py-3 d-flex flex-column">
        {{- $relrs := "" }}
        {{- if eq $noGroupLinks true }}{{ $relrs = nameRelrs .GroupBrandFor .GroupBrandBy }}{{ else }}{{ $relrs = linkRelrs .GroupBrandFor .GroupBrandBy }}{{ end }}
        {{- if eq $group true}}
        <h2 class="card-title text-truncate fs-6">{{$relrs}}</h2>
        {{subTitle .Section .RecordTitle true}}
        {{- else}}
        <h2 class="card-title text-truncate fs-5">{{$relrs}}</h2>
        {{subTitle .Section .RecordTitle false}}
        {{- end}}
        <p class="card-text small mb-1">{{describe .Platform .Section .DateIssuedYear .DateIssuedMonth}}</p>
        <p class="card-text mb-1"><small class="text-body-secondary">{{lastUpdated .Updatedat}}</small></p>
        {{- if ne $attr ""}}
        <p class="card-text mb-1"><small class="text-body-secondary">{{$attr}}</small></p>
        {{- end}}
        <div class="border-top pt-2 mt-auto">
          <div class="d-flex flex-wrap align-items-baseline gap-3">
            {{if and (gt $counter 0) (le $counter 9)}}{{- linkPage .ID $counter}}{{else}}{{- linkPage .ID ""}}{{end}}
            <span class="text-nowrap">{{- linkDownload .ID .FileSecurityAlertURL.String }}{{ downloadB .Filesize}}</span>
            {{- linkPreview .ID .Filename.String .Platform.String}}
            {{- if eq $jsdos true}}{{- linkRunApp .ID}}{{end}}
          </div>
        </div>
      </div>
      {{- if eq $editor true}}{{ template "artifactsedit" . }}{{end}}
      {{- $thumb := thumb .UUID.String .Filename.String true }}
      {{- if ne (print $thumb) "<!-- no thumbnail found -->" }}
      {{- if ne $anim "" }}
      <a class="position-relative d-block" href="{{linkHref .ID}}">{{$thumb}}<span class="anim-badge badge text-bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-2 pe-none" aria-hidden="true">&#9654;</span></a>
      {{- else }}
      <a href="{{linkHref .ID}}">{{$thumb}}</a>
      {{- end }}
      {{- else }}{{$thumb}}{{- end }}
    </div>
  </div>
  {{- /*  End of the iteration of the records */}}
  {{- end}}
</div>
{{- end}}
