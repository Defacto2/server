{{- /* 
    artifacts.tmpl ~ the template is for the artifact cards.
    see the artifact.tmpl for the single artifact page template.
*/ -}}
{{- define "content" }}
{{- $counter := 0}}
{{- $files := index .stats.files }}
{{- $years := index .stats.years}}
{{- $cnt := len .records}}
{{- $web := index .website }}
{{- $linkWeb := gt (len $web) 0}}
{{- $zoo := index .demozoo }}
{{- $bbs := index .bbs }}
{{- $linkZoo := ne $zoo "0"}}
{{- $sixteen := index .sixteen }}
{{- $link16C := ne $sixteen ""}}
{{- $csdb := index .csdb }}
{{- $linkcsdb := gt $csdb 0}}
{{- $janeway := index .janeway}}
{{- $linkjaneway := gt $janeway 0}}
{{- $tidbit := index .tidbits}}
{{- $linkTidbit := gt (len $tidbit) 0}}
{{- $scener := index .scener }}
{{- $noYears := false}}
{{- $unYears := index .unknownYears }}
{{- $editor := index .editor}}
{{- $noGroupLinks := index . "noGroupLinks"}}
{{- $group := hasSuffix (index .title) " artifacts"}}
{{- $breakline := false}}
<div class="container-xxl">
{{- if eq $cnt 0}}<p class="text-start lead"><small>There are no artifacts to display.</small></p>{{else -}}
<p class="text-start lead"><small>There {{if eq $cnt 1}}is{{else}}are{{end}} {{$files | safeHTML}}{{if and (ne $years "0 - 0") (ne $years "the year 0")}} from {{$years | safeHTML}}{{end}}.</small></p>
{{- end}}
{{- if $linkTidbit}}
  <small class="fw-light">Additional information</small>
  <ul class="list-group list-group-flush">{{$tidbit}}</ul>
{{- end}}
{{- if or $linkZoo $link16C $linkWeb}}
<div class="text-start text-sm-center text-md-end lead">
  {{-  if and (eq $bbs false) (eq $linkZoo true)}}
  <small><small>Production and member lists</small> <a class="link-offset-2 icon-link icon-link-hover" href="https://demozoo.org/groups/{{$zoo}}/"><strong>Demozoo</strong>{{linkSVG}}</a></small><br>
  {{- else if and (eq $bbs true) (eq $linkZoo true)}}
  <small><small>Staff, numbers, and affiliations</small> <a class="link-offset-2 icon-link icon-link-hover" href="https://demozoo.org/bbs/{{$zoo}}/"><strong>Demozoo</strong>{{linkSVG}}</a></small><br>
  {{- end}}
  {{- if $link16C}}
  <small><small>ANSI and text artworks</small> <a class="link-offset-2 icon-link icon-link-hover" href="https://16colo.rs/{{$sixteen}}"><strong>16colors</strong>{{linkSVG}}</a></small><br>
  {{- end}}
  {{- if $linkjaneway}}
  <small><small>Amiga releases</small> <a class="link-offset-2 icon-link icon-link-hover" href="https://janeway.exotica.org.uk/author.php?id={{$janeway}}"><strong>Kestra</strong>{{linkSVG}}</a></small><br>
  {{- end}}
  {{- if $linkcsdb}}
  <small><small>C-64 releases</small> <a class="link-offset-2 icon-link icon-link-hover" href="https://csdb.dk/group/?id={{$csdb}}"><strong>csdb</strong>{{linkSVG}}</a></small><br>
  {{- end}}
  {{- if $linkWeb}}
    {{- $notworking := false }}
    {{- range $web }}
      {{- if and (ne .URL "") (eq .Error false ) }}
      {{- $breakline = true }}
      <small><small><a class="link-offset-2 icon-link icon-link-hover" href="{{.URL}}"><strong>{{.Name}}</strong>{{websiteIcon .URL}}</a></small> &nbsp; </small>
      {{- end}}
      {{- if and (ne .URL "") (eq .Error true ) }}
      {{- if eq $notworking false }}
        {{- $notworking = true }}
        {{- if eq $breakline true }}<br>{{- end}}<small><small> &nbsp; ex-sites &nbsp; </small></small>
      {{- end }}
      <small class="text-nowrap"><small><strong>{{.Name}}</strong> <span class="text-body-tertiary fw-lighter">{{.URL}}</span>.</small></small>
      {{- end}}
    {{- end}}
  {{- end}}
</div>
{{- end}}
</div>
{{- if eq $cnt 0}}{{else -}}
<div class="container-xxl mb-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
      <span class="d-none d-lg-inline-block"><button type="button" id="fluid-button" class="btn btn-sm btn-outline-secondary">Unlock columns</button></span>
      {{- if and (eq $editor true) (ge $cnt 5)}}
      <div class="dropdown" id="batch-open-dropdown">
        <button type="button" id="batch-open-button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
          Open mutltiple tabs
        </button>
        <ul class="dropdown-menu" id="batch-open-menu" aria-labelledby="batch-open-button"></ul>
      </div>
      <span class="text-body-secondary small">Multiple tabs requires <em>Allowed to send pop-ups</em></span>
      {{- end}}
    </div>
    {{- if ge $cnt 3}}
    <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
      <span class="small text-body-secondary text-nowrap" id="artifact-count">{{$cnt}} {{if eq $cnt 1}}artifact{{else}}artifacts{{end}}</span>
      <div class="input-group input-group-sm" style="width: 17rem; max-width: 100%;">
        <input type="search" id="artifact-filter" class="form-control" placeholder="Filter this page..." aria-label="Filter artifacts on this page" autocomplete="off">
        <button type="button" id="artifact-filter-clear" class="btn btn-outline-secondary" aria-label="Clear filter" disabled>Clear</button>
      </div>
    </div>
    {{- end}}
  </div>
  {{- if and (eq $editor true) (ge $cnt 5)}}
  <div id="batch-open-alert" class="alert alert-warning text-center py-1 px-2 small mx-auto mt-2 mb-0 d-none" style="max-width: 36rem;" role="alert"></div>
  {{- end}}
</div>
{{- if ge $cnt 3}}
<div class="container-xxl">
  <div id="artifact-empty" class="alert alert-light border text-center my-4 d-none" role="status">
    No artifacts matched <strong id="artifact-empty-query"></strong> on this page.
    <button type="button" id="artifact-empty-clear" class="btn btn-link btn-sm p-0 ms-1 align-baseline">Clear filter</button>
  </div>
</div>
{{- end}}
{{- end}}
{{- $rowCols := "d-grid gap-3 justify-content-center" }}
<div id="fluid-artifacts" class="{{$rowCols}}" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 400px));">
  {{- /*  Begin the iteration of the records  */}}
  {{- range .records }}
  {{- if eq true $editor}}{{- $counter = add $counter }}{{end}}
  {{- $jsdos := jsdosUsage .Filename.String .Platform.String}}
  {{- $filename := mask .Filename.String}}
  {{- if eq $filename ""}}{{$filename = "no filename provided"}}{{end}}
  {{- $forApproval := and (eq .Deletedat.IsZero false) (eq .Deletedby.String "")}}
  {{- if and (ne $forApproval true) (eq $unYears true) (eq $noYears false) (eq .DateIssuedYear.Int16 0)}}
    {{- /*  
        Create a break in the iteration of the records when $noYears is true.
        This should never display with search or order by date of records listings.
    */ -}}
    {{- $noYears = true}}
</div>
<div id="artifact-unknown-years-header" class="w-100 text-center"><hr class="mt-5 mb-4"><p class="lead"><small>These are files from an unknown year</small></p></div>
<div class="{{$rowCols}}" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 400px));">
  {{- end}}
  {{- /*  Card for an individual artifact record  */}}
  {{- $attr := attribute .CreditText.String .CreditProgram.String .CreditIllustration.String .CreditAudio.String $scener}}
  {{- $cardClass := "h-100"}}
  {{- $forClass := " border border-1 border-info"}}
  {{- if $forApproval}}{{$cardClass = print $cardClass $forClass}}{{end}}
  {{- $removedClass := " border border-2 border-danger"}}
  {{- $removed := and (eq .Deletedat.IsZero false) (ne .Deletedby.String "")}}
  {{- if $removed}}{{$cardClass = print $cardClass $removedClass}}{{end}}
  {{- $unwantedClass := " border border-1 border-warning"}}
  {{- $unwanted := (ne .FileSecurityAlertURL.String "")}}
  {{- if $unwanted}}{{$cardClass = print $cardClass $unwantedClass}}{{end}}
  {{- $anim := ""}}
  {{- if eq .FileMagicType.String "ANSImation"}}{{$anim = animPreview .UUID.String}}{{end}}
  <div class="col artifact-item">
    <div class="card {{$cardClass}}"{{- if eq $editor true}} data-artifact-url="{{linkHref .ID}}"{{- end}}{{- if ne $anim ""}} data-anim-src="{{$anim}}"{{- end}}>
      <div class="card-header text-body-secondary text-center text-truncate">
        <code class="h6 mb-0 text-break">{{if gt $counter 0}}{{$counter}} {{end}}{{$filename}}</code>
      </div>
      <div class="card-body">
        {{- $relrs := "" }}
        {{- if eq $noGroupLinks true }}{{ $relrs = nameRelrs .GroupBrandFor .GroupBrandBy }}{{ else }}{{ $relrs = linkRelrs .GroupBrandFor .GroupBrandBy }}{{ end }}
        {{- if eq $group true}}
        <h2 class="card-title text-truncate fs-6">{{$relrs}}</h2>
        {{subTitle .Section .RecordTitle true}}
        {{- else}}
        <h2 class="card-title text-truncate fs-5">{{$relrs}}</h2>
        {{subTitle .Section .RecordTitle false}}
        {{- end}}
        <p class="card-text">{{describe .Platform .Section .DateIssuedYear .DateIssuedMonth}}</p>
        <p class="card-text"><small class="text-body-secondary">{{lastUpdated .Updatedat}}</small></p>
        {{- if ne $attr ""}}
        <p class="card-text"><small class="text-body-secondary">{{$attr}}</small></p>
        {{- end}}
        <div class="d-flex flex-wrap align-items-baseline gap-3">
          {{if and (gt $counter 0) (le $counter 9)}}{{- linkPage .ID $counter}}{{else}}{{- linkPage .ID ""}}{{end}}
          <span class="text-nowrap">{{- linkDownload .ID .FileSecurityAlertURL.String }}{{ downloadB .Filesize}}</span>
          {{- linkPreview .ID .Filename.String .Platform.String}}
          {{- if eq $jsdos true}}{{- linkRunApp .ID}}{{end}}
        </div>
      </div>
      {{- if eq $editor true}}{{ template "artifactsedit" . }}{{end}}
      {{- $thumb := thumb .UUID.String .Filename.String true }}
      {{- if ne (print $thumb) "<!-- no thumbnail found -->" }}
      {{- if ne $anim "" }}
      <a class="position-relative d-block" href="{{linkHref .ID}}">{{$thumb}}<span class="anim-badge badge text-bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-2 pe-none" aria-hidden="true">&#9654;</span></a>
      {{- else }}
      <a href="{{linkHref .ID}}">{{$thumb}}</a>
      {{- end }}
      {{- else }}{{$thumb}}{{- end }}
    </div>
  </div>
  {{- /*  End of the iteration of the records */}}
  {{- end}}
</div>
{{- end}}
