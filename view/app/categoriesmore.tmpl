{{- /*
    categoriesmore.tmpl ~ the more-categories template is for the files, browse categories menu.
*/ -}}
{{- define "morecategories" -}}
{{- $cardClass := " h-100" }}

{{/*  4. Platforms  */}}
<section id="cat-platforms" data-category-section style="scroll-margin-top: 5rem;">
    <div class="mb-3">
        <div class="index-chapter-era font-monospace mb-1">Section platform</div>
        <h2 class="h4 fw-semibold mb-0">Platforms</h2>
    </div>
    <div id="all-other-categories" data-category-card data-keywords="dos ms-dos pc-dos windows console video games macos os x linux unix script shell php perl tcl python ruby java">
        <div class="card">
            <div class="card-header bg-body-tertiary px-3 py-2">
                <ul class="nav nav-underline" id="platformTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="dos-tab" data-bs-toggle="tab"
                            data-bs-target="#dos-tab-pane" type="button" role="tab" aria-controls="dos-tab-pane"
                            aria-selected="true">{{msdos}}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="windows-tab" data-bs-toggle="tab"
                            data-bs-target="#windows-tab-pane" type="button" role="tab"
                            aria-controls="windows-tab-pane" aria-selected="false">Windows</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="console-tab" data-bs-toggle="tab"
                            data-bs-target="#console-tab-pane" type="button" role="tab"
                            aria-controls="console-tab-pane" aria-selected="false">Consoles</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="mac-tab" data-bs-toggle="tab"
                            data-bs-target="#mac-tab-pane" type="button" role="tab"
                            aria-controls="mac-tab-pane" aria-selected="false">macOS</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="linux-tab" data-bs-toggle="tab"
                            data-bs-target="#linux-tab-pane" type="button" role="tab"
                            aria-controls="linux-tab-pane" aria-selected="false">Linux</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="script-tab" data-bs-toggle="tab"
                            data-bs-target="#script-tab-pane" type="button" role="tab"
                            aria-controls="script-tab-pane" aria-selected="false">Scripts</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="java-tab" data-bs-toggle="tab"
                            data-bs-target="#java-tab-pane" type="button" role="tab"
                            aria-controls="java-tab-pane" aria-selected="false">Java</button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-4">
                <div class="tab-content" id="nav-tabContent">
                    <div class="tab-pane fade show active" id="dos-tab-pane" role="tabpanel" aria-labelledby="dos-tab" tabindex="0">
                        <h3 class="h5 fw-semibold mb-2">{{msdos}} <span class="text-body-secondary fw-normal small">PC</span></h3>
                        <p class="small mb-3">
                            Microsoft MS-DOS and IBM PC DOS were interoperable operating systems for the Intel x86 <u>P</u>ersonal <u>C</u>omputer platform of the 1980s.
                            In the early days, games listed the platform as <q>IBM</q> or <q>IBM PC</q>, before evolving to <q>IBM/Tandy and compatibles</q> and eventually settling on <q>MS-DOS</q> in the 1990s.
                        </p>
                        <a href="/files/msdos" class="btn btn-sm btn-outline-primary">Browse {{msdos}} files</a>
                    </div>
                    <div class="tab-pane fade" id="windows-tab-pane" role="tabpanel" aria-labelledby="windows-tab" tabindex="0">
                        <h3 class="h5 fw-semibold mb-2">Windows <span class="text-body-secondary fw-normal small">PC</span></h3>
                        <p class="small mb-3">
                            Microsoft Windows became the unavoidable replacement for MS-DOS on the Intel x86 <u>P</u>ersonal <u>C</u>omputer platform.
                            Most Windows software hosted on this site from the 1990s targets Windows 95 or 98, while releases from the 2000s target Windows XP or 7.
                        </p>
                        <a href="/files/windows" class="btn btn-sm btn-outline-primary">Browse Windows files</a>
                    </div>
                    <div class="tab-pane fade" id="console-tab-pane" role="tabpanel" aria-labelledby="console-tab" tabindex="0">
                        <h3 class="h5 fw-semibold mb-2">Console <span class="text-body-secondary fw-normal small">various systems</span></h3>
                        <p class="small mb-3">
                            A console is a video game system designed to be used on a television and interacted with using a controller or joystick.
                            For simplicity, we do not differentiate between the various companies or system generations.
                        </p>
                        <a href="/files/console" class="btn btn-sm btn-outline-primary">Browse console files</a>
                    </div>
                    <div class="tab-pane fade" id="mac-tab-pane" role="tabpanel" aria-labelledby="mac-tab" tabindex="0">
                        <h3 class="h5 fw-semibold mb-2">macOS</h3>
                        <p class="small mb-3">
                            Software for the proprietary line of computers by Apple, initially created for Apple Macintosh System Software, later renamed Mac OS and now macOS.
                            Unlike Microsoft Windows, Apple has used different hardware architectures over the years, so Apple platforms lack backward compatibility.
                        </p>
                        <a href="/files/macos" class="btn btn-sm btn-outline-primary">Browse macOS files</a>
                    </div>
                    <div class="tab-pane fade" id="linux-tab-pane" role="tabpanel" aria-labelledby="linux-tab" tabindex="0">
                        <h3 class="h5 fw-semibold mb-2">Linux</h3>
                        <p class="small mb-3">
                            Software created for Linux or Unix platforms. Obsolete software targeting the desktop will likely fail on modern distributions, though terminal apps may still work.
                        </p>
                        <a href="/files/linux" class="btn btn-sm btn-outline-primary">Browse Linux files</a>
                    </div>
                    <div class="tab-pane fade" id="script-tab-pane" role="tabpanel" aria-labelledby="script-tab" tabindex="0">
                        <h3 class="h5 fw-semibold mb-2">Scripts</h3>
                        <p class="small mb-3">
                            Shell scripts and software created in interpreted programming languages such as PHP, Perl, Tcl, Python, and Ruby.
                        </p>
                        <a href="/files/script" class="btn btn-sm btn-outline-primary">Browse scripts</a>
                    </div>
                    <div class="tab-pane fade" id="java-tab-pane" role="tabpanel" aria-labelledby="java-tab" tabindex="0">
                        <h3 class="h5 fw-semibold mb-2">Java</h3>
                        <p class="small mb-3">
                            Software written in Java, a popular language for cross-platform applications (unrelated to JavaScript).
                        </p>
                        <a href="/files/java" class="btn btn-sm btn-outline-primary">Browse Java files</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{{/*  5. Tools  */}}
<section id="cat-tools" data-category-section style="scroll-margin-top: 5rem;">
    <div class="mb-3">
        <div class="index-chapter-era font-monospace mb-1">Section tool</div>
        <h2 class="h4 fw-semibold mb-0">Tools</h2>
    </div>
    <div class="row row-cols-1 row-cols-md-2 g-3">
        <div class="col" data-category-card data-keywords="trainer cheat exploit game hack">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Game trainers &amp; hacks</h3>
                    <p class="card-text small">
                        A small collection of obsolete hacks, exploits, cheats, and trainers for obsolete PC games.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/hack" class="btn btn-sm btn-outline-primary">Browse hacks &amp; trainers</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="tool computer tool crack patch decrypt analyze">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Computer tools</h3>
                    <p class="card-text small">
                        Obsolete software to analyze, decrypt, patch, and crack other programs.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/tool" class="btn btn-sm btn-outline-primary">Browse tools</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="nfo tool ansi tool editor">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">NFO &amp; ANSI tools</h3>
                    <p class="card-text small">
                        Obsolete software designed to create and edit NFO text files and ANSI art.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/nfo-tool" class="btn btn-sm btn-outline-primary">Browse NFO &amp; ANSI tools</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="unprotect guide how-to instruction tutorial">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Unprotect &amp; guides</h3>
                    <p class="card-text small">
                        Obsolete texts and how-to guides on how to analyze, patch, and crack obsolete software.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/how-to" class="btn btn-sm btn-outline-primary">Browse guides</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12" data-category-card data-keywords="database db dataset release list">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <h3 class="h5 card-title fw-semibold mb-1">Databases</h3>
                        <p class="card-text small mb-0">
                            Private datasets of cracked software titles, release dates, and associated groups (often incomplete or approximate due to their scope).
                        </p>
                    </div>
                    <a href="/files/database" class="btn btn-sm btn-outline-primary text-nowrap">Browse databases</a>
                </div>
            </div>
        </div>
    </div>
</section>

{{/*  6. Scene culture  */}}
<section id="cat-culture" data-category-section style="scroll-margin-top: 5rem;">
    <div class="mb-3">
        <div class="index-chapter-era font-monospace mb-1">Section culture</div>
        <h2 class="h4 fw-semibold mb-0">Scene culture and history</h2>
    </div>
    <div class="row row-cols-1 row-cols-md-2 g-3">
        <div class="col" data-category-card data-keywords="news media magazine newspaper article">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Media &amp; news</h3>
                    <p class="card-text small">
                        Computer magazine and newspaper articles reporting on The Scene, usually as image scans or hand-typed text file copies.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/news-article" class="btn btn-sm btn-outline-primary">News articles</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="standards scene rules guidelines">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Community rules &amp; standards</h3>
                    <p class="card-text small">
                        Documented rules and agreed standards for the various activities of The Scene.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/standards" class="btn btn-sm btn-outline-primary">Standards</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="announcement retirement letter">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Announcements</h3>
                    <p class="card-text small">
                        Group and individual announcements to their respective communities, often attention-seeking retirement letters.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/announcement" class="btn btn-sm btn-outline-primary">Announcements</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="job ad application ad trial crackme recruitment">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Job applications &amp; crackmes</h3>
                    <p class="card-text small">
                        Before Apple's App Store, The Scene used "app" for a form to apply for a role in a group or gain access to a board or site.
                    </p>
                    <div class="mt-auto pt-2 d-flex flex-wrap gap-2">
                        <a href="/files/job-advert" class="btn btn-sm btn-outline-primary">Job adverts</a>
                        <a href="/files/trial-crackme" class="btn btn-sm btn-outline-secondary">Trial crackmes</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="drama flamewar conflict doxxing">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Community drama</h3>
                    <p class="card-text small">
                        The competitive scene often led to online flamewars and occasional real-life conflicts, including early forms of doxxing.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/drama" class="btn btn-sm btn-outline-primary">Drama</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="bust takedown police raid arrest">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Bust &amp; takedown</h3>
                    <p class="card-text small">
                        Reports and community alerts following police arrests and raids on sceners, boards, and sites.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/takedown" class="btn btn-sm btn-outline-primary">Takedowns</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="for sale advert commercial merch cd">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">For sale</h3>
                    <p class="card-text small">
                        Adverts for commercial goods and online services varying in legality, from novelty T-shirts to CD collections of pirated software.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/advert" class="btn btn-sm btn-outline-primary">Adverts</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" data-category-card data-keywords="restricted insider behind the scenes internal private">
            <div class="card{{$cardClass}}">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 card-title fw-semibold mb-1">Restricted</h3>
                    <p class="card-text small">
                        Never intended for public consumption, these obsolete internal tools and documents offer insight into the operations of long-gone groups.
                    </p>
                    <div class="mt-auto pt-2">
                        <a href="/files/restrict" class="btn btn-sm btn-outline-primary">Restricted files</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{{- end}}
