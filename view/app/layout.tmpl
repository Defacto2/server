  {{- block "uploader" . -}}{{ "<!-- Uploader content here -->" | safeHTML -}}{{end}}
  {{- block "uploadermodal" . -}}{{ "<!-- Uploader modal content here -->" | safeHTML -}}{{end}}
{{- if eq $databaseErr true -}}
<div class="alert alert-danger" role="alert">
  The database is down, this means the website is not fully working. We are working on it.
</div>{{- end}}
{{- if ne $logo "" -}}
<div class="d-flex justify-content-center mb-2" id="logo-container">
<pre class="text-start text-bg-dark rounded font-dos px-1 py-2 mb-0" id="logo-text">
  {{- /*  
    the monospace brand logo should be padded with the Bootstrap classes
    and not with pre whitespace characters */ -}}
{{- logo }}
{{logoText $logo -}}
</pre>
</div>
{{- end}}
<main>
    {{- if ne $h1 ""}}
    <h1 class="h2 fw-semibold mb-1 container-xxl">{{$h1}}{{if ne $h1sub ""}} <span class="text-body-secondary fw-normal">{{$h1sub}}</span>{{end}}</h1>
    {{- end}}
    {{- if $lead}}
    <p class="text-body-secondary mb-2 container-xxl">
      {{ $lead }}
    </p>
    {{- end}}
    {{- block "content" . -}}{{ "<!-- Content here -->" | safeHTML -}}{{end}}
</main>
{{- if and (.Pagination) (gt (index .Pagination.SumPages) 1)}}
<nav class="container-xxl mt-4" aria-label="Pagination navigation at the footer">
  <div class="bg-body-tertiary border rounded-2 px-3 py-1 d-flex flex-wrap align-items-center justify-content-between gap-2">
    <span class="small font-monospace text-body-secondary">Page {{.Pagination.CurrPage}} / {{.Pagination.SumPages}}</span>
    <ul class="pagination pagination-sm mb-0">
      {{ template "paginationListFooter" . }}
    </ul>
  </div>
</nav>
{{- end }}
<footer class="font-dos text-end mt-3 me-1">
  &copy; <span data-bs-toggle="tooltip" data-bs-title="version: {{ version }}">Defacto2</span>
</footer>
</div>
{{- /*  Do not async load the htmx JS  */}}
<script src="{{ htmx }}?{{ sri_htmx }}" integrity="{{ sri_htmx }}" crossorigin="anonymous"></script>
<script defer src="{{ htmxMultipart }}?{{ sri_htmxMultipart }}" integrity="{{ sri_htmxMultipart }}" crossorigin="anonymous"></script>
{{- /*  Do not defer, or async load the Bootstrap 5.x JS  */}}
<script src="{{ bootstrap5JS }}?{{ sri_bootstrap5JS }}" integrity="{{ sri_bootstrap5JS }}" crossorigin="anonymous"></script>
{{- if $indexJS }}
<script defer src="{{ indexJS }}?{{ sri_indexJS }}" integrity="{{ sri_indexJS }}" crossorigin="anonymous"></script>
{{- end}}
{{- if $pouet}}
<script async src="{{ pouet }}?{{ sri_pouet }}" integrity="{{ sri_pouet }}" crossorigin="anonymous"></script>
{{- end}}
{{- if $contentBinary }}
<script async src="{{ canvasAnsi }}?{{ sri_canvasAnsi }}" integrity="{{ sri_canvasAnsi }}" crossorigin="anonymous"></script>
{{- end}}
{{- if or $contentLatin1 $contentCP437}}
<script async src="{{ canvasReadme }}?{{ sri_canvasReadme }}" integrity="{{ sri_canvasReadme }}" crossorigin="anonymous"></script>
{{- end}}
{{- /*  js-dos v6.22  */}}
{{- if $jsdos}}
<script defer src="{{ jsdos6JS }}?{{ sri_jsdos6JS }}" integrity="{{ sri_jsdos6JS }}" crossorigin="anonymous"></script>
<script>
  window.addEventListener("load", () => {
    const jsdosModal = document.getElementById("js-dos-modal");
    if (jsdosModal != null && window.location.hash === "#runapp") {
      console.info("Do an automatic launch and run of the DOS application.");
      document.getElementById("js-dos-run-app")?.click();
      history.replaceState(null, "", window.location.pathname);
    }
  });
</script>
{{- end}}
{{- template "layoutjsup" . }}
{{- template "layoutjs" . }}
{{- /*  Layout JS  */}}
<script defer src="{{ layoutJS }}?{{ sri_layoutJS }}" integrity="{{ sri_layoutJS }}" crossorigin="anonymous"></script>
{{- /*  Bootstrap carousel initializer (relies on the template and cannot be moved to a JS file)  */}}
{{- if ne $carousel ""}}
<script>
  (() => {
    const myCarouselElement = document.querySelector('{{$carousel}}');
    if (myCarouselElement === null) {
      throw new Error(`Carousel {{$carousel}} element not found`);
    }
    const twoSeconds = 2000;
    const carousel = new bootstrap.Carousel(myCarouselElement, {
      interval: twoSeconds,
      touch: false,
    });
  })();
</script>{{end}}
</body>
</html>{{end}}
