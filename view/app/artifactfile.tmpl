{{- /*
  artifactfile.tmpl
*/ -}}
{{- define "artifactfile" }}
{{- if eq false (index . "editor")}}{{/* render nothing */}}{{else}}
{{- $refreshPage := "refresh the page to see the changes"}}
{{- $notFound := "file not found"}}
{{- $key := index . "modID"}}
{{- $unid := index . "unid"}}
{{- $online := index . "modOnline"}}
{{- $filename := index . "filename"}}
{{- $tag := index . "modTag"}}
{{- $os := index . "modOS"}}
{{- $textFile := or (eq $os "text") (eq $os "textamiga")}}
{{- $databaseMod := index . "modDBModify"}}
{{- $statMod := index . "modStatModify"}}
{{- $statSizeB := index . "modStatSizeB"}}
{{- $statSizeS := index . "modStatSizeF"}}
{{- $magicMIME := index . "modMagicMime"}}
{{- $magicNum := index . "modMagicNumber"}}
{{- $downloadPath := index . "modAbsDownload"}}
{{- $previewImg := recordImgSample $unid}}
{{- $previewImgStat := recordImgSampleStat $unid}}
{{- $thumbImg := recordThumbSample $unid}}
{{- $modDecompress := index . "modDecompress"}}
{{- $modDecompressLoc := index . "modDecompressLoc"}}
{{- $modReadmeSuggest := index . "modReadmeSuggest"}}
{{- $noReadme := index . "disableReadme"}}
{{- /*  File assets and metadata editors  */}}
<style>
  .asset-sample-stage {
    min-height: 170px;
  }
  .asset-sample-stage img {
    max-height: 160px;
    width: auto;
    object-fit: contain;
  }
</style>
<div class="modal fade" id="asset-editor-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" 
  aria-labelledby="asset-editor-modal-label" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      {{/*  Modify the assets for ID  */}}
      <div class="modal-header">
        <svg class="bi" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
          <use xlink:href="/svg/bootstrap-icons.svg#file-binary"/>
        </svg>
        <h2 class="modal-title fs-4 ps-2" id="asset-editor-modal-label">Modify the assets for ID {{$key}}</h2><br>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row row-cols-4 g-1 mb-3">
          {{- /*  Public or hidden record */}}
          <div class="col-12 col-xl-2 col-lg-6 offset-xl-5">
            <div class="input-group">
              <button type="button" class="btn btn-secondary" id="artifact-fileeditor-key-label"
                data-bs-toggle="tooltip" data-bs-title="Copy the key">Record key</button>
              <input type="text" value='{{$key}}' class="form-control" name="artifact-editor-key" id="artifact-fileeditor-key-value"
                aria-describedby="artifact-fileeditor-key-label" autocomplete="off" readonly>
            </div>
          </div>
          <div class="col-12 col-xl-5 col-lg-6">
            <div class="input-group">
              <button type="button" class="btn btn-secondary" id="artifact-fileeditor-unique-id-label"
                data-bs-toggle="tooltip" data-bs-title="Copy the ID">Unique ID</button>
              <input type="text" value='{{$unid}}' class="form-control" 
                aria-describedby="artifact-fileeditor-unique-id-label" id="artifact-fileeditor-unique-id-value" autocomplete="off" readonly>
            </div>
          </div>
        </div>
        {{- /*  Artifact for download  */}}
        <div class="row mt-3 align-items-top">
          <div class="col-xl-6">
            <h4>Artifact for download</h4>
            <div class="input-group mb-1">
              <button type="button" class="btn btn-secondary w-25" id="artifact-editor-location-label"
                data-bs-toggle="tooltip" data-bs-title="Copy the path">Location</button>
              <input type="text" class="form-control" name="artifact-editor-location-value" id="artifact-editor-location-value" 
                aria-describedby="artifact-editor-location-label" value="{{$downloadPath}}" autocomplete="off" readonly>
            </div>
            <div class="input-group mb-1">
              <label class="input-group-text w-25 text-secondary" for="artifact-editor-dl-fn">Filename</label>
              <input type="text" class="form-control w-25" id="artifact-editor-dl-fn" value="{{$filename}}" autocomplete="off" readonly>
            </div>
            <div class="input-group mb-1">
              <label class="input-group-text w-25 text-secondary" for="artifact-editor-dl-fs">Filesize</label>
              <input type="text" class="form-control" id="artifact-editor-dl-fs" value="{{$statSizeB}}" autocomplete="off" readonly>
              <input type="text" class="form-control" id="artifact-editor-dl-fsf" value="{{$statSizeS}}" autocomplete="off" readonly>
            </div>
            <div class="input-group mb-1">
              <label class="input-group-text w-25 text-secondary" for="artifact-editor-dl-lm">Last modified</label>
              <input type="text" class="form-control" id="artifact-editor-dl-lmdb" value="{{$databaseMod}}" 
                data-bs-toggle="tooltip" data-bs-title="Stored in the database" autocomplete="off" readonly>
              <input type="text" class="form-control" id="artifact-editor-dl-lm" value="{{$statMod}}" 
                data-bs-toggle="tooltip" data-bs-title="On file system" autocomplete="off" readonly>
            </div>
            <div class="input-group mb-1">
              <label class="input-group-text w-25 text-secondary" for="artifact-editor-dl-mb">Magic bytes</label>
              <input type="text" class="form-control" id="artifact-editor-dl-mb" value="{{$magicNum}}" 
                data-bs-toggle="tooltip" data-bs-title="Guessed type of file" autocomplete="off" readonly>
            </div>
            <div class="input-group mb-1">
              <label class="input-group-text w-25 text-secondary" for="artifact-editor-dl-mb">Internet MIME</label>
              <input type="text" class="form-control" id="artifact-editor-dl-mime" value="{{$magicMIME}}"
                data-bs-toggle="tooltip" data-bs-title="Guessed MIME type" autocomplete="off" readonly>
            </div>
            <div class="input-group mb-1">
              <label class="input-group-text w-25 text-secondary" for="artifact-editor-dl-classify">Classification</label>
              <input type="text" class="form-control" id="artifact-editor-dl-classify"
                value="{{classificationStr $tag $os}}" autocomplete="off" readonly>
            </div>
            {{- /*  Replacement download input  */}}
            {{- $missingDownload := eq $notFound $statSizeB}}
            {{- if not $missingDownload}}
            <div class="mt-3">
              <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="collapse"
                data-bs-target="#artifact-editor-dl-collapse" aria-expanded="false" aria-controls="artifact-editor-dl-collapse">
                Replace download file&hellip;
              </button>
            </div>
            {{- end}}
            <div class="collapse{{if $missingDownload}} show{{end}}" id="artifact-editor-dl-collapse">
              <form id="artifact-editor-dl-form"
                hx-encoding="multipart/form-data"
                hx-post="/editor/upload/file"
                hx-target="#artifact-editor-dl-feedback"
                {{- if not $missingDownload}} hx-confirm="OK, to replace the existing artifact file download on the server?"{{end}}
                hx-validate="true"
                class="mt-2 p-3 rounded border bg-body-tertiary {{if $missingDownload}}border-success-subtle{{else}}border-danger-subtle{{end}}"
                style="border-left: 4px solid {{if $missingDownload}}var(--bs-success){{else}}var(--bs-danger){{end}} !important;">
                {{- if $missingDownload}}
                <label for="artifact-editor-dl-up" class="form-label fw-semibold text-success-emphasis">Upload the missing download</label>
                {{- else}}
                <label for="artifact-editor-dl-up" class="form-label fw-semibold text-danger-emphasis">Replace artifact download</label>
                {{- end}}
                <input type="hidden" name="artifact-editor-record-key" value="{{$key}}">
                <input type="hidden" name="artifact-editor-unid" value="{{$unid}}">
                <input type="hidden" name="artifact-editor-download-classify" value="{{$os}}">
                <input type="hidden" name="artifact-editor-lastmodified" id="artifact-editor-last-modified">
                {{/*  artifact-editor-unique-id-value  */}}
                <div class="input-group input-group-sm mb-1 has-validation">
                  <input type="file" name="artifact-editor-replace-file" class="form-control w-50" id="artifact-editor-dl-up" aria-describedby="artifact-editor-dl-feedback" required>
                  <button class="btn {{if $missingDownload}}btn-outline-success{{else}}btn-outline-danger{{end}} w-25" id="artifact-editor-dl-submit">{{if $missingDownload}}Upload{{else}}Replace file{{end}}</button>
                  <button class="btn btn-outline-secondary" id="artifact-editor-dl-reset">Clear</button>
                  <div id="artifact-editor-dl-feedback" class="invalid-feedback"></div>
                </div>
                {{- if $missingDownload}}
                <div class="form-text" id="artifact-editor-dl-results"><span class="text-success-emphasis">Upload a new file to use as the artifact download.</span></div>
                {{- else}}
                <div class="form-text" id="artifact-editor-dl-results"><span class="text-danger-emphasis">Rarely required</span>, upload and <u>replace</u> the artifact download.</div>
                {{- end}}
                <progress class="w-100" id="artifact-editor-dl-progress" value="0" max="100"></progress>
                <div class="d-none alert alert-warning mt-2" role="alert" id="artifact-editor-dl-alert"></div>
              </form>
            </div>
            {{- /*  Download content  */}}
            <h4 class="mt-3">Download content</h4>
            {{- if eq $notFound $statSizeB}}
            <div class="input-group mb-3"><span class="text-warning-emphasis">download file not found</span></div>
            {{- else}}
            <div class="input-group mb-3">
              <button type="button" class="btn btn-secondary w-25" id="artifact-editor-templocation-label"
                data-bs-toggle="tooltip" data-bs-title="Copy the path">
                <span role="status">Location</span>
                <span id="artifact-editor-comp-htmx-indicator" class="htmx-indicator spinner-border spinner-border-sm" role="status">
                  <span class="visually-hidden">Loading...</span>
                </span>
              </button>
              <input type="text" class="form-control" name="artifact-editor-templocation" id="artifact-editor-templocation" 
                aria-describedby="artifact-editor-templocation-label" value="{{$modDecompressLoc}}" readonly>
            </div>
            <div class="container text-begin mb-3">
              <div class="form-text" id="artifact-editor-comp-feedback"></div>
              <hr class="m-0 mb-3 mt-3">
              {{$modDecompress}}
            </div>
            {{- end}}
          </div>
          <div class="col-xl-6 pb-3 bg-light">
            {{- /*  Image assets  */}}
            <h4 class="mt-1">Image assets</h4>
            <div id="artifact-editor-image-assets-feedback"></div>
            {{- /*  Upload a new image  */}}
            <form id="artifact-editor-preview-form"
              class="bg-white border rounded p-3 mb-2"
              hx-encoding="multipart/form-data"
              hx-post="/editor/upload/preview"
              hx-target="#artifact-editor-image-assets-feedback"
              {{- if eq $previewImgStat true}} hx-confirm="OK, to replace the existing preview image on the server?"{{end}}
              hx-validate="true">
              <div class="d-flex justify-content-between align-items-center mb-1">
                {{- if eq false $previewImgStat}}
                <label for="artifact-editor-replace-preview" class="form-label fw-semibold mb-0 text-success-emphasis">Upload a new image or picture</label>
                {{- else}}
                <label for="artifact-editor-replace-preview" class="form-label fw-semibold mb-0">Replacement image</label>
                {{- end}}
                <small class="text-secondary">alt+shift i</small>
              </div>
              <input type="hidden" name="artifact-editor-record-key" value="{{$key}}">
              <input type="hidden" name="artifact-editor-unid" value="{{$unid}}">
              <input type="hidden" name="artifact-editor-download-classify" value="{{$os}}">
              {{/*  artifact-editor-unique-id-value  */}}
              <div class="input-group input-group-sm mb-1">
                <input type="file" name="artifact-editor-replace-preview"
                  class="form-control w-50" id="artifact-editor-replace-preview"
                  aria-describedby="artifact-editor-image-assets-feedback" required>
                <button class="btn {{if eq false $previewImgStat}}btn-outline-success{{else}}btn-outline-primary{{end}} w-25" id="artifact-editor-preview-submit">Upload</button>
                <button class="btn btn-outline-secondary" id="artifact-editor-preview-reset">Clear</button>
              </div>
              <div class="form-text" id="basic-addon4">Select an image, text or ansi file to use as the image and thumbnail.</div>
              <progress class="w-100" id="artifact-editor-preview-progress" value="0" max="100"></progress>
            </form>
            <div class="p-2 rounded border border-danger-subtle bg-white mb-2">
              <div class="d-flex flex-wrap align-items-center gap-2">
                {{- /* Delete images button */}}
                <button type="button" class="btn btn-sm btn-outline-danger"
                  hx-target="#artifact-editor-image-assets-feedback"
                  hx-patch="/editor/images/remove/{{$unid}}"
                  hx-confirm="Delete all preview and thumbnail images? This is irreversible.">Delete / Redo thumbs and images</button>
                {{- /* Pixelate NSFW images button */}}
                <button type="button" class="btn btn-sm btn-outline-danger" id="artifact-editor-image-pixelate"
                  hx-target="#artifact-editor-image-assets-feedback"
                  hx-patch="/editor/images/pixelate/{{$unid}}"
                  hx-confirm="Pixelate preview and thumbnail images? This is irreversible.">Pixelate NSFW images</button>
              </div>
              <div class="form-text mt-1 mb-0">The delete and pixelate options are <u>irreversible</u>.</div>
            </div>
            <div class="d-flex flex-column gap-2">
              <div class="card overflow-hidden">
                <div class="row g-0">
                  <div class="col-sm-4 bg-dark d-flex align-items-center justify-content-center text-center text-light asset-sample-stage">
                    {{$previewImg}}
                  </div>
                  <div class="col-sm-8">
                    <div class="card-body d-flex flex-column h-100 py-2 px-3">
                      {{- /*  Preview assets  */}}
                      <p class="lead mb-0">Preview assets</p>
                      <div class="form-text mt-0">Displayed when viewing the artifact page</div>
                      {{- if eq $textFile true}}
                      <div class="form-text text-warning-emphasis">This textfile preview image will be erased on the next startup</div>
                      {{- end}}
                      <table class="table table-sm table-hover my-2">
                        <tbody>
                          {{- with .modAssetPreview }}{{- if . }}
                          {{- range $name, $info := . }}
                          {{- $imagesize := index $info 0}}
                          {{- if ne $imagesize "0"}}
                          <tr>
                            <th scope="row">{{$name}}</th>
                            <td>{{$imagesize}}B</td>
                            {{- $ext := printf ".%s" $name}}
                            <td><a href="{{recordPreviewSrc $unid $ext}}">{{index $info 1}}</a></td>
                          </tr>{{- end}}{{- end}}{{- end}}{{- end}}
                        </tbody>
                      </table>
                      <div class="mt-auto d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                          <span class="small text-secondary" style="min-width: 3.25rem;">Crop</span>
                          <div class="btn-group btn-group-sm" role="group" aria-label="Crop preview ratio">
                            <button type="button" class="btn btn-outline-secondary"
                              data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Square 1:1, from top"
                              hx-target="#artifact-editor-image-assets-feedback"
                              hx-patch="/editor/preview/crop11/{{$unid}}">1:1</button>
                            <button type="button" class="btn btn-outline-secondary"
                              data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Landscape 4:3, from top"
                              hx-target="#artifact-editor-image-assets-feedback"
                              hx-patch="/editor/preview/crop43/{{$unid}}">4:3</button>
                            <button type="button" class="btn btn-outline-secondary"
                              data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Portrait 1:2, from top"
                              hx-target="#artifact-editor-image-assets-feedback"
                              hx-patch="/editor/preview/crop12/{{$unid}}">1:2</button>
                          </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                          id="artifact-editor-imagepreview-delete"
                          hx-target="#artifact-editor-image-assets-feedback"
                          hx-patch="/editor/preview/remove/{{$unid}}">Delete</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="card overflow-hidden">
                <div class="row g-0">
                  <div class="col-sm-4 bg-dark d-flex align-items-center justify-content-center text-center text-light asset-sample-stage">
                    {{$thumbImg}}
                  </div>
                  <div class="col-sm-8">
                    <div class="card-body d-flex flex-column h-100 py-2 px-3">
                      {{- /*  Thumbnail assets  */}}
                      <p class="lead mb-0">Thumbnail assets</p>
                      <div class="form-text mt-0">Displayed when listing multiple artifacts</div>
                      <table class="table table-sm table-hover my-2">
                        <tbody>
                          {{- with .modAssetThumbnail }}{{- if . }}
                          {{- range $name, $info := .}}
                          {{- $imagesize := index $info 0}}
                          {{- if ne $imagesize "0"}}
                          <tr>
                            <th scope="row">{{$name}}</th>
                            <td>{{$imagesize}}B</td>
                            {{- $ext := printf ".%s" $name}}
                            <td><a href="{{recordThumbnailSrc $unid $ext}}">{{index $info 1}}</a></td>
                          </tr>{{- end}}{{- end}}{{- end}}{{- end}}
                        </tbody>
                      </table>
                      <div class="mt-auto d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-2">
                          <span class="small text-secondary" style="min-width: 3.25rem;">Align</span>
                          <div class="btn-group btn-group-sm" role="group" aria-label="Thumbnail crop alignment">
                            <button type="button" class="btn btn-outline-secondary"
                              hx-target="#artifact-editor-image-assets-feedback"
                              hx-patch="/editor/thumbnail/top/{{$unid}}">Top</button>
                            <button type="button" class="btn btn-outline-secondary"
                              hx-target="#artifact-editor-image-assets-feedback"
                              hx-patch="/editor/thumbnail/middle/{{$unid}}">Middle</button>
                            <button type="button" class="btn btn-outline-secondary"
                              hx-target="#artifact-editor-image-assets-feedback"
                              hx-patch="/editor/thumbnail/bottom/{{$unid}}">Bottom</button>
                            <button type="button" class="btn btn-outline-secondary"
                              hx-target="#artifact-editor-image-assets-feedback"
                              hx-patch="/editor/thumbnail/left/{{$unid}}">Left</button>
                            <button type="button" class="btn btn-outline-secondary"
                              hx-target="#artifact-editor-image-assets-feedback"
                              hx-patch="/editor/thumbnail/right/{{$unid}}">Right</button>
                          </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                          <div class="d-flex align-items-center gap-2">
                            <span class="small text-secondary" style="min-width: 3.25rem;">Quality</span>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Thumbnail quality">
                              <button type="button" class="btn btn-outline-success"
                                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Lossless WebP for pixel art &amp; text"
                                hx-target="#artifact-editor-image-assets-feedback"
                                hx-patch="/editor/thumbnail/pixel/{{$unid}}">Pixel</button>
                              <button type="button" class="btn btn-outline-secondary"
                                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Lossy WebP for photos &amp; gradients"
                                hx-target="#artifact-editor-image-assets-feedback"
                                hx-patch="/editor/thumbnail/photo/{{$unid}}">Photo</button>
                            </div>
                          </div>
                          <button type="button" class="btn btn-sm btn-outline-danger"
                            id="artifact-editor-imagethumb-delete"
                            hx-target="#artifact-editor-image-assets-feedback"
                            hx-patch="/editor/thumbnail/remove/{{$unid}}">Delete</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {{- /*  Extras assets  */}}
            <h4 class="mt-3">Extras assets</h4>
            <div class="row row-cols-2 g-1">
              {{/*  Never display README  */}}
              <div class="col-12">
                <div class="card" style="border-left: 4px solid var(--bs-warning) !important;">
                  <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between gap-3">
                    <div>
                      <label class="form-check-label fw-semibold" for="readme-is-off">
                        Never display text files
                      </label>
                      <span class="ms-2" id="readme-is-off-result"></span>
                      <div class="form-text mt-0">Hides README, FILE_ID.DIZ, and HELPER files on the artifact page.</div>
                    </div>
                    <div class="form-check form-switch fs-5 mb-0 flex-shrink-0">
                      <input class="form-check-input" type="checkbox" role="switch"
                          hx-patch="/editor/readme/disable/{{$key}}"
                          hx-trigger="click delay:50ms"
                          hx-swap="swap:50ms"
                          hx-on:click="document.getElementById('readme-is-off-result').textContent=''"
                          hx-include="[name='readme-is-off']"
                          hx-target="#readme-is-off-result"
                          name="readme-is-off"
                          id="readme-is-off"{{if eq true $noReadme}} checked{{end}}>
                    </div>
                  </div>
                </div>
              </div>
              {{- /*  List of files  */}}
              <div class="col-12">
                <div class="card">
                  <div class="card-body">
                    <div class="card-text">
                      <p class="lead mb-2">Files</p>
                      {{- if eq (len .modAssetExtra) 0}}
                      <div class="text-body-secondary small">No extras in use</div>
                      {{- else}}
                      <table class="table table-sm table-hover align-middle mb-0">
                        <tbody>
                          {{- range $name, $info := .modAssetExtra}}
                          {{- $deletePath := ""}}
                          {{- if eq $name "FILE_ID"}}{{- $deletePath = printf "/editor/diz/%s" $unid}}
                          {{- else if eq $name "HELPER"}}{{- $deletePath = printf "/editor/helper/%s" $unid}}
                          {{- else if eq $name "README"}}{{- $deletePath = printf "/editor/readme/%s" $unid}}
                          {{- else if eq $name "Repacked ZIP"}}{{- $deletePath = printf "/editor/zippack/%s" $unid}}{{end}}
                          <tr>
                            <th scope="row">{{$name}}</th>
                            <td>{{index $info 0}}B</td>
                            <td>{{index $info 1}}</td>
                            <td class="text-end">
                              {{- if ne $deletePath ""}}
                              <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2"
                                hx-target="#editor-copy-readme-result"
                                hx-delete="{{$deletePath}}">Delete</button>
                              {{- end}}
                            </td>
                          </tr>
                          {{- end}}
                        </tbody>
                      </table>
                      {{- end}}
                    </div>
                  </div>
                </div>
              </div>
              {{- /*  Readme UI  */}}
              {{- /*  Be careful about the dynamic HTML elements here,
                      as they can break the modal rendering, disabling all the Editor UI!  */ -}}
              <div class="col-12">
                <div class="card">
                  <div class="card-body">
                    <div class="card-text">
                      <p class="lead mb-2">Extras and caching</p>
                      <div class="form-text mb-2" id="editor-copy-readme-result"></div>
                      <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger"
                          hx-target="#editor-copy-readme-result"
                          hx-delete="/editor/content-cache/{{$unid}}">Clear download content cache</button>
                        {{- if ne "" $modReadmeSuggest}}
                        <button type="button" class="btn btn-sm btn-outline-success"
                          hx-target="#editor-copy-readme-result"
                          hx-patch="/editor/readme/copy/{{$unid}}/{{$modReadmeSuggest | urlEncode }}">Use guessed README: {{$modReadmeSuggest}}</button>
                        {{- end}}
                      </div>
                      <div class="form-text mt-2 mb-0">
                        After deletion, text files may automatically reappear. Use <em>Never display text files</em> above to keep them hidden.
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {{- /*  Switch to assets and reset buttons  */}}
