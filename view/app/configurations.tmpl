{{- /*
    configurations.tmpl ~ Configurations page template.
*/ -}}
{{- define "content" }}
{{- $checkDownloads := index . "checkDownloads"}}
{{- $checkPreviews := index . "checkPreviews"}}
{{- $checkThumbnails := index . "checkThumbnails"}}
{{- $checkExtras := index . "checkExtras"}}
{{- $checkOrphaned := index . "checkOrphaned"}}
{{- $extsDownloads := index . "extsDownloads"}}
{{- $extsPreviews := index . "extsPreviews"}}
{{- $extsThumbnails := index . "extsThumbnails"}}
{{- $extsExtras := index . "extsExtras"}}
{{- $extsOrphaned := index . "extsOrphaned"}}
{{- $formats := "badge text-bg-secondary bg-opacity-25 text-body fw-normal"}}
{{- /*  Database  */}}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-5 mb-3">
  <div>
    <h2 class="lead mb-0">Database</h2>
    <div class="small text-body-secondary">
      PostgreSQL live counts, active sessions, storage footprint, and index usage.
    </div>
  </div>
  <button type="button" class="btn btn-sm btn-outline-secondary"
          hx-get="/editor/configurations/dbindexes"
          hx-target="#dbindexes-response"
          hx-indicator="#dbindexes-htmx-indicator">
    Refresh
    <span id="dbindexes-htmx-indicator" class="htmx-indicator spinner-border spinner-border-sm ms-1" role="status"></span>
  </button>
</div>
<div id="dbindexes-response">
  {{- template "dbindexes" . }}
</div>
{{- with index . "uuidVersions"}}
<div class="small text-body-secondary mt-2 px-1">
  UUID versions: <span class="font-monospace">{{.}}</span>
</div>
{{- end}}
{{- /*  Ping internal URIs  */}}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-5 mb-2">
  <h2 class="lead mb-0">Routes</h2>
  <button type="button" class="btn btn-sm btn-outline-secondary"
          hx-get="/editor/configurations/pings"
          hx-target="#ping-response"
          hx-swap="beforeend"
          hx-disable="this"
          hx-config="timeout:0"
          hx-indicator="#ping-htmx-indicator"
          hx-on:click="document.getElementById('ping-response').innerHTML=''">
    Ping routes
    <span id="ping-htmx-indicator" class="htmx-indicator spinner-border spinner-border-sm ms-1" role="status"></span>
  </button>
</div>
<div class="pb-3 small text-body-secondary">
  Fetches local URLs to verify they respond with <span class="text-success">200</span> OK
  (or <span class="text-warning-emphasis">403</span> Forbidden for signed-in routes).
</div>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2 p-2" id="ping-response">
  <!-- ping response will be rendered here -->
</div>
{{- /*  Asset counts  */}}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-5 mb-3">
  <div>
    <h2 class="lead mb-0">Web application assets</h2>
    <div class="small text-body-secondary">
      Served downloads, previews, thumbnails, extras, and host storage / memory telemetry.
    </div>
  </div>
</div>

<div class="row row-cols-2 row-cols-lg-4 g-2 mb-3">
  <div class="col">
    <div class="bg-body-tertiary border rounded p-3 h-100">
      <div class="text-body-secondary text-uppercase small fw-medium mb-1">Store disk free</div>
      <div class="fs-4 fw-semibold lh-1 mb-1">{{index . "osFree"}}</div>
      <div class="small text-body-secondary">{{index . "osPercent"}} of {{index . "osTotal"}}</div>
    </div>
  </div>
  <div class="col">
    <div class="bg-body-tertiary border rounded p-3 h-100">
      <div class="text-body-secondary text-uppercase small fw-medium mb-1">System disk free</div>
      <div class="fs-4 fw-semibold lh-1 mb-1">{{index . "wdFree"}}</div>
      <div class="small text-body-secondary">{{index . "wdPercent"}} of {{index . "wdTotal"}}</div>
    </div>
  </div>
  <div class="col">
    <div class="bg-body-tertiary border rounded p-3 h-100">
      <div class="text-body-secondary text-uppercase small fw-medium mb-1">Memory free</div>
      <div class="fs-4 fw-semibold lh-1 mb-1">{{index . "memFree"}}</div>
      <div class="small text-body-secondary">{{index . "memPercent"}} of {{index . "memTotal"}}</div>
    </div>
  </div>
  <div class="col">
    <div class="bg-body-tertiary border rounded p-3 h-100">
      <div class="text-body-secondary text-uppercase small fw-medium mb-1">App memory</div>
      <div class="fs-4 fw-semibold lh-1 mb-1">{{index . "metric1"}} MB</div>
      <div class="small text-body-secondary">Heap {{index . "metric0"}} MB</div>
    </div>
  </div>
</div>

<div class="card bg-body-tertiary border mb-4">
  <div class="card-header bg-transparent d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 px-3">
    <span class="small fw-medium">Asset directories</span>
    <span class="small text-body-secondary">Newer media formats (e.g. WebP) are skipped when larger than the original</span>
  </div>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead>
        <tr class="small text-body-secondary">
          <th scope="col" class="fw-medium ps-3">Asset type</th>
          <th scope="col" class="fw-medium text-end">Disk usage</th>
          <th scope="col" class="fw-medium text-end">Files</th>
          <th scope="col" class="fw-medium ps-3 pe-3">Formats</th>
        </tr>
      </thead>
      <tbody class="table-group-divider">
        <tr>
          <th scope="row" class="fw-medium ps-3 py-2 text-nowrap">Downloads</th>
          <td class="text-end text-nowrap small font-monospace">{{index . "usageDownloads"}}</td>
          <td class="text-end text-nowrap small">{{index . "countDownloads"}}</td>
          <td class="ps-3 pe-3 py-2">
            {{- if ne $checkDownloads nil}}
            <span class="badge text-bg-danger fw-normal">{{$checkDownloads}}</span>
            {{- else}}
            <div class="d-flex flex-wrap gap-1">
              {{- range $index, $value := $extsDownloads}}
              <span class="{{$formats}}"><span class="font-monospace text-uppercase">{{$value.Name}}</span> <span class="text-body-secondary ms-1">{{$value.Count}}</span></span>
              {{- end}}
            </div>
            {{- end}}
          </td>
        </tr>
        <tr>
          <th scope="row" class="fw-medium ps-3 py-2 text-nowrap">Previews</th>
          <td class="text-end text-nowrap small font-monospace">{{index . "usagePreviews"}}</td>
          <td class="text-end text-nowrap small">{{index . "countPreviews"}}</td>
          <td class="ps-3 pe-3 py-2">
            {{- if ne $checkPreviews nil}}
            <span class="badge text-bg-danger fw-normal">{{$checkPreviews}}</span>
            {{- else}}
            <div class="d-flex flex-wrap gap-1">
              {{- range $index, $value := $extsPreviews}}
              <span class="{{$formats}}"><span class="font-monospace text-uppercase">{{$value.Name}}</span> <span class="text-body-secondary ms-1">{{$value.Count}}</span></span>
              {{- end}}
            </div>
            {{- end}}
          </td>
        </tr>
        <tr>
          <th scope="row" class="fw-medium ps-3 py-2 text-nowrap">Thumbnails</th>
          <td class="text-end text-nowrap small font-monospace">{{index . "usageThumbnails"}}</td>
          <td class="text-end text-nowrap small">{{index . "countThumbnails"}}</td>
          <td class="ps-3 pe-3 py-2">
            {{- if ne $checkThumbnails nil}}
            <span class="badge text-bg-danger fw-normal">{{$checkThumbnails}}</span>
            {{- else}}
            <div class="d-flex flex-wrap gap-1">
              {{- range $index, $value := $extsThumbnails}}
              <span class="{{$formats}}"><span class="font-monospace text-uppercase">{{$value.Name}}</span> <span class="text-body-secondary ms-1">{{$value.Count}}</span></span>
              {{- end}}
            </div>
            {{- end}}
          </td>
        </tr>
        <tr>
          <th scope="row" class="fw-medium ps-3 py-2 text-nowrap">Extras</th>
          <td class="text-end text-nowrap small font-monospace">{{index . "usageExtras"}}</td>
          <td class="text-end text-nowrap small">{{index . "countExtras"}}</td>
          <td class="ps-3 pe-3 py-2">
            {{- if ne $checkExtras nil}}
            <span class="badge text-bg-danger fw-normal">{{$checkExtras}}</span>
            {{- else}}
            <div class="d-flex flex-wrap gap-1">
              {{- range $index, $value := $extsExtras}}
              <span class="{{$formats}}"><span class="font-monospace text-uppercase">{{$value.Name}}</span> <span class="text-body-secondary ms-1">{{$value.Count}}</span></span>
              {{- end}}
            </div>
            {{- end}}
          </td>
        </tr>
        <tr>
          <th scope="row" class="fw-medium ps-3 py-2 text-nowrap">Orphans</th>
          <td class="text-end text-nowrap small font-monospace">{{index . "usageOrphaned"}}</td>
          <td class="text-end text-nowrap small">{{index . "countOrphaned"}}</td>
          <td class="ps-3 pe-3 py-2">
            {{- if ne $checkOrphaned nil}}
            <span class="badge text-bg-danger fw-normal">{{$checkOrphaned}}</span>
            {{- else}}
            <div class="d-flex flex-wrap gap-1">
              {{- range $index, $value := $extsOrphaned}}
              <span class="{{$formats}}"><span class="font-monospace text-uppercase">{{$value.Name}}</span> <span class="text-body-secondary ms-1">{{$value.Count}}</span></span>
              {{- end}}
            </div>
            {{- end}}
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="card-footer bg-transparent d-flex flex-wrap justify-content-between gap-2 py-2 px-3 small text-body-secondary">
    <span>
      Tmp disk: <strong class="text-body">{{index . "tmpFree"}}</strong> free ({{index . "tmpPercent"}}) of <strong class="text-body">{{index . "tmpTotal"}}</strong>
    </span>
    <span>
      Swap: <strong class="text-body">{{index . "swapFree"}}</strong> free ({{index . "swapPercent"}}) of <strong class="text-body">{{index . "swapTotal"}}</strong>
    </span>
  </div>
</div>
{{- /*  Links to records  */}}
{{- $confirmed := `<span class="badge bg-success-subtle text-success-emphasis fw-normal" title="Confirmed">&#10003;</span>` | safeHTML }}
{{- $fixing := `<span class="badge bg-danger-subtle text-danger-emphasis fw-normal" title="Needs fixing">&#10005;</span>` | safeHTML }}
{{- $fid := `text-uppercase link-underline link-underline-opacity-0 link-underline-opacity-75-hover` }}
{{- $fitem := `list-group-item bg-transparent py-2 px-3` }}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-5 mb-3">
  <div>
    <h2 class="lead mb-0">Links to special records</h2>
    <div class="small text-body-secondary">
      Reference artifacts covering edge cases, bespoke formats, encodings, and emulation quirks.
    </div>
  </div>
  <div class="d-flex align-items-center gap-2 small">
    <span class="badge bg-success-subtle text-success-emphasis fw-normal">&#10003; confirmed</span>
    <span class="badge bg-danger-subtle text-danger-emphasis fw-normal">&#10005; needs fixing</span>
  </div>
</div>

<div class="row row-cols-1 row-cols-lg-2 g-3 mb-4">
  {{- /* Capacity & edge cases */}}
  <div class="col">
    <div class="card h-100 bg-body-tertiary border">
      <div class="card-header bg-transparent py-2 px-3 small fw-medium">Capacity &amp; edge cases</div>
      <ul class="list-group list-group-flush">
        <li class="{{$fitem}}">
          <div class="fw-medium small">Download that is too large</div>
          <div class="small text-body-secondary mb-1">Cloudflare limits the download size to 1 GB</div>
          <div class="small"><a href="/f/aa256f1" class="{{$fid}}">aa256f1</a></div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Archive with too many files</div>
          <div class="small text-body-secondary mb-1">Large archives containing thousands of files</div>
          <div class="small">
            <a href="/f/b31d5d7" class="{{$fid}}">b31d5d7</a>
            <span class="text-body-secondary">(132 MB, contains 72,917 files)</span>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Readme that is extra long</div>
          <div class="small text-body-secondary mb-1">Files that can overload the browser DOM</div>
          <div class="small">
            <a href="/f/ae219e8" class="{{$fid}}">ae219e8</a>
            <span class="text-body-secondary">(129,178 lines, 5 MB)</span>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Magic number false positives</div>
          <div class="small text-body-secondary mb-1">Files that caused magic number false positives</div>
          <div class="small">
            <a href="/f/b523780" class="{{$fid}}">1</a> ·
            <a href="/f/b425062" class="{{$fid}}">2</a>
            <span class="text-body-secondary">ANSI != plaintext</span>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Artifacts with <q>link to</q></div>
          <div class="small text-body-secondary mb-1">Records with linking relationships</div>
          <div class="small">
            <a href="/f/b029330" class="{{$fid}}">b029330</a> ·
            <a href="/f/ab27f81" class="{{$fid}}">ab27f81</a> ·
            <a href="/f/ba4805" class="{{$fid}}">ba4805</a>
          </div>
        </li>
      </ul>
    </div>
  </div>

  {{- /* ANSI & binary text art */}}
  <div class="col">
    <div class="card h-100 bg-body-tertiary border">
      <div class="card-header bg-transparent py-2 px-3 small fw-medium">ANSI &amp; binary text art</div>
      <ul class="list-group list-group-flush">
        <li class="{{$fitem}}">
          <div class="fw-medium small">ANSImation</div>
          <div class="small text-body-secondary mb-1">ANSI streams with animations</div>
          <div class="small">
            <a href="/f/ba2ff05" class="{{$fid}}">ba2ff05</a> ·
            <a href="/f/b53028e" class="{{$fid}}">b53028e</a> ·
            <a href="/f/a819aae" class="{{$fid}}">a819aae</a> ·
            <a href="/f/b923cc5" class="{{$fid}}">b923cc5</a> ·
            <a href="/f/ac2c5c0" class="{{$fid}}">ac2c5c0</a> <span class="text-body-secondary">Breakout</span>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">ANSImation with blink</div>
          <div class="small text-body-secondary mb-1">ANSI streams with animations and blinking text</div>
          <div class="small">
            <a href="/f/af23902" class="{{$fid}}">af23902</a> <span class="text-body-secondary">Demon's Forge, 1989</span> ·
            <a href="/f/b31cbfd" class="{{$fid}}">b31cbfd</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">ANSI with blink</div>
          <div class="small text-body-secondary mb-1">ANSI art with blinking text</div>
          <div class="small">
            <a href="/f/a83199" class="{{$fid}}">a83199</a> ·
            <a href="/f/ba2bcbb" class="{{$fid}}">ba2bcbb</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Other color texts</div>
          <div class="small text-body-secondary mb-1">Other color text used by BBSes, exported as PNG and WebP images</div>
          <div class="small">
            <a href="/f/b02ecf1" class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover">Amiga ANSI</a> ·
            <a href="/f/b92e111" class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover">@PCB</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">SAUCE BIN</div>
          <div class="small text-body-secondary mb-1">Binary texts with SAUCE metadata that use custom rendering</div>
          <div class="small">
            <a href="/f/ab194e9" class="{{$fid}}">1</a> ·
            <a href="/f/ae1c14d" class="{{$fid}}">2</a> ·
            <a href="/f/b027559" class="{{$fid}}">3</a> ·
            <a href="/f/b01d34f" class="{{$fid}}">4</a> ·
            <a href="/f/b3220cb" class="{{$fid}}">5</a> ·
            <a href="/f/ab1b63f" class="{{$fid}}">6</a> ·
            <a href="/f/aa1ed87" class="{{$fid}}">7</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">eXtended BIN</div>
          <div class="small text-body-secondary mb-1">XBIN files are not fully supported due to their custom fonts</div>
          <div class="small">
            <a href="/f/b23006f" class="{{$fid}}">1</a> ·
            <a href="/f/b12db5f" class="{{$fid}}">2</a> ·
            <a href="/f/ab1ccc7" class="{{$fid}}">3</a> ·
            <a href="/f/ab1f1ff" class="{{$fid}}">4</a> ·
            <a href="/f/b02b24f" class="{{$fid}}">5</a> ·
            <a href="/f/ab229bf" class="{{$fid}}">6</a> <span class="text-body-secondary">ICEdraw</span>
          </div>
        </li>
      </ul>
    </div>
  </div>

  {{- /* Text files & readmes */}}
  <div class="col">
    <div class="card h-100 bg-body-tertiary border">
      <div class="card-header bg-transparent py-2 px-3 small fw-medium">Text files &amp; readmes</div>
      <ul class="list-group list-group-flush">
        <li class="{{$fitem}}">
          <div class="fw-medium small d-flex align-items-center gap-2">Unknown or corrupt encoding {{$confirmed}}</div>
          <div class="small text-body-secondary mb-1">Corrupt text files caused by saving to the wrong encoding</div>
          <div class="small">
            <a href="/f/ac2319e" class="{{$fid}}">ac2319e</a> ·
            <a href="/f/b0269ca" class="{{$fid}}">b0269ca</a> <span class="text-body-secondary">vs</span>
            <a href="/f/ac1d9d3" class="{{$fid}}">ac1d9d3</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Broken newlines</div>
          <div class="small text-body-secondary mb-1">Text files with corrupted newline characters due to advertising injection</div>
          <div class="small">
            <a href="/f/b224d50" class="{{$fid}}">b224d50</a> ·
            <a href="/f/ae1c03c" class="{{$fid}}">ae1c03c</a> <span class="text-body-secondary">(includes EOF marker)</span>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">CD keys and serials</div>
          <div class="small text-body-secondary mb-1">Readme files with serials and CD keys that should be masked</div>
          <div class="small">
            <a href="/f/b91f23c" class="{{$fid}}">1</a> ·
            <a href="/f/c0304ac" class="{{$fid}}">2</a> ·
            <a href="/f/ad20232" class="{{$fid}}">3</a> ·
            <a href="/f/b023312" class="{{$fid}}">4</a> ·
            <a href="/f/af37fc" class="{{$fid}}">5</a> ·
            <a href="/f/bd2b294" class="{{$fid}}">6</a> ·
            <a href="/f/ba2609c" class="{{$fid}}">7</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Readme requires wrapping</div>
          <div class="small text-body-secondary mb-1">Text that needs line wrapping</div>
          <div class="small">
            <a href="/f/b14bb1" class="{{$fid}}">b14bb1</a> ·
            <a href="/f/b12fe37" class="{{$fid}}">b12fe37</a> ·
            <a href="/f/b61f24f" class="{{$fid}}">b61f24f</a> ·
            <a href="/f/b122787" class="{{$fid}}">b122787</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Readme requires trimming</div>
          <div class="small text-body-secondary mb-1">Extraneous whitespace or content</div>
          <div class="small"><a href="/f/b830654" class="{{$fid}}">b830654</a></div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Block art</div>
          <div class="small text-body-secondary mb-1">CP437 "ASCII" art or visual content</div>
          <div class="small">
            <a href="/f/ad217af" class="{{$fid}}">ad217af</a> ·
            <a href="/f/ae2a9cc" class="{{$fid}}">ae2a9cc</a> ·
            <a href="/f/ad2b193" class="{{$fid}}">ad2b193</a> ·
            <a href="/f/ac1a2dc" class="{{$fid}}">ac1a2dc</a>
          </div>
        </li>
      </ul>
    </div>
  </div>

  {{- /* Images & documents */}}
  <div class="col">
    <div class="card h-100 bg-body-tertiary border">
      <div class="card-header bg-transparent py-2 px-3 small fw-medium">Images &amp; documents</div>
      <ul class="list-group list-group-flush">
        <li class="{{$fitem}}">
          <div class="fw-medium small">Images <code>.IFF</code></div>
          <div class="small text-body-secondary mb-1">Amiga-standard <q>Interchange File Format</q> images first introduced in 1988</div>
          <div class="small">
            <a href="/f/b32e8a7" class="{{$fid}}">SDC 1992</a> ·
            <a href="/f/a71fd00" class="{{$fid}}">PD 1992</a> ·
            <a href="/f/b522116" class="{{$fid}}">1994</a> ·
            <a href="/f/ac2739d" class="{{$fid}}">1997</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Images <code>.GIF</code></div>
          <div class="small text-body-secondary mb-1"><q>Graphics Interchange Format</q> images first introduced in 1987</div>
          <div class="small">
            <span class="text-body-secondary">1989</span>
            <a href="/f/b0290da" class="{{$fid}}">PTL</a> ·
            <a href="/f/ad1f972" class="{{$fid}}">PTL</a> ·
            <a href="/f/ac3efa" class="{{$fid}}">ESI</a> ·
            <a href="/f/ae267d2" class="{{$fid}}">MCM</a> ·
            <a href="/f/b621fce" class="{{$fid}}">INC</a> ·
            <span class="text-body-secondary">1988</span>
            <a href="/f/b1438f" class="{{$fid}}">PTL</a>
          </div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Images <code>.RIP</code></div>
          <div class="small text-body-secondary mb-1"><q>Remote Imaging Protocol</q> images first introduced in 1992</div>
          <div class="small"><a href="/f/b02392f" class="{{$fid}}">b02392f</a></div>
        </li>
        <li class="{{$fitem}}">
          <div class="fw-medium small">Other images</div>
          <div class="small text-body-secondary mb-1">Exotic image formats common in the early 1990s</div>
          <div class="small">
