<script>
(() => {
  const input = document.getElementById('category-filter');
  const clearBtn = document.getElementById('category-filter-clear');
  const emptyReset = document.getElementById('category-empty-reset');
  const emptyState = document.getElementById('category-empty');
  if (!input) return;

  const cards = Array.from(document.querySelectorAll('[data-category-card]'));
  const sections = Array.from(document.querySelectorAll('[data-category-section]'));

  const platformTabs = [
    { id: 'dos-tab', match: ['dos', 'msdos', 'ms-dos', 'pc-dos', 'ibm'] },
    { id: 'windows-tab', match: ['win', 'windows'] },
    { id: 'console-tab', match: ['console', 'video game', 'snes', 'genesis', 'playstation'] },
    { id: 'mac-tab', match: ['mac', 'macos', 'os x', 'osx', 'apple'] },
    { id: 'linux-tab', match: ['linux', 'unix'] },
    { id: 'script-tab', match: ['script', 'shell', 'php', 'perl', 'python', 'ruby'] },
    { id: 'java-tab', match: ['java'] },
  ];

  function update() {
    const q = input.value.trim().toLowerCase();
    clearBtn.classList.toggle('d-none', q === '');

    let visible = 0;
    cards.forEach((card) => {
      const text = (card.textContent + ' ' + (card.dataset.keywords || '')).toLowerCase();
      const match = q === '' || text.includes(q);
      card.classList.toggle('d-none', !match);
      if (match) visible++;
    });

    sections.forEach((sec) => {
      const hasVisible = sec.querySelector('[data-category-card]:not(.d-none)') !== null;
      sec.classList.toggle('d-none', !hasVisible);
    });

    if (q !== '' && typeof bootstrap !== 'undefined') {
      const tabMatch = platformTabs.find((t) => t.match.some((k) => k.includes(q) || q.includes(k)));
      if (tabMatch) {
        const btn = document.getElementById(tabMatch.id);
        if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
      }
    }

    emptyState.classList.toggle('d-none', visible > 0);
  }

  function reset() {
    input.value = '';
    update();
    input.focus();
  }

  input.addEventListener('input', update);
  clearBtn.addEventListener('click', reset);
  if (emptyReset) emptyReset.addEventListener('click', reset);
  update();
})();
</script>
{{- end }}
</div>
{{- end}}
