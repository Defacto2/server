{{- /* 
    artifactfooter.tmpl ~ Footer buttons to switch between the various artifact editor modals.
*/ -}}
{{- define "artifactfooter" }}
{{- $download := index . "download"}}
<div class="modal-footer bg-body-tertiary flex-column align-items-stretch gap-2 py-2 px-3">
    <div class="artifact-editor-alert d-none alert alert-warning w-100 mb-0" role="alert">
        <div class="d-none">This is a placeholder <strong>alert text</strong>!</div>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="alt + shift + del">
            <button type="button" data-bs-toggle="modal" data-bs-target="#artifact-delete-forever-modal"
                class="btn btn-sm btn-outline-danger">Delete forever</button>
        </span>
        <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
            <div class="btn-group btn-group-sm" role="group" aria-label="Switch editor">
                <button type="button" name="artifact-editor-dataeditor" data-bs-toggle="modal" data-bs-target="#artifact-editor-modal"
                    title="alt + shift + home" class="btn btn-outline-primary editor-btn">Data editor</button>
                <button type="button" name="artifact-editor-fileeditor" data-bs-toggle="modal" data-bs-target="#asset-editor-modal"
                    title="alt + shift + pgdn" class="btn btn-outline-primary editor-btn">File editor</button>
                <button type="button" name="artifact-editor-emueditor" data-bs-toggle="modal" data-bs-target="#emulate-editor-modal"
                    title="alt + shift + pgup" class="btn btn-outline-primary editor-btn">Emulate editor</button>
            </div>
            <a href="/f/{{$download}}" class="btn btn-sm btn-outline-success"
                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="alt + shift + enter">Reload &amp; view</a>
            <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="alt + shift + backspace">
                <button type="button" data-bs-dismiss="modal" class="btn btn-sm btn-secondary">Close</button>
            </span>
        </div>
    </div>
</div>
{{- end}}
