{{- /* 
    releaser.tmpl ~ List of ordered releaser names with their file counts and total sizes.
*/ -}}
{{- define "content" }}
{{- $editor := index . "editor"}}
{{- $h1 := index . "h1"}}
{{- $orderBy := index .stats.orderBy }}
{{- $name := .itemName }}
{{- $path := "g" }}
{{- $pubs := index .stats.pubs }}
<div class="container-xxl">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <p class="lead mb-0"><small>Showing {{$pubs}}{{if ne $orderBy ""}}, ordered {{$orderBy | safeHTML}}{{end}}.</small></p>
      <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
        <span class="small text-body-secondary text-nowrap" id="releaser-count">{{$pubs}}</span>
        <div class="input-group input-group-sm" style="width: 17rem; max-width: 100%;">
          <input type="search" id="releaser-filter" class="form-control" placeholder="Filter by name..." aria-label="Filter by name" autocomplete="off">
          <button type="button" id="releaser-filter-clear" class="btn btn-outline-secondary" aria-label="Clear filter" disabled>Clear</button>
        </div>
      </div>
    </div>
    <div id="releaser-empty" class="alert alert-light border text-center my-4 d-none" role="status">
      No matches for <strong id="releaser-empty-query"></strong>.
      <button type="button" id="releaser-empty-clear" class="btn btn-link btn-sm p-0 ms-1 align-baseline">Clear filter</button>
    </div>
{{- if eq $name "bbs" }}
    <details class="bg-body-tertiary border rounded px-3 py-2 mb-3 small">
      <summary class="text-body-secondary fw-medium">Historic BBS platforms (1984&ndash;1994)</summary>
      <ul class="list-unstyled mb-0 mt-2 pt-2 border-top d-flex flex-column gap-1">
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1984</span>
          <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/nochange-bbs">NoChange</a>
        </li>
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1985</span>
          <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/colossus-bbs">Colossus</a>
        </li>
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1986</span>
          <span class="d-flex flex-wrap align-items-baseline column-gap-2 row-gap-1">
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/emulex-bbs">Emulex</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/forum_pc-bbs">Forum-PC</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/genesis-pc-bbs">Genesis&nbsp;PC</a>
          </span>
        </li>
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1988</span>
          <span class="d-flex flex-wrap align-items-baseline column-gap-2 row-gap-1">
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/monarch-bbs">Monarch</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/tcs-bbs">TCS</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/telegard-bbs">Telegard</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/wwiv-bbs">WWIV</a>
          </span>
        </li>
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1990</span>
          <span class="d-flex flex-wrap align-items-baseline column-gap-2 row-gap-1">
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/acs-bbs">ACS</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/aftershock-bbs">AfterShock</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/celerity-bbs">Celerity</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/pha-elite-bbs">ELITE</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/lush-software-designs-bbs">L.S.D.</a>
          </span>
        </li>
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1991</span>
          <span class="d-flex flex-wrap align-items-baseline column-gap-2 row-gap-1">
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/extreme-bbs">Extreme</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/forum-3-bbs">Forum&nbsp;III</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/images-bbs">IMaGEs</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/orion-software-bbs">ORiON</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/vision_x-bbs">ViSiON</a>
          </span>
        </li>
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1992</span>
          <span class="d-flex flex-wrap align-items-baseline column-gap-2 row-gap-1">
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/liquid-bbs">LiQUiD</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/oblivion-2-bbs">Oblivion/2</a>
          </span>
        </li>
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1993</span>
          <span class="d-flex flex-wrap align-items-baseline column-gap-2 row-gap-1">
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/dominous-productions">Dominous</a>
            <span class="text-body-tertiary" aria-hidden="true">&middot;</span>
            <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/otera-bbs">OTERA</a>
          </span>
        </li>
        <li class="d-flex flex-wrap align-items-baseline gap-2">
          <span class="font-monospace text-body-secondary" style="min-width: 2.75rem;">1994</span>
          <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/g/evolution-software-bbs">EVOLUTiON</a>
        </li>
      </ul>
    </details>
{{- end }}
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
{{- range $rel := .releasers -}}
{{- $initialism := initialisms $rel.Unique.URI }}
{{- $mdMissing := false }}
{{- if and (ne $h1 "BBS") (ne $h1 "FTP") (eq true $editor)}}{{- $mdMissing = tidbitMissing $rel.Unique.URI }}{{end}}
        <div class="col releaser-item">
            <div class="position-relative p-3 border bg-body-tertiary h-100 rounded d-flex flex-column justify-content-between gap-2">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <h2 class="h5 mb-0">
                  <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover stretched-link" href="/{{ $path }}/{{ $rel.Unique.URI }}">{{fmtURI $rel.Unique.URI}}</a>
                </h2>
                {{- if eq $mdMissing true }}
                <small class="small fw-medium text-warning-emphasis bg-warning-subtle border border-warning-subtle rounded-pill px-2 py-0 flex-shrink-0">❌ markdown</small>
                {{- end }}
              </div>
              <div class="small text-body-secondary">
                {{- if ne $initialism "" }}<span class="fw-medium">{{ $initialism }}</span> &middot; {{end}}
                {{- byteFileS $name $rel.Unique.Count $rel.Unique.Bytes }}
              </div>
            </div>
        </div>
{{- end}}
    </div>
</div>
{{- end }}
