{{- /* 
    uploader.tmpl ~ About the uploader and keyboard shortcuts modal dialogs.
*/ -}}
{{- define "uploader" -}}
    <div class="modal fade" id="uploader-about" tabindex="-1" aria-labelledby="uploader-about-label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header bg-body-tertiary">
            <h2 class="modal-title fs-5" id="uploader-about-label">About the Uploader</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <p class="mb-3">
              Do you have Scene files that Defacto2 could host?
              Use the Uploader to submit files—a human tests and approves every upload, which may take some time.
            </p>
            <div class="bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-2 px-3 py-2 small mb-3">
              <strong>No inappropriate files or modern tools that violate the <abbr title="Digital Millennium Copyright Act">DMCA</abbr>.</strong>
            </div>
            <p class="small text-body-secondary mb-3">
              There is a 100 MB per-file upload limit. Please
              <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#contacts-email-modal">contact us</button>
              if you need access to an SFTP server to bypass this limit.
            </p>
            <a href="https://github.com/Defacto2/defacto2.net/wiki/Wanted-uploads" target="_blank" rel="noopener noreferrer" class="small fw-medium text-decoration-none">
              Check out the wanted uploads ↗
            </a>
          </div>
          <div class="modal-footer justify-content-between">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#uploader-shortcuts">Keyboard shortcuts</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="uploader-shortcuts" tabindex="-1" aria-labelledby="uploader-shortcuts-label" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header bg-body-tertiary">
            <h2 class="modal-title fs-5" id="uploader-shortcuts-label">Keyboard Shortcuts</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
              <h3 class="h6 text-uppercase text-body-secondary fw-semibold mb-0 uploader-shortcut-heading">Uploader &amp; quick jump</h3>
              <span class="small text-body-secondary">Hold <kbd class="shortcut-kbd">Ctrl</kbd> + <kbd class="shortcut-kbd">Alt</kbd> + key</span>
            </div>

            <div class="small fw-semibold text-body-secondary mb-2">Upload files &amp; productions</div>
            <div class="row row-cols-1 row-cols-md-2 g-2 mb-3">
              <div class="col">
                <div class="shortcut-row">
                  <span>Intro, cracktro or BBStro (DOS)</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">c</kbd> <kbd class="shortcut-kbd">d</kbd> <kbd class="shortcut-kbd">b</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Intro or cracktro (Windows)</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">w</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Trainer or game hack</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">t</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Installer app</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">i</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Text, ANSI, NFO or DIZ</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">n</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Photo, picture or image art</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">p</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Magazine</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">m</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Advanced uploader</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">a</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Demozoo production</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">z</kbd></span>
                </div>
              </div>
            </div>

            <div class="small fw-semibold text-body-secondary mb-2">Actions &amp; results</div>
            <div class="row row-cols-1 row-cols-md-2 g-2 mb-3">
              <div class="col">
                <div class="shortcut-row">
                  <span>Close open uploader</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">⌫ Backspace</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Open new artifact record</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">↵ Enter</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Open artifact card in new tab</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">1</kbd>–<kbd class="shortcut-kbd">9</kbd></span>
                </div>
              </div>
            </div>

            <div class="small fw-semibold text-body-secondary mb-2">Quick search</div>
            <div class="row row-cols-1 row-cols-sm-3 g-2">
              <div class="col">
                <div class="shortcut-row">
                  <span>Releasers</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">r</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Filenames</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">f</kbd></span>
                </div>
              </div>
              <div class="col">
                <div class="shortcut-row">
                  <span>Descriptions</span>
                  <span class="shortcut-keys"><kbd class="shortcut-kbd">x</kbd></span>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
{{- end -}}
