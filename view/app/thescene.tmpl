    <nav class="index-chapter-nav" aria-label="The Scene sections">
      <div class="index-eyebrow mb-2">Sections</div>
      <ul class="nav flex-column gap-1">
        <li class="nav-item"><a class="nav-link index-chapter-link" href="#origins">Origins</a></li>
        <li class="nav-item"><a class="nav-link index-chapter-link" href="#the-naughty">The naughty</a></li>
        <li class="nav-item"><a class="nav-link index-chapter-link" href="#further-reading">Further reading</a></li>
        <li class="nav-item"><a class="nav-link index-chapter-link" href="#the-creative">The creative</a></li>
        <li class="nav-item"><a class="nav-link index-chapter-link" href="#directories">Directories</a></li>
      </ul>
    </nav>
