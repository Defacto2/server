{{- /*
    website.tmpl ~ Template for displaying a website card.
*/ -}}
{{- define "website"}}
            <div class="col website-card-item" data-url="{{ .URL }}">
                <div class="card h-100 bg-body-tertiary border">
                    <div class="card-body d-flex flex-column">
                        {{- $parts := stripSup .Title }}
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h3 class="h5 card-title mb-0">{{ $parts.text }}</h3>
                            {{- with index $parts "tag" }}
                            <span class="small font-monospace bg-body border rounded px-2 py-1 lh-1 text-body-secondary flex-shrink-0">{{ . }}</span>
                            {{- end }}
                        </div>
                        {{- if ne .Info "" }}
                        <p class="card-text small text-body-secondary mb-3">{{ .Info }}</p>
                        {{- end }}
                        <div class="mt-auto pt-1">
                            <a href="{{ .URL }}" target="_blank" rel="noopener" class="icon-link icon-link-hover stretched-link small">{{websiteIcon .URL}} Visit {{ $parts.text }}</a>
                        </div>
                    </div>
                </div>
            </div>
{{- end -}}
