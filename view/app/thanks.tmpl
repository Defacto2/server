{{- /* 
    thanks.tmpl ~ Thank you page template.
*/ -}}
{{- define "content" }}
<div class="container-xxl">
  <h2 class="h3 mb-2">Support Defacto2</h2>
  <p class="text-body-secondary mb-4">
    As the Defacto2 website costs over a hundred dollars annually, all tips are greatly appreciated and go to the website's operations, no matter how large or small.
  </p>

  <section class="bg-body-tertiary border rounded p-3 p-md-4 mb-4">
    <div class="mb-3">
      <h3 class="h5 mb-1">Tip with</h3>
      <p class="small text-body-secondary mb-0">
        No signup or accounts are required, and no financial details are given to us.
      </p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
      <div class="col">
        <a href="https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&amp;hosted_button_id=PBV5H45GG5L8G" class="d-flex flex-column align-items-center justify-content-center gap-2 p-3 bg-body border rounded h-100 text-decoration-none link-body-emphasis fw-medium">
          <svg class="bi" fill="currentColor" viewBox="0 0 16 16" style="height: 1.75rem; width: auto;" aria-hidden="true">
            <use xlink:href="/svg/bootstrap-icons.svg#paypal"/>
          </svg>
          <span>PayPal<sup class="text-danger">*</sup></span>
        </a>
      </div>
      <div class="col">
        <a href="https://ko-fi.com/codebyben" class="d-flex flex-column align-items-center justify-content-center gap-2 p-3 bg-body border rounded h-100 text-decoration-none link-body-emphasis fw-medium">
          <svg class="bi" fill="currentColor" viewBox="0 0 241 194" style="height: 1.75rem; width: auto;" aria-hidden="true">
            <use xlink:href="/svg/bootstrap-icons.svg#kofi"/>
          </svg>
          <span>Ko-fi</span>
        </a>
      </div>
      <div class="col">
        <a href="https://www.buymeacoffee.com/4rtEGvUIY" class="d-flex flex-column align-items-center justify-content-center gap-2 p-3 bg-body border rounded h-100 text-decoration-none link-body-emphasis fw-medium">
          <svg class="bi" fill="currentColor" viewBox="0 0 884 1279" style="height: 1.75rem; width: auto;" aria-hidden="true">
            <use xlink:href="/svg/bootstrap-icons.svg#buymeacoffee"/>
          </svg>
          <span>Buy Me a Coffee</span>
        </a>
      </div>
      <p class="small text-body-secondary mb-0">
        <span class="text-danger">*</span> PayPal will share the name of the account holder.
      </p>
    </div>

    <div class="row g-4 mt-3 pt-3 border-top">
      <div class="col-md-6">
        <h3 class="h6 text-body-secondary text-uppercase mb-3">Merchant fees</h3>
        <ul class="list-group list-group-flush border rounded overflow-hidden small mb-2">
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <span>PayPal<sup class="text-danger">*</sup></span>
            <span class="text-body-secondary text-end">2.9% fee plus 30¢ flat fee</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <span>Ko-fi + Stripe</span>
            <span class="text-body-secondary text-end">3.5% plus 30¢ flat fee</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <span>Buy Me a Coffee + Stripe</span>
            <span class="text-body-secondary text-end">8.5% plus 30¢ flat fee</span>
          </li>
        </ul>
      </div>

      <div class="col-md-6">
        <h3 class="h6 text-body-secondary text-uppercase mb-3">Monthly costs (USD)</h3>
        <ul class="list-group list-group-flush border rounded overflow-hidden small mb-0">
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2 fw-semibold">
            <span>Monthly hosting</span>
            <span class="font-monospace">$11.83</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2 text-body-secondary">
            <span>Website hosting</span>
            <span class="font-monospace">$7.70</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2 text-body-secondary">
            <span>Online hosting of file downloads and images</span>
            <span class="font-monospace">$3.30</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2 text-body-secondary">
            <span>Domain name</span>
            <span class="font-monospace">$0.83</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-body-tertiary border rounded p-3 p-md-4">
    <h3 class="h5 mb-2">Affiliate bonus</h3>
    <p class="mb-0">
      Spend <strong>$25 or more</strong> at <a href="https://m.do.co/c/a9270bdb9e74" class="link-underline link-underline-opacity-25 link-underline-opacity-100-hover">DigitalOcean with this affiliate link</a>: you'll get <strong>$200 of bonus credit for 60 days</strong>, and Defacto2 gets a <strong>$25 hosting discount</strong>.
    </p>
  </section>
</div>
{{- end}}
