{{- /* 
    routes.tmpl ~ Listing of routes page template.
*/ -}}
{{- define "content" }}
  {{ if .routesCount }}
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div class="d-flex flex-wrap align-items-center gap-2">
      <span class="px-2 py-1 rounded bg-dark-subtle text-dark-emphasis border border-dark-subtle fw-semibold">{{ .routesCount }} routes</span>
      {{ range .routeMethods }}
      <span class="px-2 py-1 rounded small fw-semibold {{ .Badge }}">{{ .Method }} {{ .Count }}</span>
      {{ end }}
    </div>
    <div style="min-width: 16rem;">
      <label class="visually-hidden" for="routes-filter">Filter routes</label>
      <input type="search" id="routes-filter" class="form-control form-control-sm" placeholder="Filter by method or path…">
    </div>
  </div>
  <p class="small text-body-secondary mb-3">
    Static <code>GET</code> paths link directly; routes with <code>:param</code> or <code>*</code> segments require runtime parameters.
  </p>
  <div class="row row-cols-1 row-cols-lg-2 g-2" id="routes-list">
    {{ range .routesList }}
    <div class="col">
      <div class="border rounded px-2 py-1 d-flex align-items-center gap-2 h-100">
        <span class="px-2 py-0 rounded small fw-semibold text-center flex-shrink-0 {{ .Badge }}" style="min-width: 4.5rem;">{{ .Method }}</span>
        {{- if .Linkable }}
        <a href="{{ .Path }}" class="font-monospace small text-decoration-none text-break">{{ .Path }}</a>
        {{- else }}
        <code class="small text-break">{{ .Path }}</code>
        {{- end }}
      </div>
    </div>
    {{ end }}
  </div>
  {{ else }}
  <div class="alert alert-info">No routes found.</div>
  {{ end }}
{{- end}}
