        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#ansi">A</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#bbs">B</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#courier">C</a>
