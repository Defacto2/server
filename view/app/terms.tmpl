        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#ftp">F</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#hack">H</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#installer">I</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#keygen">K</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#mod">M</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#nfo">N</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#pcboard">P</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#release">R</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#the-scene">S</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#topsite">T</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#unprotect">U</a>
        <a class="btn btn-sm btn-outline-secondary font-monospace" href="#warez">W</a>
