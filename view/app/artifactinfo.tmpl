{{- /* 
    artifactinfo.tmpl ~ Artifact information template.
*/ -}}
{{- define "artifactinfo" -}}
{{- $content := index . "content"}}
{{- $alertURL := index . "alertURL"}}
{{- $checksum := index . "checksum"}}
{{- $preview := index . "linkpreview"}}
{{- $previewTip := index . "linkpreviewTip"}}
{{- $jsdos6 := index . "jsdos6"}}
{{- $screenNone := index . "screenshotNone"}}
{{- $writers := trimSpace (index . "writers") }}
{{- $artists := trimSpace (index . "artists") }}
{{- $contentLatin1 := index . "contentLatin1"}}
{{- $contentLines := index . "contentLines"}}
{{- $contentRows := index . "contentRows"}}
{{- $programmers := trimSpace (index . "programmers") }}
{{- $musicians := trimSpace (index . "musicians") }}
{{- $demozoo := (index . "demozoo")}}
{{- $pouet := (index . "pouet")}}
{{- $sixteenColors := trimSpace (index . "sixteenColors")}}
{{- $youtube := trimSpace (index . "youtube")}}
{{- $github := trimSpace (index . "github")}}
{{- $comment := trimSpace (index . "comment")}}
{{- $mimetype := index . "magic"}}
{{- $noDownload := index . "noDownload"}}
{{- $contentDesc := index . "contentDesc"}}
{{- $lastModAgo := index . "lastmodifiedAgo"}}
{{- $lastMod := index . "lastmodified"}}
{{- $filesize := index . "filesize"}}
{{- $filebyte := index . "filebyte"}}
{{- $filename := index . "filename"}}
{{- $download := index . "download"}}
{{- $fileEntry := index . "filentry"}}
{{- $extraZip := index . "extraZip"}}
{{- $editor := index . "editor"}}
{{- $sauce := index . "readmeSAUCE"}}
{{- $sauceTitle := index . "sauceTitle"}}
{{- $sauceAuthor := index . "sauceAuthor"}}
{{- $sauceGroup := index . "sauceGroup"}}
{{- $sauceDate := index . "sauceDate"}}
            {{- /*  [FILENAME] Content  */}}
            {{- if $content}}
            {{- $fileCount := len $content}}
            <div class="modal fade" id="view-content-modal" tabindex="-1" aria-labelledby="view-content-modal-label" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header py-2 px-3">
                            <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                                <svg class="flex-shrink-0 text-secondary" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                    <use xlink:href="/svg/bootstrap-icons.svg#file-text"/>
                                </svg>
                                <h5 class="modal-title fs-6 fw-semibold text-truncate mb-0" id="view-content-modal-label">{{$filename}}</h5>
                                <span class="badge text-bg-secondary fw-normal flex-shrink-0" id="view-content-count">{{$fileCount}} {{if eq $fileCount 1}}file{{else}}files{{end}}</span>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="px-3 py-2 bg-body-tertiary border-bottom">
                            <div class="input-group input-group-sm">
                                <input type="search" class="form-control" id="view-content-filter" placeholder="Filter files..." aria-label="Filter files">
                                <button type="button" class="btn btn-outline-secondary d-none" id="view-content-filter-clear">Clear</button>
                            </div>
                        </div>
                        <div class="modal-body p-0">
                            <table class="table table-sm table-hover align-middle mb-0" id="view-content-table">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th scope="col" class="fw-normal text-secondary text-end ps-3" style="width: 1%;">#</th>
                                        <th scope="col" class="fw-normal text-secondary pe-3">File path</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {{- range $i, $v := $content }}
                                    <tr>
                                        <th scope="row" class="fw-normal text-body-tertiary font-monospace small text-end ps-3">{{add $i}}</th>
                                        <td class="font-monospace small text-body text-break pe-3">{{trimSpace $v}}</td>
                                    </tr>
                                {{- end }}
                                    <tr id="view-content-empty" class="d-none">
                                        <td colspan="2" class="text-center text-body-secondary small py-3">No matching files</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="modal-footer py-2">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
            <script>
              (() => {
                const filterInput = document.getElementById('view-content-filter');
                const clearBtn = document.getElementById('view-content-filter-clear');
                const countBadge = document.getElementById('view-content-count');
                const emptyRow = document.getElementById('view-content-empty');
                const table = document.getElementById('view-content-table');
                if (!filterInput || !table) return;
                const rows = Array.from(table.querySelectorAll('tbody tr')).filter((tr) => tr !== emptyRow);
                const total = rows.length;
                const unit = total === 1 ? 'file' : 'files';
                function applyFilter() {
                  const q = filterInput.value.trim().toLowerCase();
                  if (clearBtn) clearBtn.classList.toggle('d-none', q === '');
                  let shown = 0;
                  for (const row of rows) {
                    const match = q === '' || row.lastElementChild.textContent.toLowerCase().includes(q);
                    row.classList.toggle('d-none', !match);
                    if (match) shown++;
                  }
                  if (emptyRow) emptyRow.classList.toggle('d-none', shown > 0);
                  if (countBadge) {
                    countBadge.textContent = q === '' ? `${total} ${unit}` : `${shown} / ${total} ${unit}`;
                  }
                }
                filterInput.addEventListener('input', applyFilter);
                if (clearBtn) {
                  clearBtn.addEventListener('click', () => {
                    filterInput.value = '';
                    applyFilter();
                    filterInput.focus();
                  });
                }
              })();
            </script>
            {{- end}}
            {{- /*  Primary artifact actions  */}}
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            {{- if eq $alertURL "" }}
              {{- /*  standard download  */}}
              <a class="btn btn-success d-inline-flex align-items-center gap-2" id="artifact-download-link" href="/d/{{$download}}" rel="nofollow" role="button" data-bs-toggle="tooltip" data-bs-title="alt + shift + d">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <use xlink:href="/svg/bootstrap-icons.svg#cloud-download"/>
                </svg>
                <span{{if $noDownload}} class="text-decoration-line-through"{{end}}>Download</span>
                <span class="small{{if $noDownload}} text-decoration-line-through{{end}}">({{$filesize}})</span>
              </a>
              {{- if eq $extraZip true }}
              <a class="btn btn-outline-success d-inline-flex align-items-center gap-2" href="/jsdos/{{$download}}" rel="nofollow" role="button" data-bs-toggle="tooltip" data-bs-title="Repacked for usability">
                <span>ZIP repack</span>
              </a>
              {{- end}}
              {{- /*  chiptune player for music files  */}}
              {{- if and (musicMod $mimetype) (not $noDownload)}}
              <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" id="chiptune-play-button" data-bs-toggle="tooltip" data-bs-title="Preview in browser">Play music</button>
              {{- end }}
            {{- else }}
              {{- /*  google download warning  */}}
              <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#download-unwanted-modal">
                <span>Download warning</span>
              </button>
              <div class="modal fade" id="download-unwanted-modal" tabindex="-1" aria-labelledby="download-unwanted-modal-label" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title fs-5" id="download-unwanted-modal-label">Download warning</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-start">
                      Google Search or Microsoft Defender flags this download as unsafe or as an unwanted download.
                      It maybe be a false positive, however we recommend being careful!
                      Either run the file in a virtualized environment or in an isolated emulator.
                      <p class="m-3 text-center h6"><a class="link-offset-2" href="{{$alertURL}}">You should read this scan report before downloading</a></p>
                      <p class="m-5 text-center">
                        <small><a class="link-secondary link-offset-3" href="/d/{{$download}}" rel="nofollow" role="button">I understand, download anyway</a></small>
                      </p>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-success" data-bs-dismiss="modal">Cancel</button>
                    </div>
                  </div>
                </div>
              </div>
            {{- end }}
            {{- if eq $jsdos6 true}}
              <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="alt + shift + r">
                <button type="button" id="js-dos-run-app" class="btn btn-outline-dark d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#js-dos-modal">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <use xlink:href="/svg/bootstrap-icons.svg#terminal"/>
                  </svg>
                  <span>Run in browser</span>
                </button>
              </span>
            {{- end}}
            </div>
            {{- /*  Secondary artifact utilities  */}}
            {{- if or $content (ne "" $checksum) (ne "" $preview) (not $screenNone)}}
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            {{- if $content}}
              <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="alt + shift + v">
                <button type="button" id="artifact-view-content" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#view-content-modal">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <use xlink:href="/svg/bootstrap-icons.svg#file-text"/>
                  </svg>
                  <span>View content</span>
                  <span class="badge text-bg-secondary">{{len $content}}</span>
                </button>
              </span>
            {{- end}}
            {{- if ne "" $checksum}}
              <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" href="/sum/{{$download}}" role="button" data-bs-toggle="tooltip" data-bs-title="{{$checksum}}" rel="nofollow">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <use xlink:href="/svg/bootstrap-icons.svg#check2"/>
                </svg>
                <span>Checksum</span>
              </a>
            {{- end}}
            {{- if ne "" $preview}}
              <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" href="{{$preview}}" role="button" data-bs-toggle="tooltip" data-bs-title="{{$previewTip}}" rel="nofollow">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <use xlink:href="/svg/bootstrap-icons.svg#images"/>
                </svg>
                <span>View artifact</span>
              </a>
            {{- end}}
            {{- if not $screenNone}}
              <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="alt + shift + e">
                <button type="button" id="artifact-enlarge-screenshot" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                    data-bs-toggle="modal" data-bs-target="#artifact-screenshot-modal">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <use xlink:href="/svg/bootstrap-icons.svg#images"/>
                  </svg>
                  <span>Enlarge</span>
                </button>
              </span>
            {{- end}}
            </div>
            {{- end}}
            {{- /*  Comment on the artifact  */}}
            {{- if ne $comment ""}}
            <div class="border-start border-4 border-info ps-3 py-2 my-3">
                <p class="fst-italic mb-0">{{$comment}}</p>
            </div>
            {{- end}}
            {{- if eq $editor true }}
            <style>.selection:hover { cursor: pointer; }</style>
            {{- end }}
            {{- /*  Summary stats  */}}
            <div class="bg-body-tertiary border rounded p-3 mb-3">
              <div class="row row-cols-2 g-3">
                <div class="col">
                  <div class="text-secondary text-uppercase" style="font-size: 0.72rem; letter-spacing: .04em;">Download</div>
                  <div data-bs-toggle="tooltip" data-bs-title="{{$filebyte}} bytes">{{$filesize}}
                    {{- if ne "" $contentDesc}}<span class="text-body-secondary">, {{$contentDesc}}</span>{{end -}}
                  </div>
                </div>
                <div class="col">
                  <div class="text-secondary text-uppercase" style="font-size: 0.72rem; letter-spacing: .04em;">Modified</div>
                  <div data-bs-toggle="tooltip" data-bs-title="{{$lastModAgo}}">{{$lastMod}}</div>
                </div>
                {{- if ne $mimetype ""}}
                <div class="col">
                  <div class="text-secondary text-uppercase" style="font-size: 0.72rem; letter-spacing: .04em;">File type</div>
                  <div>{{$mimetype}}</div>
                </div>
                {{- end}}
                {{- if $contentLatin1}}
                <div class="col">
                  <div class="text-secondary text-uppercase" style="font-size: 0.72rem; letter-spacing: .04em;">Text dimensions</div>
                  <div class="font-monospace">
                    <span data-bs-toggle="tooltip" data-bs-title="Number of lines in the text">{{$contentLines}}</span>
                    <span class="text-secondary">&times;</span>
                    <span data-bs-toggle="tooltip" data-bs-title="Maximum number of rows or characters per-line">{{$contentRows}}</span>
                  </div>
                </div>
                {{- end}}
              </div>
            </div>
            {{- /*  Credits, SAUCE and external links  */}}
            {{- $websites := index . "websites"}}
            {{- $relations := index . "relations"}}
            {{- $hasSauce := and $sauce (or (ne $sauceTitle "") (ne $sauceAuthor "") (ne $sauceGroup "") (ne $sauceDate ""))}}
            {{- $hasDetails := or $hasSauce $writers $artists $programmers $musicians $pouet $demozoo $sixteenColors $youtube $github $websites $relations}}
            {{- if $hasDetails}}
            <style>
              .artifact-details-table th[scope="row"] { width: 38%; }
              .artifact-details-table > tbody:last-child > tr:last-child > * { border-bottom-width: 0; }
            </style>
            <div class="card mb-3">
              <div class="card-body py-2 px-3">
                <table class="table table-hover table-sm align-middle mb-0 artifact-details-table">
                  <tbody>
                    {{- if $sauce}}
                    {{- if ne $sauceTitle ""}}
                    <tr class="selection" id="artifact-embed-title">
                      <th scope="row"><small class="text-nowrap fw-light text-info-emphasis">Embed title</small></th>
                      <td id="artifact-embed-title-value">{{$sauceTitle}}</td>
                    </tr>
                    {{- end}}{{ if ne $sauceAuthor ""}}
                    <tr class="selection" id="artifact-embed-author">
                      <th scope="row"><small class="text-nowrap fw-light text-info-emphasis">Embed author</small></th>
                      <td id="artifact-embed-author-value">{{$sauceAuthor}}</td>
                    </tr>
                    {{- end}}{{ if ne $sauceGroup ""}}
                    <tr class="selection" id="artifact-embed-group">
                      <th scope="row"><small class="text-nowrap fw-light text-info-emphasis">Embed group</small></th>
                      <td id="artifact-embed-group-value">{{$sauceGroup}}</td>
                    </tr>
                    {{- end}}
                    <tr>
                      <th scope="row"><small class="text-nowrap fw-light text-info-emphasis">Embed date</small></th>
                      <td>{{$sauceDate}}</td>
                    </tr>
                    {{- end}}
                    {{- /*  Authors and attributions  */}}
                    {{- if ne $writers "" }}
                    <tr>
                      <th scope="row"><small class="fw-light text-secondary">Writers <em>or people mentioned</em></small></th>
                      <td>{{linkScnrs $writers}}</td>
                    </tr>{{- end}}
                    {{- if ne $artists "" }}
                    <tr>
                      <th scope="row"><small class="fw-light text-secondary">Artists</small></th>
                      <td>{{linkScnrs $artists}}</td>
                    </tr>{{- end}}
                    {{- if ne $programmers "" }}
                    <tr>
                      <th scope="row"><small class="fw-light text-secondary">Programmers</small></th>
                      <td>{{linkScnrs $programmers}}</td>
                    </tr>{{- end}}
                    {{- if ne $musicians "" }}
                    <tr>
                      <th scope="row"><small class="fw-light text-secondary">Musicians</small></th>
                      <td>{{linkScnrs $musicians}}</td>
                    </tr>{{- end}}
                    {{- /*  Pouet, Demozoo, 16colors links  */}}
                    {{- if ne $pouet ""}}
                    <tr id="pouetRow" class="d-none">
                      <th scope="row"><small class="fw-light text-secondary">Pouët reviews</small></th>
                      <td>
                        <a id="pouetStars" href="https://www.pouet.net/prod.php?which={{$pouet}}">? stars</a>
                        &nbsp; <small id="pouetVotes">? votes</small>
                        <span class="d-none" id="pouetVoteID">{{$pouet}}</span>
                      </td>
                    </tr>{{- end}}
                    {{- if ne $demozoo ""}}
                    <tr>
                      <th scope="row"><small class="fw-light text-secondary">Demozoo</small></th>
                      <td>
                        <small><a class="link-offset-3 icon-link icon-link-hover" href="https://demozoo.org/productions/{{$demozoo}}">Extras, links and downloads{{linkSVG}}</a></small>
                      </td>
                    </tr>{{- end}}
                    {{- if ne $sixteenColors ""}}
                    <tr>
                      <th scope="row"><small class="fw-light text-secondary">16colors</small></th>
                      <td>
                        <small><a class="link-offset-3 icon-link icon-link-hover" href="https://16colo.rs/{{$sixteenColors}}">Browse art and play animations{{linkSVG}}</a></small>
                      </td>
                    </tr>{{- end}}
                    {{- /*  YouTube, GitHub and other links  */}}
                    {{- if ne $youtube ""}}
                    <tr>
                      <th scope="row"><small class="fw-light text-secondary">YouTube</small></th>
                      <td>
                        <small><a class="link-offset-3 icon-link icon-link-hover" href="https://www.youtube.com/watch?v={{$youtube}}">Watch on YouTube{{linkSVG}}</a></small>
                      </td>
                    </tr>{{- end}}
                    {{- if ne $github ""}}
                    <tr>
                      <th scope="row"><small class="fw-light text-secondary">GitHub</small></th>
                      <td>
                        <small><a class="link-offset-3 icon-link icon-link-hover" href="https://github.com/{{$github}}"><var>{{$github}}</var>{{linkSVG}}</a></small>
                      </td>
                    </tr>{{- end}}
                    {{- /*  "Link to" items  */}}
                    {{- $websites }}
                    {{- $relations }}
                  </tbody>
                </table>
              </div>
              {{- /*  File created and updated dates  */}}
              {{- if $fileEntry}}
              <div class="card-footer bg-body-tertiary py-2 px-3 small text-body-secondary">
                <span class="fw-light me-2">Artifact:</span>{{$fileEntry | safeHTML}}
              </div>
              {{- end}}
            </div>
            {{- else if $fileEntry}}
            <div class="small text-body-secondary px-1 mb-3">
              <span class="fw-light me-2">Artifact:</span>{{$fileEntry | safeHTML}}
            </div>
            {{- end}}
{{- end}}
