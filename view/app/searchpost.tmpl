{{- /*
    searchpost.tmpl ~ Search form for artifacts.
*/ -}}
{{- define "content" }}
{{- $title := index . "title" }}
{{- $mode := index . "searchMode" }}
{{- $isDesc := eq $mode "desc" }}
{{- $isFile := eq $mode "file" }}
<div class="container-xxl">
  <div class="bg-body-tertiary border rounded-2 px-3 py-3 mb-3">
    <nav class="d-flex flex-wrap align-items-center gap-3 small mb-2" aria-label="Search categories">
      <span class="text-body-secondary fw-medium">Search in:</span>
      <a class="{{if $isDesc}}fw-semibold text-body text-decoration-none{{else}}link-underline link-underline-opacity-0 link-underline-opacity-75-hover{{end}}" href="/search/desc" rel="nofollow"{{if $isDesc}} aria-current="page"{{end}}>Titles &amp; comments</a>
      <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/search/releaser" rel="nofollow">Groups &amp; names</a>
      <a class="{{if $isFile}}fw-semibold text-body text-decoration-none{{else}}link-underline link-underline-opacity-0 link-underline-opacity-75-hover{{end}}" href="/search/file" rel="nofollow"{{if $isFile}} aria-current="page"{{end}}>Filenames</a>
      {{- if index . "editor" }}
      <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/editor/search/id" rel="nofollow">ID / UUID</a>
      {{- end }}
    </nav>
    <form method="get" action="{{if $isDesc}}/search/desc{{else}}/search/file{{end}}" id="search-post-form">
      <label class="visually-hidden" for="search-term-query">{{$title}}</label>
      <div class="input-group">
        <input type="search" autofocus spellcheck="false" autocomplete="off" class="form-control"
          id="search-term-query" name="query"
          placeholder="{{if $isDesc}}Example: ultima 7, ultima 8{{else}}Example: .iff, .tif, read.me{{end}}">
        <button type="button" id="search-post-clear" class="btn btn-outline-secondary" disabled>Clear</button>
        <button type="submit" class="btn btn-primary">Search</button>
      </div>
      <div class="form-text mb-0">
        Separate multiple queries with commas.
      </div>
    </form>
  </div>
</div>
<script>
(() => {
  const form = document.getElementById('search-post-form');
  const input = document.getElementById('search-term-query');
  const clearBtn = document.getElementById('search-post-clear');
  if (!form || !input || !clearBtn) return;

  function syncClear() {
    clearBtn.disabled = input.value === '';
  }

  form.addEventListener('submit', (e) => {
    if (input.value.trim() === '') {
      e.preventDefault();
      input.focus();
    }
  });
  input.addEventListener('input', syncClear);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && input.value !== '') {
      e.preventDefault();
      input.value = '';
      syncClear();
    }
  });
  clearBtn.addEventListener('click', () => {
    input.value = '';
    syncClear();
    input.focus();
  });
  window.addEventListener('pageshow', syncClear);
  syncClear();
})();
</script>
{{- end }}
