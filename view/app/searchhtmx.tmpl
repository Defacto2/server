{{- /*
    searchhtmx.tmpl ~ Search results using htmx.
*/ -}}
{{- define "content" }}
{{- $title := index . "title" }}
{{- $hxpost := index . "hxPost" }}
{{- $mode := index . "searchMode" }}
{{- $isReleaser := or (eq $mode "releaser") (eq $hxpost "/search/releaser") }}
{{- $isID := or (eq $mode "id") (eq $hxpost "/editor/search/id") }}
{{- $placeholder := index . "inputPlaceholder" }}
{{- $helper := index . "helpText" }}
<div class="container-xxl">
  <div class="bg-body-tertiary border rounded-2 px-3 py-3 mb-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
      <nav class="d-flex flex-wrap align-items-center gap-3 small" aria-label="Search categories">
        <span class="text-body-secondary fw-medium">Search in:</span>
        <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/search/desc" rel="nofollow">Titles &amp; comments</a>
        <a class="{{if $isReleaser}}fw-semibold text-body text-decoration-none{{else}}link-underline link-underline-opacity-0 link-underline-opacity-75-hover{{end}}" href="/search/releaser" rel="nofollow"{{if $isReleaser}} aria-current="page"{{end}}>Groups &amp; names</a>
        <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="/search/file" rel="nofollow">Filenames</a>
        {{- if or (index . "editor") $isID }}
        <a class="{{if $isID}}fw-semibold text-body text-decoration-none{{else}}link-underline link-underline-opacity-0 link-underline-opacity-75-hover{{end}}" href="/editor/search/id" rel="nofollow"{{if $isID}} aria-current="page"{{end}}>ID / UUID</a>
        {{- end }}
      </nav>
      <span id="search-htmx-indicator" class="htmx-indicator small text-body-secondary d-inline-flex align-items-center gap-1" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Searching...</span>
      </span>
    </div>
    <label class="visually-hidden" for="search-htmx-input">{{$title}}</label>
    <div class="input-group">
      {{/*
          1. use "input changed" to allow triggering from copy/paste text.
          2. use "delay:500ms" to reduce the number of requests.
          3. use "type:search" purely for aesthetics.
          4. autofocus is used as the search is the main focus.
          5. spellcheck is disabled to prevent red underlines with oddball scene names.
          6. hx-post is a requirement otherwise the search will significantly slow down.
      */}}
      <input class="form-control" type="search"
        spellcheck="false" autocomplete="off" autofocus
        name="htmx-search" placeholder="{{$placeholder}}"
        id="search-htmx-input"
        hx-post="{{$hxpost}}"
        hx-trigger="input changed delay:500ms, search"
        hx-target="#search-htmx-results"
        hx-indicator="#search-htmx-indicator">
      <button type="button" id="search-htmx-clear" class="btn btn-outline-secondary" disabled>Clear</button>
    </div>
    {{- if ne $helper "" }}
    <div class="form-text mb-0">{{$helper}}</div>
    {{- end }}
  </div>
  <div id="search-htmx-alert" class="alert alert-danger d-none mb-3" role="alert"></div>
  <div id="search-htmx-results"></div>
</div>
{{- end }}
