{{- /* 
    artifactjsdos.tmpl ~ Artifact JS-DOS v6 emulator template.

    This template includes embedded JavaScript for the JS-DOS v6 emulator.
    A limited set of API documentation is available at https://js-dos.com/6.22/docs/
    Some real world examples are available at https://js-dos.com/6.22/examples/

    This template references the DOS32A.EXE app, an open source DOS extender replacement for the proprietary DOS4GW.EXE.
    DOS4GW.EXE is required for some DOS applications hosted on the website and is mounted as a utility in the emulator.
    The DOS32A binary is embedded into this web application and is found in the public/bin/dos32/ directory, while the
    GitHub repository for DOS32A is located at https://github.com/yetmorecode/dos32a-ng.
*/ -}}
{{- define "artifactjsdos" -}}
{{- if eq (index . "jsdos6") true}}
{{- $unlocked := index . "editor"}}
{{- $download := index . "download"}}
{{- $filename := index . "filename"}}
{{- $lead := index . "lead"}}
{{- $runProgram := index . "jsdos6Run"}}
{{- $extract := index . "jsdos6Zip"}}
{{- $config := index . "jsdos6Config"}}
{{- $runJS := "startBinary(DosBoxConfig);"}}
{{- if eq $extract true}}{{ $runJS = "startZip(DosBoxConfig);" }}{{end}}
{{- $prog := toLower $runProgram}}
{{- $fname := toLower $filename}}
{{- $loadUtils := index . "jsdos6Utilities"}}
{{- /*  js-dos v6.22 ~ canvas and user interface. */}}
<div class="modal fade" id="js-dos-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="jsDOSModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
              <h5 class="modal-title">
                🎮 &nbsp; {{- if ne $prog $fname}}{{toLower $prog}} - {{else}}{{end}}{{toLower $fname}}
              </h5>
              {{- if eq true (index . "modEmulateBroken")}}<span class="badge bg-danger ms-2">⚠️ Incompatible</span>{{end}}
              <button type="button" name="jsdosCloser" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{- if eq "covox" (index . "modEmulateAudio")}}<p class="text-info-emphasis">If asked for a sound device option, choose "LPT1" for Covox, Disney, Soundplayer or Soundthing</p>{{end}}
                {{- if eq "gus" (index . "modEmulateAudio")}}<p class="text-info-emphasis">If asked for the Gravis Ultrasound config, choose IRQ <var>5</var>, DMA <var>1</var>, Base address <var>240h</var> or Port <var>240</var></p>{{end}}
                {{- if eq "sb1" (index . "modEmulateAudio")}}<p class="text-info-emphasis">If asked for the Sound Blaster config, choose IRQ <var>7</var>, DMA <var>1</var>, Base address <var>220h</var> or Port <var>220</var></p>{{end}}
                {{- if eq "sb16" (index . "modEmulateAudio")}}<p class="text-info-emphasis">If asked for the Sound Blaster 16 config, choose IRQ <var>7</var>, DMA <var>1</var>, HDMA <var>5</var>, Base address <var>220h</var> or Port <var>220</var></p>{{end}}
                <canvas id="jsdos6"></canvas>
            </div>
            <div class="modal-footer">
                <button id="jsdosFullscreen" class="btn btn-outline-info">&#x2922; Full Screen</button>
                <button id="jsdosScreenshot" class="btn btn-outline-info">&#x26F6; Screenshot</button>
                {{- if $unlocked }}
                <button id="jsdosReplaceImage" class="btn btn-outline-warning">&#x26ED; Replace Image</button>
                {{- end }}
                <button id="jsdosStop" class="btn btn-danger">&#x25A0; Stop</button>
                <button type="button" name="jsdosCloser" class="btn btn-secondary" data-bs-dismiss="modal">✕ Close</button>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="jsdos-utilities" name="jsdos-utilities" value="{{$loadUtils}}">
<script>
    const canvas = document.getElementById("jsdos6");
    const ctx = canvas.getContext("2d");
    const loadUtils = document.getElementById("jsdos-utilities").value;
    const mountApp = [{ url: "/jsdos/{{$download}}", mountPoint: "/" }];
    const mountDOS4GW = { url: "/jsdos/bin/DOS4GW.zip", mountPoint: "/dos4gw" };
    const startDOS = [
      "-conf", "dosbox.conf"
    ];
    const startWithDOS4GW = [
      "-conf", "dosbox.conf", 
      "-c", "SET PATH=%PATH%;C:\\DOS4GW"
    ];
    const runCommands = "{{$runProgram}}".split("&&");
    runCommands.forEach(cmd => {
      const trimmed = cmd.trim();
      if (!trimmed) {
        return;
      }
      if (trimmed.includes("\\") && !trimmed.includes(" ")) {
        const sep = trimmed.lastIndexOf("\\");
        const dir = trimmed.slice(0, sep);
        const exe = trimmed.slice(sep + 1);
        if (dir && exe) {
          startDOS.push("-c", `CD ${dir}`, "-c", exe);
          startWithDOS4GW.push("-c", `CD ${dir}`, "-c", exe);
          return;
        }
      }
      startDOS.push("-c", trimmed);
      startWithDOS4GW.push("-c", trimmed);
    });
    ctx.font = "14px serif";
    ctx.fillText("Stuck and not loading?", 10, 50);
    ctx.fillText("1) try refreshing this tab.", 13, 70);
    ctx.fillText("2) view the tab Console for errors.", 13, 90);
    let emulatorStarted = false;
    const captureBaseName = ("{{$filename}}".split(/[\\/]/).pop() || "screenshot").replace(/\.[^/.]+$/, "") || "screenshot";
    const stopButton = document.getElementById("jsdosStop");
    function exitEmulator() {
      try {
        if (window.ci && !stopButton.disabled) {
          window.ci.exit();
          stopButton.disabled = true;
        }
      } catch (error) {
        console.log("ci.exit() error: ", error);
      }
    }
    stopButton.addEventListener("click", exitEmulator);
    document.getElementById(`jsdosFullscreen`).addEventListener("click", () => {
      canvas.requestFullscreen();
    });
    document
      .getElementById(`jsdosScreenshot`)
      .addEventListener("click", () => {
        screenshot(captureBaseName);
      });
{{- if $unlocked }}
    const replaceImageButton = document.getElementById('jsdosReplaceImage');
    replaceImageButton.addEventListener('click', () => {
      captureCanvasBlob((blob) => {
        if (!blob) return;
        const replacementInput = document.querySelector('input[name="artifact-editor-replace-preview"]');
        let attached = false;
        if (replacementInput && typeof DataTransfer !== 'undefined') {
          const dt = new DataTransfer();
          dt.items.add(new File([blob], `${captureBaseName}-screenshot.png`, { type: 'image/png' }));
          replacementInput.files = dt.files;
          attached = replacementInput.files.length > 0;
        }
        if (!attached) {
          downloadBlob(blob, `${captureBaseName}-replace-image.png`);
        }
        replaceImageButton.disabled = true;
        // Stop JS-DOS emulation cleanly before switching modals
        exitEmulator();
        const runAppButton = document.getElementById('js-dos-run-app');
        if (runAppButton) {
          runAppButton.textContent = 'Refresh page to rerun';
          runAppButton.style.pointerEvents = 'none';
        }
        const jsdosModalEl = document.getElementById('js-dos-modal');
        const assetModalEl = document.getElementById('asset-editor-modal');
        const jsdosModal = bootstrap.Modal.getOrCreateInstance(jsdosModalEl);
        const assetModal = bootstrap.Modal.getOrCreateInstance(assetModalEl);
        jsdosModalEl.addEventListener('hidden.bs.modal', () => {
          assetModal.show();
        }, { once: true });
        jsdosModal.hide();
      });
    });
{{- end }}
    function captureCanvasBlob(callback) {
      if (!emulatorStarted || canvas.width === 0 || canvas.height === 0) {
        return;
      }
      const baseWidth = canvas.width;
      const srcHeight = canvas.height;
      // Apply 4:3 CRT pixel aspect correction for classic non-square DOS modes (e.g. 320x200, 640x350, 720x400).
      const aspect = baseWidth / srcHeight;
      const needsCRTCorrection = Math.abs(aspect - 4 / 3) > 0.05 && baseWidth <= 720 && srcHeight <= 400;
      const baseHeight = needsCRTCorrection ? Math.round(baseWidth * (3 / 4)) : srcHeight;
      const maxWidth = 1280;
      const maxHeight = 960;
      const intScale = Math.max(1, Math.min(3, Math.floor(maxWidth / baseWidth), Math.floor(maxHeight / baseHeight)));
      let targetWidth = baseWidth * intScale;
      let targetHeight = baseHeight * intScale;
      if (targetWidth > maxWidth || targetHeight > maxHeight) {
        const ratio = Math.min(maxWidth / targetWidth, maxHeight / targetHeight);
        targetWidth = Math.round(targetWidth * ratio);
        targetHeight = Math.round(targetHeight * ratio);
      }

      const offscreen = document.createElement("canvas");
      offscreen.width = targetWidth;
      offscreen.height = targetHeight;
      const offCtx = offscreen.getContext("2d");
      offCtx.imageSmoothingEnabled = false;
      offCtx.drawImage(canvas, 0, 0, canvas.width, canvas.height, 0, 0, targetWidth, targetHeight);
      offscreen.toBlob(callback, "image/png");
    }
    function downloadBlob(blob, downloadName) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = downloadName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }
    function screenshot(filename = 'screenshot') {
      console.log(`screenshot: for canvas of ${filename}`);
      captureCanvasBlob((blob) => {
        if (!blob) return;
        downloadBlob(blob, `${filename}.png`);
      });
    }
    function startBinary(options) {
      Dos(canvas, options).ready((fs, main) => {
        fs.createFile("dosbox.conf", "{{$config}}");      // create DOSBox configuration file in virtual file system
        fetch("/d/{{$download}}")                         // fetch the artifact file download
          .then((response) => {
            if (!response.ok) {
              throw new Error(`Failed to fetch binary (${response.status})`);
            }
            return response.arrayBuffer();
          })
          .then((arrayBuffer) => {
            fs.createFile("{{$filename}}", arrayBuffer);  // recreate file in virtual file system
            return main(startDOS);
          })
          .then((ci) => {
            window.ci = ci;
            emulatorStarted = true;
            console.log(
              `width: ${ci.dos.canvas.width}, height: ${ci.dos.canvas.height}`
            );
          })
          .catch((error) => {
            console.error("js-dos binary start error:", error);
          });
      });
    }
    function startZip(options) {
      Dos(canvas, options).ready((fs, main) => {
        fs.createFile("dosbox.conf", "{{$config}}");      // create DOSBox configuration file in virtual file system
        console.log("{{$config}}");                       // print the configuration file to the console
        if (loadUtils === "true") {
          mountApp.push(mountDOS4GW);                     // mount the DOS4GW.EXE file
        }
        fs.extractAll(mountApp)                           // download and extract the artifact and any utilities
          .then(() => {
            let params = startDOS;
            if (loadUtils === "true") {
              params = startWithDOS4GW;
            }
            return main(params);                          // start the application
          })
          .then((ci) => {
            window.ci = ci;
            emulatorStarted = true;
            console.log(
              `width: ${ci.dos.canvas.width}, height: ${ci.dos.canvas.height}`
            );
          })
          .catch((error) => {
            console.error("js-dos zip start error:", error);
          });
      });
    }
    const jsdos = document.getElementById("js-dos-run-app");
    jsdos.addEventListener("click", function () {
      this.style.pointerEvents = "none";
      this.textContent = "Running app";
      const DosBoxConfig = {
        wdosboxUrl: "/js/wdosbox.js",
        cycles: "auto", // int value, "max" or "auto"
        autolock: false,
      };
      {{$runJS | safeJS}}
    });
    const jsQuitButtons = document.getElementsByName("jsdosCloser");
    for (let i = 0; i < jsQuitButtons.length; i++) {
      jsQuitButtons[i].addEventListener("click", () => {
        location.reload();
      });
    }
</script>
{{- end}}{{ end }}
