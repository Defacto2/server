{{- /* 
    artifactjsdos.tmpl ~ Artifact JS-DOS v6 emulator template.

    This template includes embedded JavaScript for the JS-DOS v6 emulator.
    A limited set of API documentation is available at https://js-dos.com/6.22/docs/
    Some real world examples are available at https://js-dos.com/6.22/examples/

    This template references the DOS32A.EXE app, an open source DOS extender replacement for the proprietary DOS4GW.EXE.
    DOS4GW.EXE is required for some DOS applications hosted on the website and is mounted as a utility in the emulator.
    The DOS32A binary is embedded into this web application and is found in the public/bin/dos32/ directory, while the
    GitHub repository for DOS32A is located at https://github.com/yetmorecode/dos32a-ng.
*/ -}}
{{- define "artifactjsdos" -}}
{{- if eq (index . "jsdos6") true}}
{{- $unlocked := index . "editor"}}
{{- $download := index . "download"}}
{{- $filename := index . "filename"}}
{{- $lead := index . "lead"}}
{{- $runProgram := index . "jsdos6Run"}}
{{- $extract := index . "jsdos6Zip"}}
{{- $config := index . "jsdos6Config"}}
{{- $runJS := "startBinary(DosBoxConfig);"}}
{{- if eq $extract true}}{{ $runJS = "startZip(DosBoxConfig);" }}{{end}}
{{- $prog := toLower $runProgram}}
{{- $fname := toLower $filename}}
{{- $loadUtils := index . "jsdos6Utilities"}}
{{- /*  js-dos v6.22 ~ canvas and user interface. */}}
<div class="modal fade" id="js-dos-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="jsDOSModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary py-2 px-3">
              <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                <svg class="flex-shrink-0 text-secondary" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <use xlink:href="/svg/bootstrap-icons.svg#terminal"/>
                </svg>
                <h5 class="modal-title fs-6 fw-semibold text-truncate mb-0" id="jsDOSModalLabel">
                  {{- if ne $prog $fname}}{{toLower $prog}} - {{else}}{{end}}{{toLower $fname}}
                </h5>
                {{- if eq true (index . "modEmulateBroken")}}<span class="badge text-bg-danger fw-normal flex-shrink-0">Incompatible</span>{{end}}
              </div>
              <button type="button" name="jsdosCloser" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 bg-black">
                {{- if eq "covox" (index . "modEmulateAudio")}}<div class="px-3 py-2 border-bottom border-secondary small text-info bg-dark">If asked for a sound device option, choose "LPT1" for Covox, Disney, Soundplayer or Soundthing.</div>{{end}}
                {{- if eq "gus" (index . "modEmulateAudio")}}<div class="px-3 py-2 border-bottom border-secondary small text-info bg-dark">If asked for the Gravis Ultrasound config, choose IRQ <var>5</var>, DMA <var>1</var>, Base address <var>240h</var> or Port <var>240</var>.</div>{{end}}
                {{- if eq "sb1" (index . "modEmulateAudio")}}<div class="px-3 py-2 border-bottom border-secondary small text-info bg-dark">If asked for the Sound Blaster config, choose IRQ <var>7</var>, DMA <var>1</var>, Base address <var>220h</var> or Port <var>220</var>.</div>{{end}}
                {{- if eq "sb16" (index . "modEmulateAudio")}}<div class="px-3 py-2 border-bottom border-secondary small text-info bg-dark">If asked for the Sound Blaster 16 config, choose IRQ <var>7</var>, DMA <var>1</var>, HDMA <var>5</var>, Base address <var>220h</var> or Port <var>220</var>.</div>{{end}}
                <canvas id="jsdos6"></canvas>
            </div>
            <div class="modal-footer border-secondary justify-content-between flex-wrap gap-2 py-2 px-3">
                <div class="btn-group btn-group-sm" role="group" aria-label="Emulator display and capture">
                  <button type="button" id="jsdosFullscreen" class="btn btn-outline-light">Full screen</button>
                  <button type="button" id="jsdosScreenshot" class="btn btn-outline-light" disabled>Screenshot</button>
                  {{- if $unlocked }}
                  <button type="button" id="jsdosReplaceImage" class="btn btn-outline-warning" disabled>Replace image</button>
                  {{- end }}
                </div>
                <div class="d-flex align-items-center gap-2">
                  <button type="button" id="jsdosStop" class="btn btn-sm btn-outline-danger" disabled>Stop</button>
                  <button type="button" name="jsdosCloser" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="jsdos-utilities" name="jsdos-utilities" value="{{$loadUtils}}">
<script>
    const canvas = document.getElementById("jsdos6");
    const ctx = canvas.getContext("2d");
    const loadUtils = document.getElementById("jsdos-utilities").value;
    const mountApp = [{ url: "/jsdos/{{$download}}", mountPoint: "/" }];
    const mountDOS4GW = { url: "/jsdos/bin/DOS4GW.zip", mountPoint: "/dos4gw" };
    const startDOS = [
      "-conf", "dosbox.conf"
    ];
    const startWithDOS4GW = [
      "-conf", "dosbox.conf", 
      "-c", "SET PATH=%PATH%;C:\\DOS4GW"
    ];
    const runCommands = "{{$runProgram}}".split("&&");
    runCommands.forEach(cmd => {
      const trimmed = cmd.trim();
      if (!trimmed) {
        return;
      }
      if (trimmed.includes("\\") && !trimmed.includes(" ")) {
        const sep = trimmed.lastIndexOf("\\");
        const dir = trimmed.slice(0, sep);
        const exe = trimmed.slice(sep + 1);
        if (dir && exe) {
          startDOS.push("-c", `CD ${dir}`, "-c", exe);
          startWithDOS4GW.push("-c", `CD ${dir}`, "-c", exe);
          return;
        }
      }
      startDOS.push("-c", trimmed);
      startWithDOS4GW.push("-c", trimmed);
    });
    ctx.fillStyle = "#adb5bd";
    ctx.font = "14px monospace";
    ctx.fillText("Stuck and not loading?", 10, 50);
    ctx.fillText("1) try refreshing this tab.", 13, 70);
    ctx.fillText("2) view the tab Console for errors.", 13, 90);
    let emulatorStarted = false;
    const captureBaseName = ("{{$filename}}".split(/[\\/]/).pop() || "screenshot").replace(/\.[^/.]+$/, "") || "screenshot";
    const screenshotButton = document.getElementById("jsdosScreenshot");
    const stopButton = document.getElementById("jsdosStop");
    function onEmulatorReady(ci) {
      window.ci = ci;
      emulatorStarted = true;
      screenshotButton.disabled = false;
      stopButton.disabled = false;
      const replaceBtn = document.getElementById("jsdosReplaceImage");
      if (replaceBtn) replaceBtn.disabled = false;
      console.log(`width: ${ci.dos.canvas.width}, height: ${ci.dos.canvas.height}`);
    }
    function exitEmulator() {
      try {
        if (window.ci && !stopButton.disabled) {
          window.ci.exit();
          stopButton.disabled = true;
        }
      } catch (error) {
        console.log("ci.exit() error: ", error);
      }
    }
    stopButton.addEventListener("click", exitEmulator);
    document.getElementById(`jsdosFullscreen`).addEventListener("click", () => {
      canvas.requestFullscreen();
    });
    document
      .getElementById(`jsdosScreenshot`)
      .addEventListener("click", () => {
        screenshot(captureBaseName);
      });
{{- if $unlocked }}
    const replaceImageButton = document.getElementById('jsdosReplaceImage');
    replaceImageButton.addEventListener('click', () => {
      captureCanvasBlob((blob) => {
        if (!blob) return;
        const replacementInput = document.querySelector('input[name="artifact-editor-replace-preview"]');
        let attached = false;
        if (replacementInput && typeof DataTransfer !== 'undefined') {
          const dt = new DataTransfer();
          dt.items.add(new File([blob], `${captureBaseName}-screenshot.png`, { type: 'image/png' }));
          replacementInput.files = dt.files;
          attached = replacementInput.files.length > 0;
        }
        if (!attached) {
          downloadBlob(blob, `${captureBaseName}-replace-image.png`);
        }
        replaceImageButton.disabled = true;
        // Stop JS-DOS emulation cleanly before switching modals
        exitEmulator();
        const runAppButton = document.getElementById('js-dos-run-app');
        if (runAppButton) {
          runAppButton.textContent = 'Refresh page to rerun';
          runAppButton.style.pointerEvents = 'none';
        }
        const jsdosModalEl = document.getElementById('js-dos-modal');
        const assetModalEl = document.getElementById('asset-editor-modal');
        const jsdosModal = bootstrap.Modal.getOrCreateInstance(jsdosModalEl);
        const assetModal = bootstrap.Modal.getOrCreateInstance(assetModalEl);
        jsdosModalEl.addEventListener('hidden.bs.modal', () => {
          assetModal.show();
        }, { once: true });
        jsdosModal.hide();
      });
    });
{{- end }}
    function captureCanvasBlob(callback) {
      if (!emulatorStarted || canvas.width === 0 || canvas.height === 0) {
        return;
      }
      const baseWidth = canvas.width;
      const srcHeight = canvas.height;
      // Apply 4:3 CRT pixel aspect correction for classic non-square DOS modes (e.g. 320x200, 640x350, 720x400).
      const aspect = baseWidth / srcHeight;
      const needsCRTCorrection = Math.abs(aspect - 4 / 3) > 0.05 && baseWidth <= 720 && srcHeight <= 400;
      const baseHeight = needsCRTCorrection ? Math.round(baseWidth * (3 / 4)) : srcHeight;
      const maxWidth = 1280;
      const maxHeight = 960;
      const intScale = Math.max(1, Math.min(3, Math.floor(maxWidth / baseWidth), Math.floor(maxHeight / baseHeight)));
      let targetWidth = baseWidth * intScale;
      let targetHeight = baseHeight * intScale;
      if (targetWidth > maxWidth || targetHeight > maxHeight) {
        const ratio = Math.min(maxWidth / targetWidth, maxHeight / targetHeight);
        targetWidth = Math.round(targetWidth * ratio);
        targetHeight = Math.round(targetHeight * ratio);
      }

      const offscreen = document.createElement("canvas");
      offscreen.width = targetWidth;
      offscreen.height = targetHeight;
      const offCtx = offscreen.getContext("2d");
      offCtx.imageSmoothingEnabled = false;
      offCtx.drawImage(canvas, 0, 0, canvas.width, canvas.height, 0, 0, targetWidth, targetHeight);

      if (typeof CompressionStream === "function") {
        const rgba = offCtx.getImageData(0, 0, targetWidth, targetHeight).data;
        encodeOptimizedPNG(rgba, targetWidth, targetHeight)
          .then((blob) => {
            if (blob) {
              callback(blob);
              return;
            }
            offscreen.toBlob(callback, "image/png");
          })
          .catch(() => {
            offscreen.toBlob(callback, "image/png");
          });
        return;
      }
      offscreen.toBlob(callback, "image/png");
    }
    const pngCrcTable = (() => {
      const table = new Uint32Array(256);
      for (let n = 0; n < 256; n++) {
        let c = n;
        for (let k = 0; k < 8; k++) {
          c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
        }
        table[n] = c >>> 0;
      }
      return table;
    })();
    function pngChunk(type, data) {
      const out = new Uint8Array(12 + data.length);
      new DataView(out.buffer).setUint32(0, data.length, false);
      for (let i = 0; i < 4; i++) out[4 + i] = type.charCodeAt(i);
      out.set(data, 8);
      let crc = 0xffffffff;
      for (let i = 4; i < 8 + data.length; i++) {
        crc = pngCrcTable[(crc ^ out[i]) & 0xff] ^ (crc >>> 8);
      }
      new DataView(out.buffer).setUint32(8 + data.length, (crc ^ 0xffffffff) >>> 0, false);
      return out;
    }
    async function encodeOptimizedPNG(rgba, width, height) {
      const paletteMap = new Map();
      const palette = [];
      let indexed = true;
      let lastRgb = -1;
      for (let i = 0; i < rgba.length; i += 4) {
        if (rgba[i + 3] !== 255) return null;
        if (!indexed) continue;
        const rgb = (rgba[i] << 16) | (rgba[i + 1] << 8) | rgba[i + 2];
        if (rgb === lastRgb) continue;
        if (!paletteMap.has(rgb)) {
          if (palette.length >= 256) {
            indexed = false;
          } else {
            paletteMap.set(rgb, palette.length);
            palette.push(rgb);
          }
        }
        lastRgb = rgb;
      }

      const bitDepth = !indexed ? 8 : (palette.length <= 2 ? 1 : (palette.length <= 16 ? 4 : 8));
      const colorType = indexed ? 3 : 2;
      const bpp = indexed ? 1 : 3;
      const rowBytes = indexed ? Math.ceil((width * bitDepth) / 8) : width * 3;
      const filtered = new Uint8Array(height * (1 + rowBytes));
      let curRow = new Uint8Array(rowBytes);
      let prevRow = new Uint8Array(rowBytes);

      for (let y = 0; y < height; y++) {
        const srcStart = y * width * 4;
        if (indexed) {
          curRow.fill(0);
          let rowLastRgb = -1;
          let rowLastIdx = 0;
          for (let x = 0; x < width; x++) {
            const p = srcStart + x * 4;
            const rgb = (rgba[p] << 16) | (rgba[p + 1] << 8) | rgba[p + 2];
            if (rgb !== rowLastRgb) {
              rowLastIdx = paletteMap.get(rgb);
              rowLastRgb = rgb;
            }
            if (bitDepth === 8) curRow[x] = rowLastIdx;
            else if (bitDepth === 4) curRow[x >> 1] |= rowLastIdx << ((1 - (x & 1)) * 4);
            else curRow[x >> 3] |= rowLastIdx << (7 - (x & 7));
          }
        } else {
          for (let x = 0; x < width; x++) {
            const p = srcStart + x * 4;
            const d = x * 3;
            curRow[d] = rgba[p];
            curRow[d + 1] = rgba[p + 1];
            curRow[d + 2] = rgba[p + 2];
          }
        }

        let same = y > 0;
        if (same) {
          for (let x = 0; x < rowBytes; x++) {
            if (curRow[x] !== prevRow[x]) {
              same = false;
              break;
            }
          }
        }
        const rowOut = y * (1 + rowBytes);
        if (same) {
          filtered[rowOut] = 2; // Up filter: repeated upscaled rows become zero bytes
        } else {
          filtered[rowOut] = 1; // Sub filter
          for (let x = 0; x < rowBytes; x++) {
            filtered[rowOut + 1 + x] = (curRow[x] - (x >= bpp ? curRow[x - bpp] : 0)) & 0xff;
          }
        }
        const tmp = prevRow;
        prevRow = curRow;
        curRow = tmp;
      }

      const compressed = new Uint8Array(
        await new Response(new Blob([filtered]).stream().pipeThrough(new CompressionStream("deflate"))).arrayBuffer()
      );
      const ihdr = new Uint8Array(13);
      const ihdrView = new DataView(ihdr.buffer);
      ihdrView.setUint32(0, width, false);
      ihdrView.setUint32(4, height, false);
      ihdr[8] = bitDepth;
      ihdr[9] = colorType;

      const parts = [new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10]), pngChunk("IHDR", ihdr)];
      if (indexed) {
        const plte = new Uint8Array(palette.length * 3);
        for (let i = 0; i < palette.length; i++) {
          plte[i * 3] = (palette[i] >> 16) & 0xff;
          plte[i * 3 + 1] = (palette[i] >> 8) & 0xff;
          plte[i * 3 + 2] = palette[i] & 0xff;
        }
        parts.push(pngChunk("PLTE", plte));
      }
      parts.push(pngChunk("IDAT", compressed), pngChunk("IEND", new Uint8Array(0)));
      return new Blob(parts, { type: "image/png" });
    }
    function downloadBlob(blob, downloadName) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = downloadName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }
    function screenshot(filename = 'screenshot') {
      console.log(`screenshot: for canvas of ${filename}`);
      captureCanvasBlob((blob) => {
        if (!blob) return;
        downloadBlob(blob, `${filename}.png`);
      });
    }
    function startBinary(options) {
      Dos(canvas, options).ready((fs, main) => {
        fs.createFile("dosbox.conf", "{{$config}}");      // create DOSBox configuration file in virtual file system
        fetch("/d/{{$download}}")                         // fetch the artifact file download
          .then((response) => {
            if (!response.ok) {
              throw new Error(`Failed to fetch binary (${response.status})`);
            }
            return response.arrayBuffer();
          })
          .then((arrayBuffer) => {
            fs.createFile("{{$filename}}", arrayBuffer);  // recreate file in virtual file system
            return main(startDOS);
          })
          .then((ci) => {
            onEmulatorReady(ci);
          })
          .catch((error) => {
            console.error("js-dos binary start error:", error);
          });
      });
    }
    function startZip(options) {
      Dos(canvas, options).ready((fs, main) => {
        fs.createFile("dosbox.conf", "{{$config}}");      // create DOSBox configuration file in virtual file system
        console.log("{{$config}}");                       // print the configuration file to the console
        if (loadUtils === "true") {
          mountApp.push(mountDOS4GW);                     // mount the DOS4GW.EXE file
        }
        fs.extractAll(mountApp)                           // download and extract the artifact and any utilities
          .then(() => {
            let params = startDOS;
            if (loadUtils === "true") {
              params = startWithDOS4GW;
            }
            return main(params);                          // start the application
          })
          .then((ci) => {
            onEmulatorReady(ci);
          })
          .catch((error) => {
            console.error("js-dos zip start error:", error);
          });
      });
    }
    const jsdos = document.getElementById("js-dos-run-app");
    jsdos.addEventListener("click", function () {
      this.style.pointerEvents = "none";
      this.textContent = "Running app";
      const DosBoxConfig = {
        wdosboxUrl: "/js/wdosbox.js",
        cycles: "auto", // int value, "max" or "auto"
        autolock: false,
      };
      {{$runJS | safeJS}}
    });
    const jsQuitButtons = document.getElementsByName("jsdosCloser");
    for (let i = 0; i < jsQuitButtons.length; i++) {
      jsQuitButtons[i].addEventListener("click", () => {
        location.reload();
      });
    }
</script>
{{- end}}{{ end }}
