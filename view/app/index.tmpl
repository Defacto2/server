  <div class="milestone-toolbar d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 mb-4" role="toolbar" aria-label="Filter milestones">
    <div class="d-flex flex-wrap align-items-center gap-1" role="group" aria-label="Filter by decade">
      <button type="button" class="btn btn-sm btn-primary" data-decade-filter="all" aria-pressed="true">All</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-decade-filter="1970s" aria-pressed="false">1970s</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-decade-filter="1980s" aria-pressed="false">1980s</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-decade-filter="1990s" aria-pressed="false">1990s</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-decade-filter="2000s" aria-pressed="false">2000s+</button>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-3">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="milestone-highlights-only">
        <label class="form-check-label small fw-medium" for="milestone-highlights-only">Highlights only</label>
      </div>
      <span id="milestone-count" class="font-monospace small text-body-secondary">
        {{len .milestones}} of {{len .milestones}} milestones
      </span>
    </div>
  </div>

{{- /*
  <!-- to add 3 columns, use class "row-cols-xl-3" -->
*/ -}}
<div id="milestone-grid" class="row row-cols-1 row-cols-lg-2 g-4">
{{- range $index, $mile := .milestones }}
  {{- $unique := slugify .Title }}
  {{- if eq $unique "the-first-copy-protections" }}{{ $unique = printf "%s-%d" $unique .Year }}<!-- hack to fix the use of two identical titles -->{{ end}}
  {{- $decade := "2000s" }}
  {{- if lt .Year 1980 }}{{ $decade = "1970s" }}
  {{- else if lt .Year 1990 }}{{ $decade = "1980s" }}
  {{- else if lt .Year 2000 }}{{ $decade = "1990s" }}{{ end }}
  <div class="col milestone-item" data-decade="{{$decade}}" data-highlight="{{if .Highlight}}true{{else}}false{{end}}">
    {{- if ne "" $unique}}<a id="{{$unique}}" class="milestone-anchor"></a>{{- end}}
    <div class="card h-100 milestone-card{{ if .Highlight}} featured{{end}}">
      {{- /*  Header  */}}
      <div class="card-header milestone-card-header px-3 py-2">
        <button id="milestone-{{$index}}" type="button" class="btn btn-link p-0 w-100 text-start text-decoration-none stretched-link d-flex align-items-center justify-content-between gap-2"
                data-bs-toggle="modal" data-bs-target="#milestoneModal">
          <span class="milestone-date font-monospace">
            {{fmtPrefix .Prefix}}<strong>{{.Year}}</strong>{{fmtMonth .Month}}{{fmtDay .Day}}
          </span>
          <span class="d-inline-flex align-items-center gap-2 flex-shrink-0">
            {{- if .Highlight}}<span class="badge milestone-highlight-badge fw-medium">Highlight</span>{{- end}}
            <span class="milestone-expand-cue small">Read ↗</span>
          </span>
        </button>
      </div>
      {{- /*  Lists, aligned to the top  */}}
      {{- if and (.List) (eq "" .Content)}}
      <ul class="list-group list-group-flush milestone-list">
        {{- range .List}}
        <li class="list-group-item px-3 py-2">
          {{- if ne "" .Forward }}<div class="small text-body-secondary text-break">{{.Forward}}</div>{{- end}}
          <a href="{{.Link}}" class="{{$listCls}} fw-medium">
            {{- if ne "" .Forward }}{{mergeIcon}}{{end}}
            <span class="text-break">{{.LinkTitle | safeHTML}}</span>
            {{- if ne "" .SubTitle }} <span class="font-monospace small text-body-secondary">({{.SubTitle}})</span>{{end}}
          </a>
        </li>
        {{- end}}
      </ul>
      {{- end}}
      {{- /*  Card body  */}}
      {{- if or (ne "" .Title) (ne "" .Content) (ne "" .Link) (ne "" .Picture.Attribution)}}
      <div class="card-body d-flex flex-column p-3 p-md-4">
        {{- if (ne "" .Title)}}
        <h3 class="h5 card-title fw-semibold mb-2">
          {{.Title}}
          {{- if ne "" .Lead}}<span class="d-block fs-6 fw-normal text-body-secondary mt-1">{{.Lead}}</span>{{- end}}
        </h3>
        {{- end}}
        {{- if (ne "" .Content)}}
        <div class="card-text milestone-body my-2">{{.Content | safeHTML}}</div>
        {{- end}}
        {{- if or (ne "" .Link) (ne "" .Picture.Attribution)}}
        <div class="milestone-meta mt-auto pt-2 border-top small text-body-secondary">
          {{- if ne "" .Link}}<div><a href="{{.Link}}" class="link-offset-2 link-underline link-underline-opacity-50">Read {{.LinkTitle}}</a></div>{{- end}}
          {{- if ne "" .Picture.Attribution}}
          <div>
            Photo by {{.Picture.Attribution}} ·
            <a href="{{.Picture.LicenseLink}}" class="link-offset-2 link-underline link-underline-opacity-50">{{.Picture.License}}</a>
          </div>
          {{- end}}
        </div>
        {{- end}}
      </div>
      {{- end}}
      {{- /*  Lists, aligned to the bottom  */}}
      {{- if and (.List) (ne "" .Content)}}
      <ul class="list-group list-group-flush milestone-list">
        {{- range .List}}
        <li class="list-group-item px-3 py-2">
          {{- if ne "" .Forward }}<div class="small text-body-secondary text-break">{{.Forward}}</div>{{- end}}
          <a href="{{.Link}}" class="{{$listCls}} fw-medium">
            {{- if ne "" .Forward }}{{mergeIcon}}{{end}}
            <span class="text-break">{{.LinkTitle | safeHTML}}</span>
            {{- if ne "" .SubTitle }} <span class="font-monospace small text-body-secondary">({{.SubTitle}})</span>{{end}}
          </a>
        </li>
        {{- end}}
      </ul>
      {{- end}}
      {{- /*  Footer  */}}
      {{- if ne "" .Picture.Webm }}
      {{- $poster := .Picture.Webp }}{{- if eq "" $poster }}{{- $poster = .Picture.Png }}{{- end }}
      <div class="card-footer milestone-media text-center bg-dark p-2">
        <video autoplay muted loop controls playsinline class="img-fluid rounded-1" title="{{.Picture.Title}}"{{- if ne "" $poster }} poster="/image/milestone/{{$poster}}"{{- end }}>
          <source src="/image/milestone/{{.Picture.Webm}}" type="video/webm">
        </video>
      </div>
      {{- else if or (ne "" .Picture.Png) (ne "" .Picture.Jpg)}}
      <div class="card-footer milestone-media text-center p-2">
      <picture title="{{.Picture.Title}}">
        {{- if ne "" .Picture.Avif}}
        <source srcset="/image/milestone/{{.Picture.Avif}}" type="image/avif">
        {{- end}}
        {{- if ne "" .Picture.Webp}}
        <source srcset="/image/milestone/{{.Picture.Webp}}" type="image/webp">
        {{- end}}
        {{- if ne "" .Picture.Jpg}}
        <img src="/image/milestone/{{.Picture.Jpg}}" loading="lazy" class="img-fluid rounded-1" alt="{{.Picture.Alt}}">
        {{- else if ne "" .Picture.Png}}
        <img src="/image/milestone/{{.Picture.Png}}" loading="lazy" class="img-fluid rounded-1" alt="{{.Picture.Alt}}">
        {{- end}}
      </picture></div>
      {{- end}}
    </div>
  </div>
{{- end}}
</div>
</section>
{{- /* 
  Milestone Modal Pop-up
  When a milestone title or date is clicked, this modal pops up with a copy of the milestone content.
  This allows for easier readability due to the use of the "lead" class for the font.
  This modal is handled by assets/js/index.js
*/}}
<div class="modal fade" id="milestoneModal" tabindex="-1" aria-labelledby="milestoneModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-body-tertiary">
        <h2 class="modal-title fs-5 font-monospace" id="milestoneModalLabel">Milestone Details</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="milestoneModalBody">
        <!-- Content will be loaded here -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
{{- end}}
