{{- /* 
    artifact.tmpl ~ A layout for the artifact page for a single file record.
*/ -}}
{{- define "content" }}
{{- $published := index . "published"}}
{{- $description := index . "description"}}
{{- $classification := brief (index . "platform") (index . "section")}}
{{- $screenElm := screenshot (index . "unid") ($description)}}
{{- $screenNone := index . "screenshotNone"}}
{{- $web := index . "webCheck"}}
{{- $topaz := index . "topazCheck"}}
{{- $vga := index . "vgaCheck"}}
{{- $mimetype := index . "magic"}}
{{- $alertURL := index . "alertURL"}}
{{- $noDownload := index . "noDownload"}}
{{- $readmeName := index . "readmeName"}}
{{- $alert := false}}
{{- if or $alertURL $noDownload}}{{$alert = true}}{{end}}
{{- $columnClass := "col-12 col-md-6"}}
{{- /*  Info:
        The following are for text the "ANSI or binary textfile",
        and the "Textfile content"
*/ -}}
{{- $textcontentBinary := index . "contentBinary" }}
{{- $textcontentLatin1 := "" }}
{{- $textcontentCP437 := index . "" }}
{{- $textcontentUTF8 := index . "" }}
{{- /* To add more conditonals, see: Safety() in app.go */ -}}
{{- $useDoc := safety (index . "platform")  (index . "section") }}
{{- $force := index . "forceSimpleText"}}
{{- if or (eq true $useDoc) (eq true $force) }}
  {{- $textcontentLatin1 = index . "contentLatin1" | safeDocument }}
  {{- $textcontentCP437 = index . "contentCP437" | safeDocument }}
  {{- $textcontentUTF8 = index . "contentUTF8" | safeDocument }}
{{- else}}
  {{- $textcontentLatin1 = index . "contentLatin1" | safeBBS }}
  {{- $textcontentCP437 = index . "contentCP437" | safeBBS }}
  {{- $textcontentUTF8 = index . "contentUTF8" | safeBBS }}
{{- end}}
{{- $preclassUTF8 := index . "preClassUTF8" }}
{{- $preclassLatin1 := index . "preClassLatin1" }}
{{- $preclassCP437 := index . "preClassCP437" }}
{{- $preClass := index . "preElementClass" }}
{{- $contentBinarySwappers := index . "contentBinarySwappers" }}
{{- $customFont := index . "customFont" }}
{{- /*  Info: 
        The title, releasers (as lead) and monospaced filename are generated by 
        Artifact() within dirs.go context and rendered in the layout.tmpl view. 
*/ -}}
<div class="container-xxl">
    <div class="row g-2">
        {{- if $alert}}
        {{- /*  End user alerts  */}}
        <div class="alert alert-light" role="alert">
            {{- if ne $alertURL "" }}
            Google or Microsoft Defender flags this artifact download as <a href="{{$alertURL}}">unwanted software</a>.{{end}}
            {{- if and (ne $alertURL "") ($noDownload) }}<br>{{end}}
            {{- if $noDownload}}Error, the server cannot locate the file download.{{end}}
            <hr>
        </div>
        {{- end}}
        {{- /*  Editor buttons  */}}
        {{- template "artifactlock" . }}
        <div class="{{$columnClass}}">
            {{- /*  Lead including published, platform and section  */}}
            <h4 class="lead mb-4">{{$published}}<span class="text-secondary">, {{$classification}} 
            {{- if eq true (index . "editor")}}<small> admin : {{ index . "platform"}} / {{ index . "section"}}</small>{{end}}</span></h4>
            {{- /*  Table of details  */}}
            {{- template "artifactinfo" . }}
        </div>
        {{- if not $screenNone}}
        <style>
          @media (min-width: 576px) {
            .artifact-lightbox-dialog {
              --bs-modal-width: fit-content;
              min-width: min(320px, 92vw);
              max-width: 92vw;
            }
          }
          .artifact-lightbox-stage > picture,
          .artifact-lightbox-stage > img {
            margin: auto;
          }
          .artifact-lightbox-stage img {
            max-width: 100%;
            max-height: calc(100vh - 7rem);
            width: auto;
            height: auto;
          }
          .artifact-lightbox-stage.is-actual img {
            max-width: none;
            max-height: none;
          }
        </style>
        <div class="{{$columnClass}}">
            {{- /*  Screenshot of the file  */}}
            <div class="p-3 text-center">
                <button type="button" class="btn btn-link p-0 border-0 d-block mx-auto text-decoration-none"
                    data-bs-toggle="modal" data-bs-target="#artifact-screenshot-modal" aria-label="Enlarge preview image">{{$screenElm}}</button>
            </div>
        </div>
        {{- /*  Minimal image-sized lightbox modal  */}}
        <div class="modal fade" id="artifact-screenshot-modal" tabindex="-1" aria-labelledby="artifact-screenshot-modal-label" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered modal-dialog-scrollable artifact-lightbox-dialog">
                <div class="modal-content bg-black text-white border-secondary">
                    <div class="modal-header border-0 bg-dark bg-opacity-75 py-2 px-3 gap-2">
                        <h5 class="modal-title fs-6 fw-normal text-truncate mb-0 flex-grow-1" style="width: 0;" id="artifact-screenshot-modal-label">{{$description}}</h5>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <button type="button" id="artifact-lightbox-zoom" class="btn btn-sm btn-outline-light d-none">Actual size</button>
                            <button type="button" class="btn-close btn-close-white m-0" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                    <div class="modal-body p-2 overflow-auto d-flex artifact-lightbox-stage" id="artifact-lightbox-stage">{{$screenElm}}</div>
                </div>
            </div>
        </div>
        <script>
          (() => {
            const modalEl = document.getElementById('artifact-screenshot-modal');
            const stage = document.getElementById('artifact-lightbox-stage');
            const zoomBtn = document.getElementById('artifact-lightbox-zoom');
            if (!modalEl || !stage || !zoomBtn) return;
            const img = stage.querySelector('img');
            function setActual(actual) {
              stage.classList.toggle('is-actual', actual);
              zoomBtn.textContent = actual ? 'Fit to screen' : 'Actual size';
            }
            function syncZoomVisibility() {
              if (!img || !img.complete || img.naturalWidth === 0) {
                zoomBtn.classList.add('d-none');
                return;
              }
              const isScaled = stage.classList.contains('is-actual') ||
                img.naturalWidth > img.clientWidth ||
                img.naturalHeight > img.clientHeight;
              zoomBtn.classList.toggle('d-none', !isScaled);
            }
            zoomBtn.addEventListener('click', () => {
              setActual(!stage.classList.contains('is-actual'));
            });
            stage.addEventListener('click', (event) => {
              if (event.target === stage) {
                bootstrap.Modal.getOrCreateInstance(modalEl).hide();
              }
            });
            if (img) {
              img.addEventListener('load', () => {
                if (modalEl.classList.contains('show')) syncZoomVisibility();
              });
            }
            window.addEventListener('resize', () => {
              if (modalEl.classList.contains('show') && !stage.classList.contains('is-actual')) {
                syncZoomVisibility();
              }
            });
            modalEl.addEventListener('shown.bs.modal', syncZoomVisibility);
            modalEl.addEventListener('hidden.bs.modal', () => {
              setActual(false);
              zoomBtn.classList.add('d-none');
            });
          })();
        </script>
        {{- end}}
        <style>.font-large{font-size:131%;line-height:100%;}</style>
        {{- $isAmigaBinary := and (eq (index . "platform") "textamiga") ($textcontentBinary) }}
        {{- $isOtherBinary := and (not $isAmigaBinary) ($textcontentBinary) }}
        {{- $isReadme := or ($textcontentLatin1) ($textcontentCP437) }}
        {{- if or $isAmigaBinary $isOtherBinary $isReadme }}
        <div class="col-12 mt-2">
          <h6 class="text-body-secondary fs-6 fw-normal mb-2">
            {{- if $isAmigaBinary}}Commodore Amiga ANSI text
            {{- else if $isOtherBinary}}
              {{- if $customFont}}XBIN or ICEDraw text{{else}}ANSI encoded or binary text{{end}}
              {{- if $customFont}} <small class="text-body-tertiary ms-1">This file includes custom fonts that cannot be shown in browser.</small>{{end}}
            {{- else if not $screenNone}}Readme or information text{{if $readmeName}} <small class="text-body-tertiary font-monospace ms-1">{{$readmeName}}</small>{{end}}
            {{- else}}Textfile content
            {{- end}}
          </h6>
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 bg-body-tertiary border rounded px-3 py-2 mb-2">
            {{- if $isAmigaBinary}}
            <div class="d-flex align-items-center gap-2">
              <span class="small text-secondary">Font</span>
              <div class="btn-group btn-group-sm" role="group" aria-label="Font">
                <button type="button" id="textcontBtnTopaz" class="btn btn-outline-secondary active">Topaz</button>
                <button type="button" id="textcontBtnMicroKnight" class="btn btn-outline-secondary">MicroKnight</button>
              </div>
            </div>
            {{- else if and $isOtherBinary (eq true $contentBinarySwappers)}}
            <div class="d-flex align-items-center gap-2">
              <span class="small text-secondary">Display</span>
              <div class="btn-group btn-group-sm" role="group" aria-label="Display style">
                <button type="button" id="textcontBtnZoom" class="btn btn-outline-secondary active">Zoom</button>
                <button type="button" id="textcontBtn16px" class="btn btn-outline-secondary">16 px</button>
                <button type="button" id="textcontBtn08px" class="btn btn-outline-secondary">8 px</button>
              </div>
            </div>
            {{- else if $isReadme}}
            <div class="d-flex align-items-center gap-2">
              <span class="small text-secondary">Style</span>
              <div class="btn-group btn-group-sm" role="group" aria-label="Display style">
                <input type="radio" class="btn-check" name="readme-base" id="textcontBtnWeb" rel="nofollow" autocomplete="off"{{if ne $web ""}} {{$web}}{{end}}>
                <label class="btn btn-outline-secondary" for="textcontBtnWeb"
                  data-bs-toggle="tooltip" data-bs-title="Use the Cascadia Mono font with UTF-8 encoding">Web</label>
                <input type="radio" class="btn-check" name="readme-base" id="textcontBtnAmiga" rel="nofollow" autocomplete="off"{{if ne $topaz ""}} {{$topaz}}{{end}}>
                <label class="btn btn-outline-secondary" for="textcontBtnAmiga"
                  data-bs-toggle="tooltip" data-bs-title="Use the TopazPlus font with Latin-1 encoding">Amiga</label>
                <input type="radio" class="btn-check" name="readme-base" id="textcontBtnDOS" rel="nofollow" autocomplete="off"{{if ne $vga ""}} {{$vga}}{{end}}>
                <label class="btn btn-outline-secondary" for="textcontBtnDOS"
                  data-bs-toggle="tooltip" data-bs-title="Use a classic IBM VGA font with OEM-US encoding">DOS</label>
              </div>
            </div>
            {{- end}}
            <div class="d-flex align-items-center gap-2 ms-auto">
              {{- if $isReadme}}
              <input type="checkbox" class="btn-check" id="toggle-pre-wrap" autocomplete="off">
              <label class="btn btn-sm btn-outline-secondary" for="toggle-pre-wrap"
                data-bs-toggle="tooltip" data-bs-title="Overflow text wrapping">Wrap text</label>
              {{- end}}
              <button type="button" class="btn btn-sm btn-outline-secondary" id="artifact-copy-textbody"
                data-bs-toggle="tooltip" data-bs-title="Copy the text to the clipboard" rel="nofollow">Copy text</button>
            </div>
          </div>
          {{- if or $isAmigaBinary $isOtherBinary}}
          <pre id="precontentBinary" class="{{$preClass}}">{{$textcontentBinary}}</pre>
          {{- end}}
          {{- if $isReadme}}
          {{- if $textcontentUTF8 -}}
          <pre id="precontentUTF8" class="{{$preclassUTF8}}font-cascadia-mono render {{$preClass}}">{{$textcontentUTF8}}</pre>
          {{- end -}}
          {{- if $textcontentLatin1 -}}
          <pre id="precontentLatin1" style="background-color:#999;color:#000;" class="{{$preclassLatin1}} font-amiga font-large render {{$preClass}}">{{$textcontentLatin1}}</pre>
          {{- end -}}
          {{- if $textcontentCP437 -}}
          <pre id="precontentCP437" class="{{$preclassCP437}} render {{$preClass}}">{{$textcontentCP437}}</pre>
          {{- end -}}
          {{- end}}
        </div>
        {{- end}}
    </div>
</div>
{{- template "artifactjsdos" . }}
{{- template "artifactfile" . }}
{{- template "artifactedit" . }}
{{- template "artifacteditjsdos" . }}
{{- end}}
