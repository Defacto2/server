{{- /*  layoutup_null.tmpl  */}}
{{- define "layoutup" -}}
{{- $lock := index . "editor" }}
<div class="btn-group ms-lg-auto my-2 my-lg-0">
  <button class="btn btn-sm {{if eq true $lock}}btn-outline-warning{{else}}btn-outline-secondary{{end}} dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
    {{- if ne true $lock}}Uploader{{else}}Site editor{{end}}
  </button>
  <ul class="dropdown-menu dropdown-menu-lg-end">
      {{- template "layoutlock" . }}
      <li><h6 class="dropdown-header">Sorry, the database is read-only or offline</h6></li>
    </ul>
</div>{{end}}
