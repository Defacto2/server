                  <div class="input-group input-group-sm">
                    <span class="input-group-text uploader-credit-label" id="uploader-advanced-credit-ill-help">Visual artists</span>
                    <input type="text" name="uploader-advanced-creditill" class="form-control" id="uploader-advanced-credit-ill"
                      aria-describedby="uploader-advanced-credit-ill-help" spellcheck="false" placeholder="Name1, Name2">
                  </div>
                </div>
                <div class="col">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text uploader-credit-label" id="uploader-advanced-credit-prog-help">Programmers</span>
                    <input type="text" name="uploader-advanced-creditprog" class="form-control" id="uploader-advanced-credit-prog"
                      aria-describedby="uploader-advanced-credit-prog-help" spellcheck="false" placeholder="Name1, Name2">
                  </div>
                </div>
                <div class="col">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text uploader-credit-label" id="uploader-advanced-credit-audio-help">Musicians</span>
                    <input type="text" name="uploader-advanced-creditaudio" class="form-control" id="uploader-advanced-credit-audio"
                      aria-describedby="uploader-advanced-credit-audio-help" spellcheck="false" placeholder="Name1, Name2">
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-1">
                  <label for="uploader-advanced-file" class="form-label small fw-medium mb-0">
                    File or archive <span class="text-danger" aria-hidden="true">*</span>
                  </label>
                  <span class="form-text mt-0">{{$screenshot}}</span>
                </div>
                <input type="file" name="uploader-advancedfile" id="uploader-advanced-file" class="form-control" required>
                <div class="d-none alert alert-danger mt-2 mb-0" role="alert" id="uploader-advanced-alert"></div>
                <progress id="uploader-advanced-progress" class="w-100 mt-2" value="0" max="100"></progress>
              </div>

              <div class="d-none alert alert-primary mb-3" role="alert" id="uploader-advanced-results"
                   hx-swap="innerHTML" hx-on:htmx:after:swap="this.classList.remove('d-none')"></div>

              <div class="border-top pt-3 d-flex align-items-center gap-2">
                <button type="submit" id="uploader-advanced-submit" class="btn btn-success">Upload</button>
                <button type="button" id="uploader-advanced-reset" class="btn btn-outline-danger">Reset</button>
                <button type="button" class="btn btn-outline-secondary ms-auto" data-bs-dismiss="modal">Close</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
{{- end }}
