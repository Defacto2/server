{{- /* 
    uploader_modal.tmpl ~ About the htmx uploader modals.
*/ -}}
{{- define "uploadermodal" -}}
{{- /*  
    To add a new form the following JS steps are required for the form element.
    - `uploader-xxxx.mjs`, a dedicated module must be created to handle the form submission.
    - `uploader.js`, a progress(`uploader-xxxx-form`, `uploader-xxxx-progress`) method to show the upload progress.
    - `layout-htmx.js`, a `afterRequest()` method must be used to handle the server response.
  - */}}
{{- $screenshot := "A screenshot can be included in the archive"}}
{{- $releasername := index . "uploader-releaser-index"}}
{{- $delay := "200ms" }}
{{- $helpRelr := "A releaser can be a group name, bulletin board or ftp site.<br>BBS names and ftp sites must end with <code>BBS</code> or <code>FTP</code>, for example: <em>Dark Domain BBS</em> or <em>Dark Domain FTP</em>" }}
    {{- /*  check if the event is a KeyboardEvent to prevent double rendering on datalists
            source: https://turriate.com/articles/using-datalist-for-typeahead-htmx  */ -}}
    <script>
      function checkUserKeydown(event) {
        return event instanceof KeyboardEvent
      }
    </script>
    {{- /*  demozoo production or graphic  */}}
    <div class="modal fade" id="uploader-demozoo-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="uploader-demozoo-label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header bg-body-tertiary">
            <h2 class="modal-title fs-5" id="uploader-demozoo-label">Demozoo <span class="text-body-secondary fw-normal">production, or graphic</span></h2>
            <button type="button" id="demozoo-submission-close" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <form>
              <p class="text-body-secondary small mb-3">
                Know a <a href="https://demozoo.org/productions/?platform=1" target="_blank" rel="noopener">Windows</a>,
                <a href="https://demozoo.org/productions/?platform=4" target="_blank" rel="noopener">MS-DOS</a> production or a
                <a href="https://demozoo.org/graphics/" target="_blank" rel="noopener">graphic</a> on
                <a href="https://demozoo.org" target="_blank" rel="noopener">Demozoo</a> that should be on this site?
                Submit its ID.
              </p>
              <label for="demozoo-submission" id="demozoo-submission-label" class="form-label small fw-medium mb-1">Demozoo production ID</label>
              <div class="input-group">
                <input type="number" spellcheck="false" required min="1" max="{{ demozooSanity }}" value=""
                    class="form-control" id="demozoo-submission" name="demozoo-submission"
                    hx-get="/demozoo/production"
                    hx-status:4xx="target:#demozoo-submission-error swap:innerHTML"
                    hx-status:5xx="target:#demozoo-submission-error swap:innerHTML"
                    hx-target="#demozoo-submission-results"
                    hx-swap="innerHTML"
                    hx-trigger="input changed delay:{{$delay}}, search"
                    hx-indicator="#demozoo-indicator"
                    hx-validate="true"
                    placeholder="Lookup a production…">
                <button type="reset" id="demozoo-submission-clear" class="btn btn-outline-secondary">Clear</button>
              </div>
              <div id="demozoo-indicator" class="htmx-indicator text-body-secondary small pt-2" role="status">
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Fetching data from Demozoo...</span>
              </div>
            </form>
            <div id="demozoo-submission-error" class="d-none alert alert-danger mt-3 mb-0" role="alert"></div>
            <div id="demozoo-submission-results" class="mt-3"></div>
            <div class="border-top mt-3 pt-3 d-flex justify-content-end">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{- /*  pouët production  */}}
    <div class="modal fade" id="uploader-pouet-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="uploader-pouet-label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header bg-body-tertiary">
            <h2 class="modal-title fs-5" id="uploader-pouet-label">Pouët <span class="text-body-secondary fw-normal">Windows or DOS production</span></h2>
            <button type="button" id="pouet-submission-close" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <form>
              <p class="text-body-secondary small mb-3">
                Know a <a href="https://www.pouet.net/prodlist.php?platform%5B%5D=Windows&page=1" target="_blank" rel="noopener">Windows</a> or
                <a href="https://www.pouet.net/prodlist.php?platform%5B%5D=MS-Dos&page=1" target="_blank" rel="noopener">MS-DOS</a> production
                on <a href="https://www.pouet.net" target="_blank" rel="noopener">Pouët</a> that should be on this site? Submit its ID.
              </p>
              <label for="pouet-submission" id="pouet-submission-label" class="form-label small fw-medium mb-1">Pouët production ID</label>
              <div class="input-group">
                <input type="number" spellcheck="false" required min="1" max="{{ pouetSanity }}" value=""
                    class="form-control" id="pouet-submission" name="pouet-submission"
                    hx-get="/pouet/production"
                    hx-status:4xx="target:#pouet-submission-error swap:innerHTML"
                    hx-status:5xx="target:#pouet-submission-error swap:innerHTML"
                    hx-target="#pouet-submission-results"
                    hx-swap="innerHTML"
                    hx-trigger="input changed delay:{{$delay}}, search"
                    hx-indicator="#pouet-indicator"
                    hx-validate="true"
                    placeholder="Lookup a production…">
                <button type="reset" id="pouet-submission-clear" class="btn btn-outline-secondary">Clear</button>
              </div>
              <div id="pouet-indicator" class="htmx-indicator text-body-secondary small pt-2" role="status">
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Fetching data from Pouët...</span>
              </div>
            </form>
            <div id="pouet-submission-error" class="d-none alert alert-danger mt-3 mb-0" role="alert"></div>
            <div id="pouet-submission-results" class="mt-3"></div>
            <div class="border-top mt-3 pt-3 d-flex justify-content-end">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{- /*  intro, cracktro, bbs/ftptro  */}}
    <div class="modal fade" id="uploader-intro-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="uploader-intro-label" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header bg-body-tertiary">
            <h2 class="modal-title fs-5" id="uploader-intro-label">Intro <span class="text-body-secondary fw-normal">or cracktro, or BBStro, or sitetro</span></h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <form id="uploader-intro-form"
                  hx-encoding="multipart/form-data"
                  hx-post="/uploader/intro"
                  hx-target="#uploader-intro-results"
                  hx-disable="#uploader-intro-submit"
                  hx-config="timeout:0"
                  hx-status:4xx="target:#uploader-intro-alert swap:innerHTML"
                  hx-status:5xx="target:#uploader-intro-alert swap:innerHTML"
                  hx-validate="true"
                  hx-swap="innerHTML">
              <input type="hidden" name="uploader-intro-lastmodified" id="uploader-intro-last-modified">
              <input type="hidden" name="uploader-intro-magic" id="uploader-intro-magic">

              <div class="row g-3 mb-3">
                <div class="col-md-7">
                  <label for="uploader-intro-title" class="form-label small fw-medium mb-1">
                    Title <span class="text-body-secondary fw-normal">(optional)</span>
                  </label>
                  <input type="text" name="uploader-intro-title" class="form-control" id="uploader-intro-title"
                    aria-describedby="uploader-intro-title-help" placeholder="example: 500000th release!">
                  <div id="uploader-intro-title-help" class="form-text">Name of the release or a brief description</div>
                </div>
                <div class="col-md-5">
                  <div class="form-label small fw-medium mb-1">Date of release <span class="text-body-secondary fw-normal">(optional)</span></div>
                  <div class="input-group">
                    <input type="number" name="uploader-intro-year" min="1980" max="{{exampleYear}}"
                      id="uploader-intro-year" aria-label="Year of release" class="form-control input-date" placeholder="{{exampleYear}}">
                    <input type="number" name="uploader-intro-month" min="1" max="12"
                      id="uploader-intro-month" aria-label="Month of release" class="form-control input-date" placeholder="{{exampleMonth}}">
                  </div>
                  <div class="form-text">Year and month</div>
                </div>
              </div>

              <div class="mb-3">
                <label for="uploader-intro-releaser-1" class="form-label small fw-medium mb-1">
                  Releasers <span class="text-danger" aria-hidden="true">*</span> <span class="text-body-secondary fw-normal">(maximum of 2)</span>
                </label>
                <div class="input-group">
                  <input type="text" list="uploader-intro-list-1" name="uploader-intro-releaser1" class="form-control" id="uploader-intro-releaser-1"
                      aria-describedby="uploader-intro-releasers-help" placeholder="example: Razor 1911" value="{{$releasername}}"
                      hx-patch="/uploader/releaser/1"
                      hx-trigger="keyup[checkUserKeydown.call(this, event)] changed delay:{{$delay}}"
                      hx-target="#uploader-intro-list-1"
                      required>
                  <span class="input-group-text">+</span>
                  <input type="text" list="uploader-intro-list-2" name="uploader-intro-releaser2" class="form-control" id="uploader-intro-releaser-2"
                      aria-describedby="uploader-intro-releasers-help" placeholder="example: Titan (optional)"
                      hx-patch="/uploader/releaser/2"
                      hx-trigger="keyup[checkUserKeydown.call(this, event)] changed delay:{{$delay}}"
                      hx-target="#uploader-intro-list-2">
                </div>
                <datalist id="uploader-intro-list-1"></datalist>
                <datalist id="uploader-intro-list-2"></datalist>
                <div id="uploader-intro-releasers-help" class="form-text">{{$helpRelr|safeHTML}}</div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-5">
                  <label for="uploader-intro-youtube" class="form-label small fw-medium mb-1">
                    YouTube ID <span class="text-body-secondary fw-normal">(optional)</span>
                  </label>
                  <input type="text" name="uploader-intro-youtube" minlength="11" maxlength="11" class="form-control" id="uploader-intro-youtube"
                    aria-describedby="uploader-intro-youtube-help" spellcheck="false" placeholder="example: 62BuDfBIcMo">
                  <div id="uploader-intro-youtube-help" class="form-text">11-character YouTube video ID</div>
                </div>
                <div class="col-md-7">
                  <div class="form-label small fw-medium mb-1">Operating system</div>
                  <div class="btn-group w-100" role="group" aria-label="Operating system selection">
                    <input type="radio" value="{{tagDOS}}" class="btn-check" name="uploader-intro-operating-system" id="uploader-intro-msdos" checked>
                    <label class="btn btn-outline-primary" for="uploader-intro-msdos" data-bs-toggle="tooltip" data-bs-placement="top"
                        data-bs-title="IBM&nbsp;PC or MS-DOS compatible">DOS PC</label>
                    <input type="radio" value="{{tagWindows}}" class="btn-check" name="uploader-intro-operating-system" id="uploader-intro-windows">
                    <label class="btn btn-outline-primary" for="uploader-intro-windows" data-bs-toggle="tooltip" data-bs-placement="top"
                        data-bs-title="Microsoft&nbsp;Windows">Windows PC</label>
                    <input type="radio" value="{{tagConsole}}" class="btn-check" name="uploader-intro-operating-system" id="uploader-intro-console">
                    <label class="btn btn-outline-primary" for="uploader-intro-console" data-bs-toggle="tooltip" data-bs-placement="top"
                        data-bs-title="1990s era consoles and handhelds">'90s console</label>
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-1">
                  <label for="uploader-intro-file" class="form-label small fw-medium mb-0">
                    File or archive <span class="text-danger" aria-hidden="true">*</span>
                  </label>
                  <span class="form-text mt-0">{{$screenshot}}</span>
                </div>
                <input type="file" name="uploader-introfile" id="uploader-intro-file" class="form-control" required>
                <div class="d-none alert alert-danger mt-2 mb-0" role="alert" id="uploader-intro-alert"></div>
                <progress id="uploader-intro-progress" class="w-100 mt-2" value="0" max="100"></progress>
              </div>

              <div class="d-none alert alert-primary mb-3" role="alert" id="uploader-intro-results"
                   hx-swap="innerHTML" hx-on:htmx:after:swap="this.classList.remove('d-none')"></div>

              <div class="border-top pt-3 d-flex align-items-center gap-2">
                <button type="submit" id="uploader-intro-submit" class="btn btn-success">Upload</button>
                <button type="button" id="uploader-intro-reset" class="btn btn-outline-danger">Reset</button>
                <button type="button" class="btn btn-outline-secondary ms-auto" data-bs-dismiss="modal">Close</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    {{- /*  Trainer, game hack or installer app  */}}
    <div class="modal fade" id="uploader-trainer-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="uploader-trainer-label" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header bg-body-tertiary">
            <h2 class="modal-title fs-5" id="uploader-trainer-label">Trainer <span class="text-body-secondary fw-normal">or game hack, or installer app</span></h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <form id="uploader-trainer-form"
                  hx-encoding="multipart/form-data"
                  hx-post="/uploader/trainer"
                  hx-target="#uploader-trainer-results"
                  hx-disable="#uploader-trainer-submit"
                  hx-config="timeout:0"
                  hx-status:4xx="target:#uploader-trainer-alert swap:innerHTML"
                  hx-status:5xx="target:#uploader-trainer-alert swap:innerHTML"
                  hx-validate="true"
                  hx-swap="innerHTML">
              <input type="hidden" name="uploader-trainer-lastmodified" id="uploader-trainer-last-modified">
              <input type="hidden" name="uploader-trainer-magic" id="uploader-trainer-magic">

              <div class="row g-3 mb-3">
                <div class="col-md-7">
                  <label for="uploader-trainer-title" class="form-label small fw-medium mb-1">
                    Title <span class="text-danger" aria-hidden="true">*</span>
                  </label>
                  <input type="text" name="uploader-trainer-title" class="form-control" id="uploader-trainer-title"
                    aria-describedby="uploader-trainer-title-help" placeholder="example: Doom" required>
                  <div id="uploader-trainer-title-help" class="form-text">The name of the game or the release</div>
                </div>
                <div class="col-md-5">
                  <div class="form-label small fw-medium mb-1">Date of release <span class="text-body-secondary fw-normal">(optional)</span></div>
                  <div class="input-group">
                    <input type="number" name="uploader-trainer-year" min="1980" max="{{exampleYear}}"
                      id="uploader-trainer-year" aria-label="Year of release" class="form-control input-date" placeholder="{{exampleYear}}">
                    <input type="number" name="uploader-trainer-month" min="1" max="12"
                      id="uploader-trainer-month" aria-label="Month of release" class="form-control input-date" placeholder="{{exampleMonth}}">
                  </div>
                  <div class="form-text">Year and month</div>
                </div>
              </div>

              <div class="mb-3">
                <label for="uploader-trainer-releaser-1" class="form-label small fw-medium mb-1">
                  Releasers <span class="text-danger" aria-hidden="true">*</span> <span class="text-body-secondary fw-normal">(maximum of 2)</span>
                </label>
                <div class="input-group">
                  <input type="text" list="uploader-trainer-list-1" name="uploader-trainer-releaser1" class="form-control" id="uploader-trainer-releaser-1"
                      aria-describedby="uploader-trainer-releasers-help" placeholder="example: Razor 1911" value="{{$releasername}}"
                      hx-patch="/uploader/releaser/1"
                      hx-trigger="keyup[checkUserKeydown.call(this, event)] changed delay:{{$delay}}"
                      hx-target="#uploader-trainer-list-1"
                      required>
                  <span class="input-group-text">+</span>
                  <input type="text" list="uploader-trainer-list-2" name="uploader-trainer-releaser2" class="form-control" id="uploader-trainer-releaser-2"
                      aria-describedby="uploader-trainer-releasers-help" placeholder="example: Titan (optional)"
                      hx-patch="/uploader/releaser/2"
                      hx-trigger="keyup[checkUserKeydown.call(this, event)] changed delay:{{$delay}}"
                      hx-target="#uploader-trainer-list-2">
                </div>
                <datalist id="uploader-trainer-list-1"></datalist>
                <datalist id="uploader-trainer-list-2"></datalist>
                <div id="uploader-trainer-releasers-help" class="form-text">{{$helpRelr|safeHTML}}</div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-5">
                  <div class="form-label small fw-medium mb-1">Type of release</div>
                  <div class="btn-group w-100" role="group" aria-label="Type of release selection">
                    <input type="radio" value="{{tagGameHack}}" class="btn-check" name="uploader-trainer-category" id="uploader-trainer-gamehack" checked>
                    <label class="btn btn-outline-primary" for="uploader-trainer-gamehack" data-bs-toggle="tooltip" data-bs-placement="top"
                        data-bs-title="A game cheat, trainer or hack">Trainer</label>
                    <input type="radio" value="{{tagInstall}}" class="btn-check" name="uploader-trainer-category" id="uploader-trainer-installer">
                    <label class="btn btn-outline-primary" for="uploader-trainer-installer" data-bs-toggle="tooltip" data-bs-placement="top"
                        data-bs-title="An installation app for a release">Installer</label>
                  </div>
                </div>
                <div class="col-md-7">
                  <div class="form-label small fw-medium mb-1">Operating system</div>
                  <div class="btn-group w-100" role="group" aria-label="Operating system selection">
                    <input type="radio" value="{{tagDOS}}" class="btn-check" name="uploader-trainer-operating-system" id="uploader-trainer-msdos" checked>
                    <label class="btn btn-outline-primary" for="uploader-trainer-msdos" data-bs-toggle="tooltip" data-bs-placement="top"
                        data-bs-title="IBM&nbsp;PC or MS-DOS compatible">DOS PC</label>
                    <input type="radio" value="{{tagWindows}}" class="btn-check" name="uploader-trainer-operating-system" id="uploader-trainer-windows">
                    <label class="btn btn-outline-primary" for="uploader-trainer-windows" data-bs-toggle="tooltip" data-bs-placement="top"
                        data-bs-title="Microsoft&nbsp;Windows">Windows PC</label>
                    <input type="radio" value="{{tagConsole}}" class="btn-check" name="uploader-trainer-operating-system" id="uploader-trainer-console">
                    <label class="btn btn-outline-primary" for="uploader-trainer-console" data-bs-toggle="tooltip" data-bs-placement="top"
                        data-bs-title="1990s era consoles and handhelds">'90s console</label>
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-1">
                  <label for="uploader-trainer-file" class="form-label small fw-medium mb-0">
                    File or archive <span class="text-danger" aria-hidden="true">*</span>
                  </label>
                  <span class="form-text mt-0">{{$screenshot}}</span>
                </div>
                <input type="file" name="uploader-trainerfile" id="uploader-trainer-file" class="form-control" required>
                <div class="d-none alert alert-danger mt-2 mb-0" role="alert" id="uploader-trainer-alert"></div>
                <progress id="uploader-trainer-progress" class="w-100 mt-2" value="0" max="100"></progress>
              </div>

              <div class="d-none alert alert-primary mb-3" role="alert" id="uploader-trainer-results"
                   hx-swap="innerHTML" hx-on:htmx:after:swap="this.classList.remove('d-none')"></div>

              <div class="border-top pt-3 d-flex align-items-center gap-2">
                <button type="submit" id="uploader-trainer-submit" class="btn btn-success">Upload</button>
                <button type="button" id="uploader-trainer-reset" class="btn btn-outline-danger">Reset</button>
                <button type="button" class="btn btn-outline-secondary ms-auto" data-bs-dismiss="modal">Close</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    {{- /*  text writer, text art  */}}
    <div class="modal fade" id="uploader-text-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="uploader-text-label" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header bg-body-tertiary">
            <h2 class="modal-title fs-5" id="uploader-text-label">Text <span class="text-body-secondary fw-normal">including NFO, or ANSI</span></h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <form id="uploader-text-form"
                  hx-encoding="multipart/form-data"
                  hx-post="/uploader/text"
                  hx-target="#uploader-text-results"
                  hx-disable="#uploader-text-submit"
                  hx-config="timeout:0"
                  hx-status:4xx="target:#uploader-text-alert swap:innerHTML"
                  hx-status:5xx="target:#uploader-text-alert swap:innerHTML"
                  hx-validate="true"
                  hx-swap="innerHTML">
              <input type="hidden" name="uploader-text-lastmodified" id="uploader-text-last-modified">
              <input type="hidden" name="uploader-text-magic" id="uploader-text-magic">
              <input type="hidden" value="releaseinformation" name="uploader-text-category" id="uploader-text-category">

              <div class="row g-3 mb-3">
                <div class="col-md-7">
                  <label for="uploader-text-title" class="form-label small fw-medium mb-1">
                    Title <span class="text-body-secondary fw-normal">(optional)</span>
                  </label>
                  <input type="text" name="uploader-text-title" class="form-control" id="uploader-text-title"
                    aria-describedby="uploader-text-title-help" placeholder="example: 500000th release!">
                  <div id="uploader-text-title-help" class="form-text">Brief description or name of the release</div>
                </div>
                <div class="col-md-5">
                  <div class="form-label small fw-medium mb-1">Date of release <span class="text-body-secondary fw-normal">(optional)</span></div>
                  <div class="input-group">
                    <input type="number" name="uploader-text-year" min="1980" max="{{exampleYear}}"
                      id="uploader-text-year" aria-label="Year of release" class="form-control input-date" placeholder="{{exampleYear}}">
                    <input type="number" name="uploader-text-month" min="1" max="12"
