{{- /* 
    artifactlock.tmpl ~ Compact admin status bar and modal launchers.
*/ -}}
{{- define "artifactlock" }}
{{- $locked := index . "editor"}}
{{- if $locked}}
{{- $forApproval := index . "forApproval"}}
{{- $disableApproval := index . "disableApproval"}}
{{- $missingAssets := index . "missingAssets"}}
{{- $disableRecord := index . "disableRecord"}}
{{- $modID := index . "modID"}}
<div class="col-12">
  <div class="card bg-body-tertiary mb-2">
    <div class="card-body py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div class="d-flex flex-wrap align-items-center gap-2">
        {{- if $disableRecord}}
        <span class="badge text-bg-danger">Disabled</span>
        <span class="small text-body-secondary">Hidden from public access</span>
        {{- else if $forApproval}}
        <div id="record-is-hidden" class="d-flex flex-wrap align-items-center gap-2">
          <span class="badge text-bg-primary">Hidden</span>
          <span class="small text-body-secondary">Awaiting approval</span>
          {{- if eq $disableApproval ""}}
          <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="alt + shift + enter">
            <button type="button" id="editor-online-true" class="btn btn-sm btn-success py-0 px-2"
              hx-get="/editor/online/true/{{$modID}}" hx-target="#record-is-hidden">Approve</button>
          </span>
          {{- end}}
        </div>
        {{- else}}
        <span class="badge text-bg-success">Public</span>
        <span class="small text-body-secondary">Visible to the public</span>
        {{- end}}
      </div>
      <div class="d-flex flex-wrap align-items-center gap-1" role="group" aria-label="Editor modals">
        <span class="badge text-bg-secondary fw-normal me-1" data-bs-toggle="tooltip"
          data-bs-title="alt + shift: home (Data), pgdn (File), pgup (Emulate), del (Delete), 1/2 (Groups)">Keys</span>
        <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="alt + shift + home">
          <button type="button" data-bs-toggle="modal" data-bs-target="#artifact-editor-modal"
            class="btn btn-sm btn-outline-primary">Data</button>
        </span>
        <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="alt + shift + pgdn">
          <button type="button" data-bs-toggle="modal" data-bs-target="#asset-editor-modal"
            class="btn btn-sm btn-outline-primary">File</button>
        </span>
        <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="alt + shift + pgup">
          <button type="button" data-bs-toggle="modal" data-bs-target="#emulate-editor-modal"
            class="btn btn-sm btn-outline-primary">Emulate</button>
        </span>
        <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="alt + shift + del">
          <button type="button" data-bs-toggle="modal" data-bs-target="#artifact-delete-forever-modal"
            class="btn btn-sm btn-outline-danger">Delete</button>
        </span>
      </div>
    </div>
    {{- if ne $disableApproval ""}}
    <div class="card-footer bg-danger-subtle text-danger-emphasis py-1 px-3 small">
      <strong>Missing required data:</strong> {{$disableApproval}}
      <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline link-danger fw-semibold"
        data-bs-toggle="modal" data-bs-target="#artifact-editor-modal">Open Data editor</button>
    </div>
    {{- end}}
    {{- if ne $missingAssets ""}}
    <div class="card-footer bg-warning-subtle text-warning-emphasis py-1 px-3 small">
      <strong>Suggestion:</strong> Use the
      <button type="button" class="btn btn-link btn-sm p-0 align-baseline link-warning fw-semibold"
        data-bs-toggle="modal" data-bs-target="#asset-editor-modal">File editor</button>
      to {{$missingAssets}}.
    </div>
    {{- end}}
  </div>
</div>
{{- end}}
{{- end}}
