{{- /* 
    datalistreleasers.tmpl ~ htmx releasers data-list template.
*/ -}}
{{define "content"}}
{{- $slug := index . "name" }}
{{- $query := index . "query" }}
    {{- range $index, $rel := .result -}}
        {{- $uri := $rel.Unique.URI }}
        {{- $title := fmtPath $uri }}
        {{- $value := releaserIndex $uri }}
        {{- $initialism := initialisms $uri }}
        {{- $label := suggestion $title $initialism $rel.Unique.Count }}
        <option value="{{ $value }}">{{ $label }}{{ suggestHint $value $label $query }}</option>
    {{- end}}
{{end}}
