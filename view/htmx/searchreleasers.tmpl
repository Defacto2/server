{{- /* 
    searchreleasers.tmpl ~ htmx search releasers results template.
*/ -}}
{{- define "content"}}
{{- $slug := index . "name" }}
{{- $maximum := index . "maximum" }}
{{- $path := "g" }}
{{- $cols := "row-cols-1" }}
{{- if gt (len .result) 1 }}
  {{- $cols = "row-cols-1 row-cols-sm-2 row-cols-md-3" }}
{{- end }}
{{- $marker := .input }}
{{- if gt (len .result) 0 }}
<div class="row {{$cols}} g-2 mb-3">
  {{- range $index, $rel := .result }}
    {{- $title := fmtPath $rel.Unique.URI }}
    {{- $initialism := initialisms $rel.Unique.URI }}
    {{- $border := borderClass $slug $rel.Unique.URI }}
    {{- $shortcut := searchResult $index }}
  <div class="col">
    <div class="p-3 rounded bg-body-tertiary {{$border}} h-100 d-flex flex-column justify-content-between gap-2">
      <div class="d-flex justify-content-between align-items-start gap-2">
        <h2 class="h5 mb-0">
          <a class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover" id="search-result-{{$shortcut}}" href="/{{$path}}/{{$rel.Unique.URI}}">{{$title}}</a>
        </h2>
        {{- if ne $shortcut "" }}
        <kbd class="flex-shrink-0 text-bg-secondary">{{$shortcut}}</kbd>
        {{- end }}
      </div>
      <div class="small text-body-secondary">
        {{- if ne $initialism "" }}
        <span class="fw-medium">{{$initialism}}</span> &middot; 
        {{- end }}
        {{- byteFileS "file" $rel.Unique.Count $rel.Unique.Bytes }}
      </div>
    </div>
  </div>
  {{- end }}
</div>
{{- end }}
{{- if ge (len .result) $maximum }}
<p class="small text-body-secondary text-center mb-1">Showing the first {{$maximum}} releaser matches.</p>
{{- end }}
{{- if gt (len .result) 1 }}
<div class="small text-body-secondary text-center">Open results using a keyboard: <kbd>alt+shift</kbd> <kbd>1</kbd> <kbd>2</kbd> <kbd>...</kbd></div>
{{- end }}
{{- if and .fulltext (gt (len .fulltext) 0) }}
<hr class="my-4">
{{- range $index, $rel := .fulltext }}
<figure class="border-start border-3 ps-3 text-start mb-3">
  <blockquote class="mb-1">
    <div>{{mark $marker $rel.Snip}}</div>
  </blockquote>
  <figcaption class="blockquote-footer mb-0">
    {{tidbits $rel.ID}}
  </figcaption>
</figure>
{{- end }}
{{- end }}
{{- end}}
