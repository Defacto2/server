{{- /* 
    searchids.tmpl ~ htmx search by ID/UUID results template.
*/ -}}
{{- define "content"}}
{{- $linkClass := "text-nowrap link-offset-2 link-underline link-underline-opacity-25"}}
<div class="table-responsive">
  <table class="table table-sm table-hover align-middle">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">UUID</th>
        <th scope="col">Key</th>
        <th scope="col">Filename</th>
        <th scope="col">Size</th>
        <th scope="col">Releasers</th>
        <th scope="col">Description</th>
      </tr>
    </thead>
    <tbody>
    {{- range $index, $rel := .result }}
      {{- $key := obfuscateID $rel.ID }}
      <tr>
        <th scope="row" class="text-nowrap">{{$rel.ID}} {{state $rel.Deletedat.IsZero $rel.Deletedby.IsZero}}</th>
        <td><span class="font-monospace small text-nowrap">{{$rel.UUID.String}}</span></td>
        <td><a href="/f/{{$key}}" class="font-monospace {{$linkClass}}">{{$key}}</a></td>
        <td title="{{$rel.Filename.String}}">
          <span class="text-truncate d-inline-block align-bottom" style="max-width:14em;">
            <a href="/d/{{$key}}" class="{{$linkClass}}">{{$rel.Filename.String}}</a>
          </span>
        </td>
        <td class="text-nowrap">{{byteCount $rel.Filesize.Int64}}</td>
        <td>{{linkRelrs false false $rel.GroupBrandFor $rel.GroupBrandBy}}</td>
        <td>{{describe $rel.Platform.String $rel.Section.String $rel.DateIssuedYear.Int16 $rel.DateIssuedMonth.Int16}}</td>
      </tr>
    {{- end }}
    </tbody>
  </table>
</div>
{{- end}}